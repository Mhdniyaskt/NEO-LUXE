            <i class="fas fa-layer-group w-5 text-center text-sm flex-shrink-0 <%= path === 'categories' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Categories</span>
