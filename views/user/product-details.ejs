<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> | Premium Timepieces</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    body { background:#0a0e1a; margin: 0; padding: 0; }
    .zoom-wrap { overflow:hidden; cursor:zoom-in; position:relative; }
    .zoom-wrap img { transition:transform .3s ease; transform-origin:var(--ox,50%) var(--oy,50%); pointer-events:none; user-select:none; }
    .zoom-wrap.zoomed { cursor:zoom-out; }
    .zoom-wrap.zoomed img { transform:scale(2.2); }
    .tab-btn { border-bottom:2px solid transparent; transition:.18s; }
    .tab-btn.active { color:#00d4ff; border-color:#00d4ff; }
    .swatch { width:28px; height:28px; border-radius:50%; border:2px solid transparent; cursor:pointer; transition:.15s; flex-shrink:0; }
    .swatch.active { border-color:#00d4ff; box-shadow:0 0 0 2px #0a0e1a, 0 0 0 4px #00d4ff; }
    .thumb { opacity:.55; border:2px solid transparent; border-radius:10px; cursor:pointer; transition:.18s; }
    .thumb.active, .thumb:hover { opacity:1; border-color:#00d4ff; }
    .spec-row:nth-child(odd)  { background:#161d30; }
    .spec-row:nth-child(even) { background:#0f1526; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
    .fade-up { animation:fadeUp .32s ease both; }

    
  </style>
</head>

<body class="text-slate-200" style="font-family:'DM Sans', sans-serif;">



  <main class="min-h-screen pb-20 mt-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

      <nav class="flex items-center gap-1.5 text-xs text-slate-500 py-3">
        <a href="/" class="hover:text-slate-300 transition-colors">Home</a>
        <span class="text-slate-700">/</span>
        <a href="/shop" class="hover:text-slate-300 transition-colors">Shop</a>
        <span class="text-slate-700">/</span>
        <span class="text-slate-300 truncate max-w-[200px]"><%= product.name %></span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 py-4 fade-up">

        <div>
          <div id="zoomBox" class="zoom-wrap bg-[#0f1526] border border-[#1e2640] rounded-2xl aspect-square flex items-center justify-center mb-4 relative" onclick="handleZoom(event,this)">
            <% if (defaultVariant.stock === 0) { %>
              <span class="absolute top-3 left-3 bg-red-500/90 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase z-10 tracking-wider">Out of Stock</span>
            <% } else if (!defaultVariant.isActive) { %>
              <span class="absolute top-3 left-3 bg-slate-600/90 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase z-10 tracking-wider">Unavailable</span>
            <% } else { %>
              <span class="absolute top-3 left-3 bg-cyan-400 text-[#0a0e1a] text-[10px] font-bold px-3 py-1 rounded-full uppercase z-10 tracking-wider">New Arrival</span>
            <% } %>

            <% if (defaultVariant.images && defaultVariant.images.length) { %>
              <img id="mainImg" src="<%= defaultVariant.images[0].url %>" alt="<%= product.name %>" class="w-full h-full object-contain p-6" />
            <% } else { %>
              <div class="text-slate-600 text-sm">No image available</div>
            <% } %>

            <span id="zoomHint" class="absolute bottom-3 right-3 text-[10px] text-slate-500 flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              Click to zoom
            </span>
          </div>

          <div class="flex gap-3" id="thumbRow">
            <% if (defaultVariant.images) { %>
              <% defaultVariant.images.slice(0,4).forEach((img, i) => { %>
                <div class="thumb w-20 h-20 bg-[#0f1526] border border-[#1e2640] rounded-xl overflow-hidden flex-shrink-0 <%= i===0?'active':'' %>" onclick="switchImg(this,'<%= img.url %>')">
                  <img src="<%= img.url %>" class="w-full h-full object-cover" loading="lazy" />
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <div class="flex flex-col gap-5">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h1 style="font-family:'Playfair Display',serif; font-size:1.85rem; font-weight:700; color:#fff; line-height:1.2">
                <%= product.name %>
              </h1>
              <p class="text-slate-400 text-sm mt-1.5"><%= product.description || 'Elegant automatic timepiece for the modern professional.' %></p>
            </div>
            <button class="text-slate-500 hover:text-cyan-400 transition mt-1" title="Share">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
            </button>
            <!-- Wishlist button -->
            <button id="wishlistBtn"
                    data-wishlist-btn
                    data-variant-id="<%= defaultVariant._id %>"
                    onclick="toggleWishlist(this, '<%= product._id %>', this.dataset.variantId)"
                    title="Add to wishlist"
                    class="text-slate-500 hover:text-rose-400 transition mt-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </button>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <div class="flex">
              <% for (let i=1;i<=5;i++) { %>
                <svg class="w-4 h-4 <%= i<=Math.round(product.rating||4)?'text-yellow-400':'text-slate-700' %>" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <% } %>
            </div>
            <span class="text-slate-400 text-xs">(<%= product.reviewCount||124 %> Reviews)</span>
            <% if (defaultVariant.stock === 0) { %>
              <span class="text-[10px] bg-red-500/20 text-red-400 border border-red-500/30 px-2 py-0.5 rounded-full font-semibold">Out of Stock</span>
            <% } else if (!defaultVariant.isActive) { %>
              <span class="text-[10px] bg-slate-500/20 text-slate-400 border border-slate-500/30 px-2 py-0.5 rounded-full font-semibold">Unavailable</span>
            <% } else if (defaultVariant.stock <= 5) { %>
              <span class="text-[10px] bg-amber-500/20 text-amber-400 border border-amber-500/30 px-2 py-0.5 rounded-full font-semibold">Only <%= defaultVariant.stock %> left</span>
            <% } else { %>
              <span class="text-[10px] bg-green-500/20 text-green-400 border border-green-500/30 px-2 py-0.5 rounded-full font-semibold">In Stock</span>
            <% } %>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-3xl font-bold text-white">₹<%= defaultVariant.finalPrice.toLocaleString('en-IN') %></span>
            <% if (defaultVariant.appliedOffer > 0) { %>
              <span class="text-slate-500 line-through text-lg">₹<%= defaultVariant.salePrice.toLocaleString('en-IN') %></span>
              <span class="bg-red-500/20 text-red-400 text-xs font-bold px-2.5 py-1 rounded-md">−<%= defaultVariant.appliedOffer %>% OFF</span>
            <% } %>
          </div>

          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-2">Color: <span id="colorLabel" class="text-white"><%= defaultVariant.color || 'N/A' %></span></p>
            <div class="flex gap-2">
              <%
                // Map common color names to CSS hex values
                const colorMap = {
                  red:        '#ef4444', crimson:    '#dc143c', rose:       '#f43f5e',
                  pink:       '#ec4899', orange:     '#f97316', amber:      '#f59e0b',
                  yellow:     '#eab308', gold:       '#d4a017', lime:       '#84cc16',
                  green:      '#22c55e', emerald:    '#10b981', teal:       '#14b8a6',
                  cyan:       '#06b6d4', sky:        '#0ea5e9', blue:       '#3b82f6',
                  navy:       '#1e3a5f', indigo:     '#6366f1', violet:     '#8b5cf6',
                  purple:     '#a855f7', fuchsia:    '#d946ef', brown:      '#92400e',
                  chocolate:  '#7b3f00', bronze:     '#cd7f32', silver:     '#c0c0c0',
                  white:      '#f1f5f9', black:      '#1e293b', gray:       '#6b7280',
                  grey:       '#6b7280', slate:      '#64748b', charcoal:   '#374151',
                  beige:      '#d4b896', ivory:      '#fffff0', cream:      '#fffdd0',
                  coral:      '#ff6b6b', salmon:     '#fa8072', tan:        '#d2b48c',
                  khaki:      '#c3b091', olive:      '#808000', midnight:   '#191970',
                  steel:      '#4682b4', titanium:   '#878681', platinum:   '#e5e4e2',
                  gunmetal:   '#2a3439', champagne:  '#f7e7ce', copper:     '#b87333',
                };

                function resolveColor(colorName) {
                  if (!colorName) return '#334155';
                  const lower = colorName.toLowerCase().trim();
                  // Direct match
                  if (colorMap[lower]) return colorMap[lower];
                  // Partial match — find first key that appears in the color name
                  for (const [key, hex] of Object.entries(colorMap)) {
                    if (lower.includes(key)) return hex;
                  }
                  // Last resort: use CSS named color directly (browser will handle it)
                  return lower;
                }
              %>
              <% variants.forEach((v) => {
                const swatchColor  = resolveColor(v.color);
                const isSelected   = v._id.toString() === defaultVariant._id.toString();
                const isOOS        = v.stock === 0;
                const isInactive   = !v.isActive;
                const isUnavailable = isOOS || isInactive;
              %>
                <a href="/shop/<%= product._id %>?variantId=<%= v._id %>"
                   class="swatch <%= isSelected ? 'active' : '' %> relative"
                   title="<%= v.color || 'Variant' %><%= isInactive ? ' (Unavailable)' : isOOS ? ' (Out of Stock)' : '' %>"
                   data-color-name="<%= v.color || '' %>">
                  <span class="block w-full h-full rounded-full border border-white/10 <%= isUnavailable ? 'opacity-35' : '' %>"
                        style="background-color: <%= swatchColor %>;">
                  </span>
                  <% if (isUnavailable) { %>
                    <!-- diagonal strike-through line -->
                    <span class="absolute inset-0 flex items-center justify-center pointer-events-none">
                      <span style="display:block;width:130%;height:1.5px;background:#ef4444;transform:rotate(-45deg);opacity:.8;"></span>
                    </span>
                  <% } %>
                </a>
              <% }) %>
            </div>
          </div>

          <div class="flex items-center gap-3 flex-wrap">
            <% if (!defaultVariant.isActive || defaultVariant.stock === 0) { %>
              <button disabled class="flex-1 py-3 rounded-xl bg-slate-700/60 text-slate-500 text-sm font-semibold cursor-not-allowed">
                <%= !defaultVariant.isActive ? 'Unavailable' : 'Sold Out' %>
              </button>
            <% } else { %>
              <button id="addCartBtn"
                      type="button"
                      onclick="addToCart(this, '<%= product._id %>', '<%= defaultVariant._id %>')"
                      class="flex-1 py-3 rounded-xl bg-cyan-400 text-[#0a0e1a] font-semibold text-sm hover:bg-cyan-300 transition flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                Add to Cart
              </button>
              <form id="buyNowForm" action="/checkout/buy-now" method="POST">
                <input type="hidden" name="productId" value="<%= product._id %>" />
                <input type="hidden" name="variantId" value="<%= defaultVariant._id %>" />
                <button type="button"
                        id="buyNowBtn"
                        onclick="handleBuyNow()"
                        class="px-5 py-3 rounded-xl bg-[#1e2640] border border-[#252e47] text-slate-200 text-sm font-semibold hover:bg-[#252e47] transition">
                  ⚡ Buy Now
                </button>
              </form>
            <% } %>
          </div>

          
        </div>
      </div>

      <div class="mt-14 grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <div class="flex border-b border-[#1e2640] mb-6 gap-6">
            <button onclick="switchTab('specs',this)" class="tab-btn active pb-3 text-sm font-medium text-cyan-400">Specifications</button>
            <button onclick="switchTab('desc',this)" class="tab-btn pb-3 text-sm font-medium text-slate-500 hover:text-slate-300">Description</button>
            <button onclick="switchTab('reviews',this)" class="tab-btn pb-3 text-sm font-medium text-slate-500 hover:text-slate-300">Reviews (<%= product.reviewCount||124 %>)</button>
          </div>

          <div id="tab-specs">
            <h2 style="font-family:'Playfair Display',serif" class="text-xl font-bold text-white mb-4">Technical Specifications</h2>
            <div class="rounded-xl overflow-hidden border border-[#1e2640]">
              <%
                const specs = [
                  ['Brand',          product.brand                          ],
                  ['Category',       product.category ? product.category.name : '—'],
                  ['Case Size',      product.specifications?.caseSize       ],
                  ['Strap Type',     product.specifications?.strapType      ],
                  ['Movement Type',  product.specifications?.movementType   ],
                  ['Color',          defaultVariant.color                   ],
                  ['Price',          '₹' + defaultVariant.basePrice.toLocaleString('en-IN')],
                  ['Stock',          defaultVariant.stock + ' units'        ],
                ];
              %>
              <% specs.forEach(([label, val]) => { %>
                <% if (val) { %>
                  <div class="spec-row flex px-5 py-3.5">
                    <span class="text-slate-400 text-sm w-48 flex-shrink-0"><%= label %></span>
                    <span class="text-white text-sm font-medium"><%= val %></span>
                  </div>
                <% } %>
              <% }) %>
            </div>
          </div>

          <div id="tab-desc" class="hidden">
            <h2 style="font-family:'Playfair Display',serif" class="text-xl font-bold text-white mb-4">Description</h2>
            <p class="text-slate-400 text-sm leading-relaxed"><%= product.longDescription || product.description %></p>
          </div>

          <div id="tab-reviews" class="hidden">
            <h2 style="font-family:'Playfair Display',serif" class="text-xl font-bold text-white mb-4">Customer Reviews</h2>
            <p class="text-slate-500 text-sm">No reviews yet. Be the first to review!</p>
          </div>
        </div>

      </div>

      <!-- ── Similar Products ─────────────────────────────────────────── -->
      <% if (recommendations && recommendations.length > 0) { %>
      <section class="mt-20">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-[10px] text-cyan-400 uppercase tracking-[0.2em] font-bold mb-1">You May Also Like</p>
            <h2 style="font-family:'Playfair Display',serif" class="text-2xl font-bold text-white">Similar Timepieces</h2>
          </div>
          <a href="/shop" class="text-xs text-slate-400 hover:text-cyan-400 transition uppercase tracking-widest font-semibold">
            View All →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <% recommendations.forEach((rec) => {
            const rv         = rec.variant;
            const recSalePrice  = rv ? rv.basePrice    : 0;
            const recFinalPrice = rv ? (rv.finalPrice ?? recSalePrice) : 0;
            const rdiscPct   = rv ? (rv.appliedOffer ?? 0) : 0;
            const recImg     = rv && rv.images && rv.images.length ? rv.images[0].url : null;
          %>
          <a href="/shop/<%= rec._id %>"
             class="group bg-[#0f1526] border border-[#1e2640] rounded-2xl overflow-hidden hover:border-cyan-400/40 hover:shadow-lg hover:shadow-cyan-400/5 transition-all duration-300">

            <!-- Image -->
            <div class="relative aspect-square bg-[#161d30] overflow-hidden">
              <% if (recImg) { %>
                <img src="<%= recImg %>" alt="<%= rec.name %>"
                     class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                     onerror="this.onerror=null;this.src='/images/placeholder-watch.jpg'" />
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-[10px] text-slate-600 uppercase tracking-widest italic">No Image</span>
                </div>
              <% } %>

              <!-- Discount badge -->
              <% if (rdiscPct > 0) { %>
                <div class="absolute top-3 right-3 bg-red-500 text-white text-[10px] font-black px-2 py-0.5 rounded-md shadow-lg">
                  −<%= rdiscPct %>%
                </div>
              <% } %>
            </div>

            <!-- Info -->
            <div class="p-4">
              <p class="text-[10px] text-slate-500 uppercase tracking-widest mb-1"><%= rec.brand %></p>
              <h3 class="text-white text-sm font-bold truncate mb-2 group-hover:text-cyan-400 transition"><%= rec.name %></h3>
              <div class="flex items-baseline gap-2">
                <span class="text-white font-bold">₹<%= recFinalPrice.toLocaleString('en-IN') %></span>
                <% if (rdiscPct > 0) { %>
                  <span class="text-slate-600 text-xs line-through">₹<%= recSalePrice.toLocaleString('en-IN') %></span>
                <% } %>
              </div>
            </div>
          </a>
          <% }) %>
        </div>
      </section>
      <% } %>

    </div>
  </main>

  <footer class="py-10 border-t border-[#1e2640] text-center text-slate-500 text-xs">
    <p>&copy; 2026 Chronos Luxe. All rights reserved.</p>
  </footer>

  <script>

    document.querySelectorAll('[data-swatch]').forEach(el => {
      el.style.backgroundColor = el.getAttribute('data-swatch');
    });

    // Update color label on swatch hover
    document.querySelectorAll('.swatch[data-color-name]').forEach(swatch => {
      swatch.addEventListener('mouseenter', () => {
        document.getElementById('colorLabel').textContent = swatch.dataset.colorName;
      });
    });
    function handleZoom(e, box) {
      const img = box.querySelector('img');
      if (!img) return;
      const rect = box.getBoundingClientRect();
      box.style.setProperty('--ox', ((e.clientX - rect.left) / rect.width * 100).toFixed(1) + '%');
      box.style.setProperty('--oy', ((e.clientY - rect.top) / rect.height * 100).toFixed(1) + '%');
      box.classList.toggle('zoomed');
      document.getElementById('zoomHint').textContent = box.classList.contains('zoomed') ? 'Click to zoom out' : 'Click to zoom';
    }

    function switchImg(el, src) {
      document.getElementById('mainImg').src = src;
      const box = document.getElementById('zoomBox');
      box.classList.remove('zoomed');
      document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
      el.classList.add('active');
    }

    function switchTab(id, btn) {
      ['specs','desc','reviews'].forEach(t => document.getElementById('tab-'+t).classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active','text-cyan-400');
        b.classList.add('text-slate-500');
      });
      document.getElementById('tab-'+id).classList.remove('hidden');
      btn.classList.add('active','text-cyan-400');
      btn.classList.remove('text-slate-500');
    }

    function showToast(msg, ok=true) {
      // kept for any legacy inline calls — real feedback comes from layout toast
    }

    // ── Buy Now — navigate to buy-now checkout page ──
    async function handleBuyNow() {
      const btn  = document.getElementById('buyNowBtn');
      const form = document.getElementById('buyNowForm');

      const productId = form.querySelector('[name="productId"]').value;
      const variantId = form.querySelector('[name="variantId"]').value;

      btn.disabled    = true;
      btn.textContent = '…';

      try {
        // Check if user is logged in by making a quick validation request
        const res = await fetch(`/buy-now/${productId}/${variantId}`, {
          method: 'GET',
          redirect: 'follow',
        });

        if (res.redirected) {
          // Redirected to login or another page
          window.location.href = res.url;
          return;
        }

        if (res.ok) {
          // Success — navigate to the buy-now page
          window.location.href = `/buy-now/${productId}/${variantId}`;
          return;
        }

        // Error response
        const contentType = res.headers.get('content-type') || '';
        if (contentType.includes('application/json')) {
          const data = await res.json();
          Swal.fire({
            icon: 'warning', title: 'Cannot Proceed', text: data.message || 'Something went wrong',
            confirmButtonColor: '#06b6d4', background: '#0f1526', color: '#e2e8f0',
          });
        } else {
          // Server returned HTML error page — just navigate
          window.location.href = `/buy-now/${productId}/${variantId}`;
        }
      } catch {
        Swal.fire({
          icon: 'error', title: 'Error', text: 'Something went wrong. Please try again.',
          confirmButtonColor: '#06b6d4', background: '#0f1526', color: '#e2e8f0',
        });
      } finally {
        btn.disabled    = false;
        btn.textContent = '⚡ Buy Now';
      }
    }

    // ── Flip button to "Go to Cart" after a successful add ────────────
    document.addEventListener('cartAdded', (e) => {
      const btn = document.getElementById('addCartBtn');
      if (!btn) return;
      btn._cartHandled = true;   // tell the layout not to restore original HTML
      btn.disabled  = false;
      btn.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        Go to Cart`;
      btn.onclick   = () => window.location.href = '/cart';
      btn.className = btn.className
        .replace('bg-cyan-400', 'bg-green-500')
        .replace('hover:bg-cyan-300', 'hover:bg-green-400')
        .replace('text-[#0a0e1a]', 'text-white');
    });
  </script>
</body>
</html>