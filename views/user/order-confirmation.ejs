<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmed | Neo-Luxe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    body { font-family: "Inter", sans-serif; }
    @keyframes pop {
      0%   { transform: scale(0.4); opacity: 0; }
      70%  { transform: scale(1.12); }
      100% { transform: scale(1);   opacity: 1; }
    }
    .pop { animation: pop .55s cubic-bezier(.34,1.56,.64,1) both; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up   { animation: fadeUp .5s ease both; }
    .delay-1   { animation-delay: .1s; }
    .delay-2   { animation-delay: .25s; }
    .delay-3   { animation-delay: .4s; }
  </style>
</head>
<body class="bg-[#05080d] text-white min-h-screen flex flex-col">

  <%- include('../partials/user-header') %>

  <main class="max-w-4xl mx-auto w-full px-4 pt-10 pb-24 flex-grow">

    <!-- ── Progress Steps ──────────────────────────────────────────── -->
    <div class="flex items-center justify-center gap-2 mb-10 text-xs font-semibold select-none">
      <!-- Cart -->
      <div class="flex items-center gap-1.5 text-slate-500">
        <div class="w-6 h-6 rounded-full bg-[#0a0f18] border border-slate-700 flex items-center justify-center">
          <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        Cart
      </div>
      <div class="w-10 h-px bg-slate-800"></div>
      <!-- Checkout -->
      <div class="flex items-center gap-1.5 text-slate-500">
        <div class="w-6 h-6 rounded-full bg-[#0a0f18] border border-slate-700 flex items-center justify-center">
          <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        Checkout
      </div>
      <div class="w-10 h-px bg-cyan-500/60"></div>
      <!-- Confirmation (active) -->
      <div class="flex items-center gap-1.5 text-cyan-400">
        <div class="w-6 h-6 rounded-full bg-cyan-400/15 border border-cyan-400/50 flex items-center justify-center shadow-[0_0_10px_rgba(0,212,255,0.3)]">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        Confirmation
      </div>
    </div>

    <!-- ── Hero Success Card ────────────────────────────────────────── -->
    <div class="bg-[#0a0f18] border border-gray-800/80 rounded-3xl p-10 text-center mb-6 fade-up relative overflow-hidden">
      <!-- subtle glow bg -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(0,212,255,0.06),transparent_70%)] pointer-events-none"></div>

      <!-- Animated check -->
      <div class="pop relative w-20 h-20 mx-auto mb-6">
        <div class="absolute inset-0 rounded-full bg-cyan-400/10 border-2 border-cyan-400/30 shadow-[0_0_40px_rgba(0,212,255,0.2)]"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <svg class="w-9 h-9 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
      </div>

      <h1 class="text-3xl font-bold text-white mb-2 tracking-tight">Order Confirmed!</h1>
      <p class="text-slate-400 text-sm max-w-sm mx-auto leading-relaxed">
        Thank you for your purchase. Your luxury timepiece from our collection is being prepared for shipment.
      </p>

      <!-- Order ID pill -->
      <div class="inline-flex items-center gap-2.5 mt-5 px-5 py-2 rounded-full border border-gray-800 bg-[#060b14]">
        <span class="text-slate-500 text-[10px] uppercase tracking-widest font-semibold">Order ID</span>
        <span class="text-cyan-400 font-mono font-bold text-sm tracking-wide">
          #<%= order.orderId || order._id.toString().slice(-8).toUpperCase() %>
        </span>
      </div>

      <p class="text-slate-600 text-xs mt-3">
        A confirmation has been sent to your registered email.
      </p>
    </div>

    <!-- ── Two-column layout ────────────────────────────────────────── -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">

      <!-- Left: Items + Order Info -->
      <div class="lg:col-span-8 space-y-5">

        <!-- Ordered Items -->
        <div class="bg-[#0a0f18] border border-gray-800/80 rounded-2xl p-6 fade-up delay-1">
          <h2 class="text-xs font-bold text-white uppercase tracking-widest mb-5">Ordered Items</h2>
          <div class="space-y-4">
            <% order.items.forEach(item => { %>
              <div class="flex gap-4 items-center py-2 border-b border-gray-800/50 last:border-0 last:pb-0">
                <!-- Image -->
                <div class="w-14 h-14 bg-[#111827] rounded-xl overflow-hidden border border-gray-800 flex-shrink-0">
                  <% if (item.imageUrl) { %>
                    <img src="<%= item.imageUrl %>" alt="<%= item.productName %>" class="w-full h-full object-cover"/>
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
                      </svg>
                    </div>
                  <% } %>
                </div>
                <!-- Details -->
                <div class="flex-1 min-w-0">
                  <p class="text-white text-sm font-semibold truncate"><%= item.productName %></p>
                  <p class="text-slate-500 text-xs mt-0.5">
                    <% if (item.variantColor) { %>REF: <%= item.variantColor %><% } %>
                  </p>
                </div>
                <!-- Qty + Price -->
                <div class="text-right flex-shrink-0">
                  <p class="text-slate-400 text-xs mb-0.5">Qty: <span class="text-white font-semibold"><%= item.quantity %></span></p>
                  <p class="text-cyan-400 font-bold text-sm">₹<%= item.itemTotal.toLocaleString('en-IN') %></p>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Order Information -->
        <div class="bg-[#0a0f18] border border-gray-800/80 rounded-2xl p-6 fade-up delay-2">
          <h2 class="text-xs font-bold text-white uppercase tracking-widest mb-5">Order Information</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

            <!-- Delivery Address -->
            <div>
              <p class="text-[10px] text-slate-500 uppercase tracking-widest font-bold mb-3">Delivery Address</p>
              <p class="text-white text-sm font-semibold"><%= order.shippingAddress.fullName %></p>
              <p class="text-slate-400 text-xs leading-relaxed mt-1">
                <%= order.shippingAddress.addressLine1 %><% if (order.shippingAddress.addressLine2) { %>, <%= order.shippingAddress.addressLine2 %><% } %>,
                <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> — <%= order.shippingAddress.pincode %>
              </p>
              <p class="text-slate-500 text-xs mt-1.5 flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                Mobile: <%= order.shippingAddress.phone %>
              </p>
            </div>

            <!-- Payment + Delivery -->
            <div class="space-y-4">
              <div>
                <p class="text-[10px] text-slate-500 uppercase tracking-widest font-bold mb-2">Payment Method</p>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                  </svg>
                  <p class="text-white text-sm font-medium">
                    <%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Online Payment' %>
                  </p>
                </div>
              </div>
              <div>
                <p class="text-[10px] text-slate-500 uppercase tracking-widest font-bold mb-2">Estimated Delivery</p>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
                  </svg>
                  <p class="text-white text-sm font-medium">
                    <%
                      const d = new Date(order.createdAt);
                      const s = new Date(d); s.setDate(s.getDate() + 3);
                      const e = new Date(d); e.setDate(e.getDate() + 5);
                      const fmt = x => x.toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
                    %>
                    <%= fmt(s) %> – <%= fmt(e) %>
                  </p>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Right: Payment Summary + Actions -->
      <div class="lg:col-span-4 fade-up delay-3">
        <div class="bg-[#0a0f18] border border-gray-800/80 rounded-2xl p-6 sticky top-6">
          <h2 class="text-xs font-bold text-white uppercase tracking-widest mb-5">Payment Summary</h2>

          <div class="space-y-3 text-sm mb-5">
            <div class="flex justify-between">
              <span class="text-slate-400">Subtotal</span>
              <span class="text-white">₹<%= order.subtotal.toLocaleString('en-IN') %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Shipping</span>
              <span class="<%= order.shipping === 0 ? 'text-cyan-400 font-semibold' : 'text-white' %>">
                <%= order.shipping === 0 ? 'Free' : '₹' + order.shipping.toLocaleString('en-IN') %>
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Tax (10%)</span>
              <span class="text-white">₹<%= order.tax.toLocaleString('en-IN') %></span>
            </div>
            <% if (order.discount && order.discount > 0) { %>
              <div class="flex justify-between">
                <span class="text-slate-400">Coupon Discount</span>
                <span class="text-emerald-400">−₹<%= order.discount.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
          </div>

          <div class="border-t border-gray-800 pt-4 flex justify-between items-center mb-6">
            <span class="text-white font-bold text-sm">Total Paid</span>
            <span class="text-cyan-400 font-bold text-xl">₹<%= order.total.toLocaleString('en-IN') %></span>
          </div>

          <!-- CTA Buttons -->
          <div class="space-y-3">
            <a href="/orders/<%= order._id %>/details"
               class="w-full flex items-center justify-center gap-2 bg-cyan-400 hover:bg-cyan-300 active:bg-cyan-500 text-[#05080d] font-bold text-sm px-5 py-3 rounded-xl transition-all duration-200 shadow-[0_4px_20px_rgba(0,212,255,0.2)]">
              Track Order
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="/shop"
               class="w-full flex items-center justify-center gap-2 bg-[#111827] border border-gray-700 hover:border-gray-600 hover:bg-[#1a2235] text-slate-300 hover:text-white font-semibold text-sm px-5 py-3 rounded-xl transition-all duration-200">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
              Continue Shopping
            </a>
          </div>

          <p class="text-center text-slate-600 text-[11px] mt-5">
            Need help with your order?
            <a href="#" class="text-cyan-400 hover:underline ml-0.5">Contact Support</a>
          </p>
        </div>
      </div>

    </div>
  </main>

  <footer class="py-8 border-t border-white/5 text-center">
    <p class="text-slate-700 text-xs">&copy; 2026 Luxe Time Inc. All rights reserved.</p>
    <div class="flex justify-center gap-6 mt-2 text-[10px] text-slate-700 uppercase tracking-widest">
      <a href="#" class="hover:text-slate-500 transition">Privacy Policy</a>
      <a href="#" class="hover:text-slate-500 transition">Terms of Service</a>
    </div>
  </footer>

</body>
</html>
