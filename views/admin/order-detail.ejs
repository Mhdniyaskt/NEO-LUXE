<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order Details | Neo-Luxe Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body { background-color:#05070A; color:#E2E8F0; font-family:'Inter',sans-serif; }
    .card-bg { background-color:#0B1120; border:1px solid #1E293B; }
    ::-webkit-scrollbar { width:5px; }
    ::-webkit-scrollbar-track { background:#05070A; }
    ::-webkit-scrollbar-thumb { background:#1E293B; border-radius:10px; }
    ::-webkit-scrollbar-thumb:hover { background:#22D3EE; }
    .tl-dot { width:14px; height:14px; border-radius:50%; flex-shrink:0; margin-top:3px; }
    .tl-line { width:2px; flex-shrink:0; min-height:32px; margin-left:6px; background:#1E293B; }
  </style>
</head>
<body class="antialiased overflow-hidden">

<%
  const shortId = '#' + order._id.toString().slice(-8).toUpperCase();
  const customerName = order.user ? order.user.name : 'Deleted User';
  const initials = customerName.split(' ').map(n=>n[0]).join('').toUpperCase().slice(0,2);

  const statusColors = {
    pending:    'bg-amber-500/10 text-amber-400 border-amber-500/20',
    confirmed:  'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
    processing: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
    shipped:    'bg-purple-500/10 text-purple-400 border-purple-500/20',
    delivered:  'bg-green-500/10 text-green-400 border-green-500/20',
    cancelled:  'bg-red-500/10 text-red-400 border-red-500/20',
    returned:   'bg-orange-500/10 text-orange-400 border-orange-500/20',
  };
  const payColors = {
    pending:  'bg-amber-500/10 text-amber-400 border-amber-500/20',
    paid:     'bg-green-500/10 text-green-400 border-green-500/20',
    failed:   'bg-red-500/10 text-red-400 border-red-500/20',
    refunded: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
    cancelled:'bg-slate-500/10 text-slate-400 border-slate-500/20',
  };

  const timelineSteps = [
    { key: 'pending',    label: 'Order Placed',    desc: 'Order received and being verified.' },
    { key: 'confirmed',  label: 'Confirmed',        desc: 'Order confirmed and being prepared.' },
    { key: 'processing', label: 'Processing',       desc: 'Quality check and packaging in progress.' },
    { key: 'shipped',    label: 'Shipped',          desc: 'Picked up by courier.' },
    { key: 'delivered',  label: 'Delivered',        desc: 'Successfully delivered to customer.' },
  ];
  const statusOrder = ['pending','confirmed','processing','shipped','delivered','cancelled','returned'];
  const currentIdx  = statusOrder.indexOf(order.status);
  const isCancelled = order.status === 'cancelled';
  const isReturned  = order.status === 'returned';
%>

<div class="flex h-screen w-full">

  <%- include('../partials/admin-sidebar', { path: 'orders' }) %>

  <main class="flex-1 overflow-y-auto bg-[#05070A]">
    <div class="max-w-7xl mx-auto p-6 md:p-8">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-5">
        <a href="/admin/dashboard" class="hover:text-slate-300 transition-colors"><i class="fas fa-home"></i></a>
        <span class="text-slate-700">/</span>
        <a href="/admin/orders" class="hover:text-slate-300 transition-colors">Orders</a>
        <span class="text-slate-700">/</span>
        <span class="text-slate-300"><%= shortId %></span>
      </nav>

      <!-- Page header -->
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight">Order Details</h1>
          <p class="text-slate-500 text-sm mt-1">View order and manage returns.</p>
        </div>
        <a href="/admin/orders"
           class="flex items-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 hover:text-white text-xs font-bold px-4 py-2.5 rounded-xl transition-all">
          <i class="fas fa-arrow-left text-[10px]"></i> Back to Orders
        </a>
      </div>

      <!-- Summary stat cards -->
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
        <div class="card-bg rounded-xl p-4">
          <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-2">Order ID</p>
          <p class="text-cyan-400 font-mono font-bold text-sm"><%= shortId %></p>
        </div>
        <div class="card-bg rounded-xl p-4">
          <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-2">Order Date</p>
          <p class="text-white font-semibold text-sm">
            <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
          </p>
        </div>
        <div class="card-bg rounded-xl p-4">
          <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-2">Order Status</p>
          <span class="px-2.5 py-1 rounded text-[9px] font-black uppercase tracking-wider border <%= statusColors[order.status] || '' %>">
            <%= order.status %>
          </span>
        </div>
        <div class="card-bg rounded-xl p-4">
          <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-2">Total Items</p>
          <%
            const cancelledCount = order.items.filter(i => i.status === 'cancelled').length;
            const activeCount    = order.items.length - cancelledCount;
          %>
          <p class="text-white font-semibold text-sm">
            <%= order.items.length %> item<%= order.items.length !== 1 ? 's' : '' %>
          </p>
          <% if (cancelledCount > 0) { %>
            <p class="text-red-400 text-[10px] mt-0.5">
              <%= cancelledCount %> cancelled
            </p>
          <% } %>
        </div>
        <div class="card-bg rounded-xl p-4">
          <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-2">Total Amount</p>
          <%
            const cancelledItems  = order.items.filter(i => i.status === 'cancelled');
            const cancelledTotal  = cancelledItems.reduce((sum, i) => sum + (i.itemTotal || 0), 0);
            const effectiveTotal  = order.total - cancelledTotal;
          %>
          <p class="text-cyan-400 font-bold text-lg">₹<%= effectiveTotal.toLocaleString('en-IN') %></p>
          <% if (cancelledTotal > 0) { %>
            <p class="text-red-400 text-[10px] mt-0.5 line-through">₹<%= order.total.toLocaleString('en-IN') %></p>
          <% } %>
        </div>
      </div>

      <!-- Return request banner — only when ALL items are requested (order-level returned) -->
      <%
        const activeItems       = order.items.filter(i => i.status !== 'cancelled');
        const hasRequestedItems = activeItems.some(i => i.returnStatus === 'requested');
        const allItemsRequested = activeItems.length > 0 && activeItems.every(i => i.returnStatus === 'requested');
      %>
      <%# Full-order return banner — only when ALL active items are requested %>
      <% if (allItemsRequested && order.paymentStatus !== 'refunded') { %>
        <div class="card-bg border-l-4 border-orange-400 rounded-xl p-4 mb-6 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-orange-400/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <i class="fas fa-undo text-orange-400 text-xs"></i>
            </div>
            <div>
              <p class="text-white font-bold text-sm">Full Order Return Requested</p>
              <p class="text-slate-400 text-xs mt-0.5">
                Customer has requested a return for the entire order.
                <% if (order.cancelReason) { %> Reason: <em class="text-slate-300"><%= order.cancelReason %></em><% } %>
              </p>
            </div>
          </div>
          <div class="flex gap-2">
            <button onclick="handleReturn('<%= order._id %>', 'reject')"
                    class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 hover:text-white text-xs font-bold px-4 py-2 rounded-lg transition">
              Reject
            </button>
            <button onclick="handleReturn('<%= order._id %>', 'approve')"
                    class="bg-cyan-400 hover:bg-cyan-300 text-[#05070A] text-xs font-bold px-4 py-2 rounded-lg transition">
              Approve & Refund to Wallet
            </button>
          </div>
        </div>
      <% } %>

      <% if (order.status === 'returned' && order.paymentStatus === 'refunded') { %>
        <div class="card-bg border-l-4 border-green-400 rounded-xl p-4 mb-6 flex items-start gap-3">
          <div class="w-8 h-8 bg-green-400/10 rounded-lg flex items-center justify-center flex-shrink-0">
            <i class="fas fa-check-circle text-green-400 text-xs"></i>
          </div>
          <div>
            <p class="text-white font-bold text-sm">Return Approved — Refund Processed</p>
            <%
              const refundedAmt = order.items
                .filter(i => i.returnStatus === 'approved')
                .reduce((sum, i) => sum + i.itemTotal, 0);
            %>
            <p class="text-slate-400 text-xs mt-0.5">
              ₹<%= refundedAmt.toLocaleString('en-IN') %> has been credited to the customer's wallet.
            </p>
          </div>
        </div>
      <% } %>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- ── Left column ──────────────────────────────────────────── -->
        <div class="lg:col-span-8 space-y-6">

          <!-- Order Items -->
          <div class="card-bg rounded-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-800 flex items-center gap-2">
              <i class="fas fa-box text-cyan-400 text-xs"></i>
              <h2 class="text-xs font-bold text-white uppercase tracking-widest">Ordered Items & Returns</h2>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs min-w-[600px]">
                <thead class="bg-slate-900/30 text-[10px] uppercase tracking-widest text-slate-500 border-b border-slate-800">
                  <tr>
                    <th class="px-6 py-3 font-bold">Item Details</th>
                    <th class="px-6 py-3 font-bold">Qty</th>
                    <th class="px-6 py-3 font-bold">Price</th>
                    <th class="px-6 py-3 font-bold">Item Status</th>
                    <th class="px-6 py-3 font-bold text-right">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/50">
                  <% if (order.items && order.items.length > 0) { %>
                    <% order.items.forEach((item, idx) => { %>
                      <tr class="hover:bg-slate-800/20 transition-colors">
                        <td class="px-6 py-4">
                          <div class="flex items-center gap-3">
                            <div class="w-12 h-12 bg-slate-800 rounded-xl overflow-hidden border border-slate-700 flex-shrink-0">
                              <% if (item.imageUrl) { %>
                                <img src="<%= item.imageUrl %>" alt="<%= item.productName %>" class="w-full h-full object-cover"/>
                              <% } else { %>
                                <div class="w-full h-full flex items-center justify-center text-slate-600">
                                  <i class="fas fa-clock"></i>
                                </div>
                              <% } %>
                            </div>
                            <div>
                              <p class="text-white font-semibold text-xs"><%= item.productName %></p>
                              <p class="text-slate-500 text-[10px] mt-0.5">Color: <%= item.variantColor %></p>
                              <% if (item.returnStatus === 'requested' && item.returnReason) { %>
                                <p class="text-amber-400 text-[10px] mt-1">Return reason: <%= item.returnReason %></p>
                              <% } %>
                            </div>
                          </div>
                        </td>
                        <td class="px-6 py-4 text-slate-300"><%= item.quantity %></td>
                        <td class="px-6 py-4 text-cyan-400 font-bold">₹<%= item.itemTotal.toLocaleString('en-IN') %></td>
                        <td class="px-6 py-4">
                          <%
                            // Per-item status badge:
                            // - cancelled item → 'cancelled'
                            // - return approved → 'returned'
                            // - return requested → 'return requested' (use pending color)
                            // - return rejected → show order status (still delivered)
                            // - otherwise → order status
                            let itemDisplayStatus, itemDisplayColor;
                            if (item.status === 'cancelled') {
                              itemDisplayStatus = 'cancelled';
                              itemDisplayColor  = statusColors['cancelled'];
                            } else if (item.returnStatus === 'approved') {
                              itemDisplayStatus = 'returned';
                              itemDisplayColor  = statusColors['returned'];
                            } else if (item.returnStatus === 'requested') {
                              itemDisplayStatus = 'return pending';
                              itemDisplayColor  = statusColors['pending'];
                            } else {
                              // For non-returned items, always show 'delivered' if the order
                              // is delivered or partially returned
                              itemDisplayStatus = ['delivered','returned'].includes(order.status) ? 'delivered' : order.status;
                              itemDisplayColor  = statusColors[itemDisplayStatus] || '';
                            }
                          %>
                          <span class="px-2.5 py-1 rounded text-[9px] font-black uppercase tracking-wider border <%= itemDisplayColor %>">
                            <%= itemDisplayStatus %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                          <% if (item.returnStatus === 'requested') { %>
                            <div class="flex justify-end gap-1.5">
                              <button onclick="handleItemReturn('<%= order._id %>', <%= idx %>, 'approve')"
                                      class="flex items-center gap-1 bg-green-500/10 border border-green-500/20 text-green-400 hover:bg-green-500/20 text-[10px] font-bold px-2.5 py-1.5 rounded-lg transition">
                                <i class="fas fa-check text-[9px]"></i> Approve
                              </button>
                              <button onclick="handleItemReturn('<%= order._id %>', <%= idx %>, 'reject')"
                                      class="flex items-center gap-1 bg-red-500/10 border border-red-500/20 text-red-400 hover:bg-red-500/20 text-[10px] font-bold px-2.5 py-1.5 rounded-lg transition">
                                <i class="fas fa-times text-[9px]"></i> Reject
                              </button>
                            </div>
                          <% } else if (item.returnStatus === 'approved') { %>
                            <div class="flex flex-col items-end gap-1.5">
                              <span class="text-[9px] font-black uppercase tracking-wider px-2.5 py-1 rounded border bg-green-500/10 text-green-400 border-green-500/20">
                                Refunded
                              </span>
                              <% if (!item.stockRestored) { %>
                                <button onclick="restockItem('<%= order._id %>', <%= idx %>, '<%= item.productName.replace(/'/g, "\\'") %>', <%= item.quantity %>)"
                                        class="flex items-center gap-1 bg-amber-500/10 border border-amber-500/20 text-amber-400 hover:bg-amber-500/20 text-[10px] font-bold px-2.5 py-1.5 rounded-lg transition">
                                  <i class="fas fa-boxes text-[9px]"></i> Restock
                                </button>
                              <% } else { %>
                                <span class="text-[9px] font-black uppercase tracking-wider px-2.5 py-1 rounded border bg-amber-500/10 text-amber-400 border-amber-500/20">
                                  <i class="fas fa-check text-[8px]"></i> Restocked
                                </span>
                              <% } %>
                            </div>
                          <% } else if (item.returnStatus === 'rejected') { %>
                            <span class="text-[9px] font-black uppercase tracking-wider px-2.5 py-1 rounded border bg-red-500/10 text-red-400 border-red-500/20">Rejected</span>
                          <% } else { %>
                            <span class="text-slate-700 text-[10px]">—</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="px-6 py-10 text-center text-slate-500 text-xs">No items in this order.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Order Timeline -->
          <div class="card-bg rounded-2xl p-6">
            <div class="flex items-center gap-2 mb-6">
              <i class="fas fa-history text-cyan-400 text-xs"></i>
              <h2 class="text-xs font-bold text-white uppercase tracking-widest">Order Timeline</h2>
            </div>

            <% if (isCancelled) { %>
              <div class="flex items-start gap-3">
                <div class="tl-dot bg-red-500 mt-1"></div>
                <div>
                  <p class="text-red-400 font-bold text-sm">Order Cancelled</p>
                  <% if (order.cancelReason) { %>
                    <p class="text-slate-500 text-xs mt-0.5"><%= order.cancelReason %></p>
                  <% } %>
                  <p class="text-slate-600 text-[10px] mt-1">
                    <%= new Date(order.updatedAt).toLocaleString('en-IN', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) %>
                  </p>
                </div>
              </div>
            <% } else { %>
              <div class="space-y-0">
                <% timelineSteps.forEach((step, i) => {
                  const stepIdx = statusOrder.indexOf(step.key);
                  const isActive = currentIdx >= stepIdx;
                  const isCurrent = order.status === step.key;
                  const isLast = i === timelineSteps.length - 1;
                %>
                  <div class="flex gap-3">
                    <!-- Dot + line -->
                    <div class="flex flex-col items-center">
                      <div class="tl-dot <%= isActive ? 'bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.6)]' : 'bg-slate-800 border border-slate-700' %>"></div>
                      <% if (!isLast) { %>
                        <div class="tl-line <%= isActive ? 'bg-cyan-400/30' : 'bg-slate-800' %>"></div>
                      <% } %>
                    </div>
                    <!-- Content -->
                    <div class="pb-5 flex-1">
                      <p class="<%= isActive ? 'text-white font-bold' : 'text-slate-500' %> text-sm"><%= step.label %></p>
                      <p class="text-slate-500 text-xs mt-0.5"><%= step.desc %></p>
                      <% if (isCurrent) { %>
                        <p class="text-cyan-400 text-[10px] font-semibold mt-1">
                          <%= new Date(order.updatedAt).toLocaleString('en-IN', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                        </p>
                      <% } else if (isActive && i === 0) { %>
                        <p class="text-slate-600 text-[10px] mt-1">
                          <%= new Date(order.createdAt).toLocaleString('en-IN', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                        </p>
                      <% } %>
                    </div>
                  </div>
                <% }) %>

                <% if (isReturned) { %>
                  <div class="flex gap-3">
                    <div class="flex flex-col items-center">
                      <div class="tl-dot bg-orange-400 shadow-[0_0_8px_rgba(251,146,60,0.6)]"></div>
                    </div>
                    <div class="flex-1">
                      <p class="text-orange-400 font-bold text-sm">Return Requested</p>
                      <p class="text-slate-500 text-xs mt-0.5">Customer requested return for all items.</p>
                      <p class="text-slate-600 text-[10px] mt-1">
                        <%= new Date(order.updatedAt).toLocaleString('en-IN', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) %>
                      </p>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>

        </div>

        <!-- ── Right column ─────────────────────────────────────────── -->
        <div class="lg:col-span-4 space-y-5">

          <!-- Customer info -->
          <div class="card-bg rounded-2xl p-5">
            <div class="flex items-center gap-3 mb-5">
              <div class="w-10 h-10 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-sm font-bold text-cyan-400 flex-shrink-0">
                <%= initials %>
              </div>
              <div>
                <p class="text-white font-bold text-sm"><%= customerName %></p>
                <p class="text-slate-500 text-[10px]">
                  Customer since <%= order.user ? new Date(order.user.createdAt).getFullYear() : '—' %>
                </p>
              </div>
            </div>

            <div class="space-y-3 text-xs">
              <% if (order.user && order.user.email) { %>
                <div class="flex items-start gap-2.5">
                  <div class="w-7 h-7 bg-slate-800 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-envelope text-slate-500 text-[10px]"></i>
                  </div>
                  <div>
                    <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-0.5">Email Address</p>
                    <p class="text-slate-300"><%= order.user.email %></p>
                  </div>
                </div>
              <% } %>

              <% if (order.shippingAddress && order.shippingAddress.phone) { %>
                <div class="flex items-start gap-2.5">
                  <div class="w-7 h-7 bg-slate-800 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-phone text-slate-500 text-[10px]"></i>
                  </div>
                  <div>
                    <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-0.5">Phone Number</p>
                    <p class="text-slate-300">+91 <%= order.shippingAddress.phone %></p>
                  </div>
                </div>
              <% } %>

              <% if (order.shippingAddress) { %>
                <div class="flex items-start gap-2.5">
                  <div class="w-7 h-7 bg-slate-800 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-map-marker-alt text-slate-500 text-[10px]"></i>
                  </div>
                  <div>
                    <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-0.5">Shipping Address</p>
                    <p class="text-slate-300 leading-relaxed">
                      <%= order.shippingAddress.addressLine1 %><% if (order.shippingAddress.addressLine2) { %>, <%= order.shippingAddress.addressLine2 %><% } %>,<br/>
                      <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.pincode %>
                    </p>
                  </div>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Payment -->
          <div class="card-bg rounded-2xl p-5">
            <div class="flex items-center gap-2 mb-4">
              <i class="fas fa-credit-card text-cyan-400 text-xs"></i>
              <h3 class="text-[10px] font-bold text-white uppercase tracking-widest">Payment</h3>
            </div>
            <div class="space-y-3 text-xs">
              <div class="flex justify-between items-center">
                <span class="text-slate-500">Method</span>
                <span class="text-white font-semibold capitalize">
                  <%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : order.paymentMethod %>
                </span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-500">Status</span>
                <span class="px-2.5 py-1 rounded text-[9px] font-black uppercase tracking-wider border <%= payColors[order.paymentStatus] || '' %>">
                  <%= order.paymentStatus %>
                </span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-500">Date</span>
                <span class="text-slate-300">
                  <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
                </span>
              </div>
              <div class="border-t border-slate-800 pt-3 flex justify-between items-center">
                <span class="text-slate-400 font-semibold">Total</span>
                <div class="text-right">
                  <span class="text-cyan-400 font-bold text-base">₹<%= effectiveTotal.toLocaleString('en-IN') %></span>
                  <% if (cancelledTotal > 0) { %>
                    <p class="text-red-400 text-[10px] line-through">₹<%= order.total.toLocaleString('en-IN') %></p>
                    <p class="text-red-400 text-[10px]">−₹<%= cancelledTotal.toLocaleString('en-IN') %> cancelled</p>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <!-- Update Status — hidden for terminal orders -->
          <div class="card-bg rounded-2xl p-5">
            <div class="flex items-center gap-2 mb-4">
              <i class="fas fa-edit text-cyan-400 text-xs"></i>
              <h3 class="text-[10px] font-bold text-white uppercase tracking-widest">Update Status</h3>
            </div>

            <% if (['cancelled', 'returned', 'delivered'].includes(order.status)) { %>
              <!-- Terminal state — locked -->
              <div class="flex items-start gap-3 p-3 bg-slate-800/50 rounded-xl border border-slate-700/50">
                <i class="fas fa-lock text-slate-500 text-xs mt-0.5 flex-shrink-0"></i>
                <div>
                  <p class="text-slate-400 text-xs font-semibold mb-0.5">Status Locked</p>
                  <p class="text-slate-600 text-[10px] leading-relaxed">
                    This order is <span class="text-<%= order.status === 'cancelled' ? 'red' : order.status === 'returned' ? 'orange' : 'green' %>-400 font-semibold"><%= order.status %></span> and cannot be updated further.
                  </p>
                </div>
              </div>
            <% } else { %>
              <select id="statusSelect"
                      class="w-full bg-[#05070A] border border-slate-800 rounded-xl py-2.5 px-3 text-sm text-slate-300 focus:outline-none focus:border-cyan-500/50 appearance-none mb-3">
                <% ['pending','confirmed','processing','shipped','delivered'].forEach(s => { %>
                  <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
                <% }) %>
              </select>
              <button onclick="updateStatus('<%= order._id %>')"
                      class="w-full bg-cyan-400 hover:bg-cyan-300 text-[#05070A] font-bold text-xs py-2.5 rounded-xl transition">
                Update Status
              </button>
            <% } %>
          </div>

          <%
            // Show restock card if any approved-return items haven't been restocked yet
            const pendingRestock = order.items.filter(
              i => i.returnStatus === 'approved' && !i.stockRestored
            );
          %>
          <% if (pendingRestock.length > 0) { %>
            <div class="card-bg rounded-2xl p-5 border border-amber-500/20">
              <div class="flex items-center gap-2 mb-3">
                <i class="fas fa-boxes text-amber-400 text-xs"></i>
                <h3 class="text-[10px] font-bold text-white uppercase tracking-widest">Restock Returned Items</h3>
              </div>
              <p class="text-slate-400 text-[11px] leading-relaxed mb-4">
                <span class="text-amber-400 font-bold"><%= pendingRestock.length %> item<%= pendingRestock.length !== 1 ? 's' : '' %></span>
                with approved returns are waiting to be restocked.
                Click below to add the quantities back to inventory.
              </p>
              <ul class="space-y-1.5 mb-4">
                <% pendingRestock.forEach(item => { %>
                  <li class="flex justify-between text-[10px]">
                    <span class="text-slate-300 truncate max-w-[160px]"><%= item.productName %></span>
                    <span class="text-amber-400 font-bold flex-shrink-0 ml-2">+<%= item.quantity %> units</span>
                  </li>
                <% }) %>
              </ul>
              <button onclick="restockItems('<%= order._id %>')"
                      class="w-full bg-amber-400 hover:bg-amber-300 text-[#05070A] font-bold text-xs py-2.5 rounded-xl transition flex items-center justify-center gap-2">
                <i class="fas fa-undo text-[10px]"></i>
                Restock to Inventory
              </button>
            </div>
          <% } %>

          <%
            // Show a "restocked" confirmation if all approved items are already restocked
            const allRestocked = order.items.some(i => i.returnStatus === 'approved' && i.stockRestored);
            const noneWaiting  = order.items.filter(i => i.returnStatus === 'approved').every(i => i.stockRestored);
          %>
          <% if (allRestocked && noneWaiting) { %>
            <div class="card-bg rounded-2xl p-4 border border-green-500/20 flex items-center gap-3">
              <div class="w-7 h-7 bg-green-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fas fa-check text-green-400 text-[10px]"></i>
              </div>
              <div>
                <p class="text-green-400 text-xs font-bold">Stock Restored</p>
                <p class="text-slate-500 text-[10px] mt-0.5">All returned items have been added back to inventory.</p>
              </div>
            </div>
          <% } %>

        </div>
      </div>

      <footer class="text-center py-8">
        <p class="text-[9px] text-slate-700 uppercase tracking-widest">© 2026 Neo-Luxe Admin Panel</p>
      </footer>

    </div>
  </main>
</div>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('-translate-x-full');
  }

  async function updateStatus(orderId) {
    const status = document.getElementById('statusSelect').value;
    const result = await Swal.fire({
      title: 'Update Status?',
      text: `Change order status to "${status}"?`,
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#22D3EE',
      cancelButtonColor: '#1E293B',
      confirmButtonText: 'Yes, update',
      background: '#0B1120',
      color: '#E2E8F0',
    });
    if (!result.isConfirmed) return;

    try {
      const res  = await fetch(`/admin/orders/${orderId}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
      });
      const data = await res.json();
      if (data.success) {
        await Swal.fire({ icon:'success', title:'Updated!', text: data.message,
          timer:1500, showConfirmButton:false, background:'#0B1120', color:'#E2E8F0' });
        location.reload();
      } else {
        Swal.fire({ icon:'error', title:'Error', text: data.message, background:'#0B1120', color:'#E2E8F0' });
      }
    } catch {
      Swal.fire({ icon:'error', title:'Error', text:'Something went wrong.', background:'#0B1120', color:'#E2E8F0' });
    }
  }

  async function handleReturn(orderId, action) {
    const label = action === 'approve' ? 'Approve' : 'Reject';
    const result = await Swal.fire({
      title: `${label} Return?`,
      text: action === 'approve'
        ? 'This will refund the full order amount to the customer wallet.'
        : 'This will revert the order to delivered status.',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: action === 'approve' ? '#22D3EE' : '#ef4444',
      cancelButtonColor: '#1E293B',
      confirmButtonText: `Yes, ${label}`,
      background: '#0B1120',
      color: '#E2E8F0',
    });
    if (!result.isConfirmed) return;

    try {
      const res  = await fetch(`/admin/orders/${orderId}/return`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action }),
      });
      const data = await res.json();
      if (data.success) {
        await Swal.fire({ icon:'success', title:'Done!', text: data.message,
          timer:1800, showConfirmButton:false, background:'#0B1120', color:'#E2E8F0' });
        location.reload();
      } else {
        Swal.fire({ icon:'error', title:'Error', text: data.message, background:'#0B1120', color:'#E2E8F0' });
      }
    } catch {
      Swal.fire({ icon:'error', title:'Error', text:'Something went wrong.', background:'#0B1120', color:'#E2E8F0' });
    }
  }

  async function restockItems(orderId) {
    const result = await Swal.fire({
      title: 'Restock Returned Items?',
      text: 'This will add the returned quantities back to inventory. This cannot be undone.',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#f59e0b',
      cancelButtonColor: '#1E293B',
      confirmButtonText: 'Yes, Restock',
      background: '#0B1120',
      color: '#E2E8F0',
    });
    if (!result.isConfirmed) return;

    try {
      const res  = await fetch(`/admin/orders/${orderId}/restock`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
      });
      const data = await res.json();
      if (data.success) {
        await Swal.fire({ icon: 'success', title: 'Restocked!', text: data.message,
          timer: 2000, showConfirmButton: false, background: '#0B1120', color: '#E2E8F0' });
        location.reload();
      } else {
        Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#0B1120', color: '#E2E8F0' });
      }
    } catch {
      Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong.', background: '#0B1120', color: '#E2E8F0' });
    }
  }

  // Restock a single item by index
  async function restockItem(orderId, itemIndex, productName, qty) {
    const result = await Swal.fire({
      title: 'Restock this item?',
      html: `Add <strong class="text-amber-400">+${qty} unit(s)</strong> of <strong>${productName}</strong> back to inventory?`,
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#f59e0b',
      cancelButtonColor: '#1E293B',
      confirmButtonText: 'Yes, Restock',
      cancelButtonText: 'Cancel',
      background: '#0B1120',
      color: '#E2E8F0',
    });
    if (!result.isConfirmed) return;

    try {
      const res  = await fetch(`/admin/orders/${orderId}/restock`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ itemIndex }),
      });
      const data = await res.json();
      if (data.success) {
        await Swal.fire({ icon: 'success', title: 'Restocked!', text: data.message,
          timer: 2000, showConfirmButton: false, background: '#0B1120', color: '#E2E8F0' });
        location.reload();
      } else {
        Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#0B1120', color: '#E2E8F0' });
      }
    } catch {
      Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong.', background: '#0B1120', color: '#E2E8F0' });
    }
  }

  async function handleItemReturn(orderId, itemIndex, action) {
    const label = action === 'approve' ? 'Approve' : 'Reject';
    const result = await Swal.fire({
      title: `${label} Item Return?`,
      text: action === 'approve'
        ? 'The item amount will be refunded to the customer wallet.'
        : 'The return request for this item will be rejected.',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: action === 'approve' ? '#22D3EE' : '#ef4444',
      cancelButtonColor: '#1E293B',
      confirmButtonText: `Yes, ${label}`,
      background: '#0B1120',
      color: '#E2E8F0',
    });
    if (!result.isConfirmed) return;

    try {
      const res  = await fetch(`/admin/orders/${orderId}/return`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, itemIndex }),
      });
      const data = await res.json();
      if (data.success) {
        await Swal.fire({ icon:'success', title:'Done!', text: data.message,
          timer:1800, showConfirmButton:false, background:'#0B1120', color:'#E2E8F0' });
        location.reload();
      } else {
        Swal.fire({ icon:'error', title:'Error', text: data.message, background:'#0B1120', color:'#E2E8F0' });
      }
    } catch {
      Swal.fire({ icon:'error', title:'Error', text:'Something went wrong.', background:'#0B1120', color:'#E2E8F0' });
    }
  }
</script>
</body>
</html>
