<%# views/user/order-details.ejs — rendered inside layouts/user %>
<%
  const orderId      = order.orderId || order._id.toString().slice(-8).toUpperCase();
  const isCancelled  = order.status === 'cancelled';
  const isReturned   = order.status === 'returned';
  const isDelivered  = order.status === 'delivered';
  const progressOrder = ['pending','confirmed','processing','shipped','delivered'];
  const currentIdx    = progressOrder.indexOf(order.status);

  // Order summary — use saved snapshot values, not recalculated
  const cancelledSubtotal = order.items.filter(i=>i.status==='cancelled').reduce((s,i)=>s+(i.itemTotal||0),0);
  const refundAmount      = order.items.filter(i=>i.returnStatus==='approved').reduce((s,i)=>s+(i.itemTotal||0),0);
  const displaySubtotal   = order.subtotal || 0;
  const displayShipping   = order.shipping || 0;
  const displayTax        = order.tax || 0;
  const displayDiscount   = order.discount || 0;
  const displayTotal      = order.total || 0;
  const couponCode        = order.couponCode || '';

  const statusGradient = {
    pending:    'from-amber-500/20 to-transparent',
    confirmed:  'from-cyan-500/20 to-transparent',
    processing: 'from-blue-500/20 to-transparent',
    shipped:    'from-purple-500/20 to-transparent',
    delivered:  'from-green-500/20 to-transparent',
    cancelled:  'from-red-500/20 to-transparent',
    returned:   'from-orange-500/20 to-transparent',
  };
  const statusDot = {
    pending:    'bg-amber-400',
    confirmed:  'bg-cyan-400',
    processing: 'bg-blue-400',
    shipped:    'bg-purple-400',
    delivered:  'bg-green-400',
    cancelled:  'bg-red-400',
    returned:   'bg-orange-400',
  };
%>
<style>
  .sbadge { display:inline-flex; align-items:center; gap:4px; font-size:10px; font-weight:700;
    padding:3px 10px; border-radius:999px; text-transform:capitalize; letter-spacing:.05em; }
  .s-pending    { background:#f59e0b22; color:#f59e0b; border:1px solid #f59e0b44; }
  .s-confirmed  { background:#22c55e22; color:#22c55e; border:1px solid #22c55e44; }
  .s-processing { background:#3b82f622; color:#3b82f6; border:1px solid #3b82f644; }
  .s-shipped    { background:#8b5cf622; color:#8b5cf6; border:1px solid #8b5cf644; }
  .s-delivered  { background:#10b98122; color:#10b981; border:1px solid #10b98144; }
  .s-cancelled  { background:#ef444422; color:#ef4444; border:1px solid #ef444444; }
  .s-returned   { background:#f97316/20; color:#f97316; border:1px solid #f9731644; }
  .s-paid       { background:#22c55e22; color:#22c55e; border:1px solid #22c55e44; }
  .s-refunded   { background:#06b6d422; color:#06b6d4; border:1px solid #06b6d444; }
  .s-return-pending { background:#f59e0b22; color:#f59e0b; border:1px solid #f59e0b44; }
  .card { background:#0a0f18; border:1px solid #1e2535; border-radius:1.25rem; }
  .card-hover:hover { border-color:#22d3ee33; }
  @keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
  .fade-up { animation:fadeUp .4s ease both; }
  .step-connector { height:2px; flex:1; }
</style>

<div class="min-h-screen bg-[#05080d]">

  <!-- ── Hero Header ──────────────────────────────────────────────────── -->
  <div class="relative overflow-hidden bg-gradient-to-b <%= statusGradient[order.status] || 'from-cyan-500/10 to-transparent' %> border-b border-white/5">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,212,255,0.06),transparent_60%)] pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-6 py-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-xs text-slate-600 mb-6">
        <a href="/" class="hover:text-slate-400 transition">Home</a>
        <span>/</span>
        <a href="/profile" class="hover:text-slate-400 transition">My Account</a>
        <span>/</span>
        <a href="/orders" class="hover:text-slate-400 transition">Orders</a>
        <span>/</span>
        <span class="text-cyan-400 font-semibold">Order Details</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div>
          <!-- Order ID -->
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-2xl bg-cyan-400/10 border border-cyan-400/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
            <h1 class="text-3xl font-black text-white tracking-tight">Order #<%= orderId %></h1>
          </div>
          <!-- Badges + date -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="sbadge s-<%= order.status %>">
              <span class="w-1.5 h-1.5 rounded-full <%= statusDot[order.status] || 'bg-slate-400' %>"></span>
              <%= order.status %>
            </span>
            <span class="sbadge s-<%= order.paymentStatus %>"><%= order.paymentStatus %></span>
            <span class="text-slate-500 text-xs">
              Placed on <%= fmt.formatDate(order.createdAt) %>
            </span>
          </div>
        </div>
        <a href="/orders"
           class="flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-cyan-400/30 text-slate-300 hover:text-white font-semibold text-sm px-5 py-2.5 rounded-xl transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to Orders
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-8">

    <!-- ── Progress Stepper ─────────────────────────────────────────── -->
    <div class="card p-6 mb-6 fade-up">
      <h2 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-6">Track Your Delivery</h2>

      <% if (isCancelled) { %>
        <div class="flex items-start gap-4 p-4 bg-red-500/10 border border-red-500/20 rounded-2xl">
          <div class="w-10 h-10 rounded-full bg-red-500/20 border-2 border-red-500 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </div>
          <div>
            <p class="text-red-400 font-bold text-sm">Order Cancelled</p>
            <p class="text-slate-500 text-xs mt-0.5">
              <%= fmt.formatDate(order.updatedAt) %>
            </p>
            <% const displayCancelReason = order.cancelReason || order.cancellationReason; %>
            <% if (displayCancelReason) { %>
              <div class="mt-2 flex items-start gap-1.5">
                <svg class="w-3.5 h-3.5 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <p class="text-slate-300 text-xs"><span class="text-slate-500">Reason:</span> <span class="font-medium"><%= displayCancelReason %></span></p>
              </div>
            <% } %>
          </div>
        </div>
      <% } else { %>
        <%
          const steps = [
            { key:'pending',    label:'Placed',     icon:'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
            { key:'processing', label:'Processing', icon:'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0' },
            { key:'shipped',    label:'Shipped',    icon:'M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0' },
            { key:'delivered',  label:'Delivered',  icon:'M5 13l4 4L19 7' },
          ];
        %>
        <div class="flex items-center gap-0">
          <% steps.forEach((step, i) => {
               const done    = currentIdx >= progressOrder.indexOf(step.key);
               const current = order.status === step.key || (step.key === 'pending' && ['pending','confirmed'].includes(order.status));
               const isLast  = i === steps.length - 1;
          %>
            <!-- Step -->
            <div class="flex flex-col items-center flex-shrink-0 <%= i === 0 ? '' : '' %>">
              <div class="w-10 h-10 rounded-full border-2 flex items-center justify-center transition-all
                <%= done
                    ? (current ? 'bg-cyan-400 border-cyan-400 shadow-[0_0_16px_rgba(34,211,238,0.5)]' : 'bg-cyan-400/20 border-cyan-400')
                    : 'bg-[#0a0f18] border-gray-700' %>">
                <svg class="w-4 h-4 <%= done ? 'text-white' : 'text-gray-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= step.icon %>"/>
                </svg>
              </div>
              <p class="text-[10px] font-bold mt-2 <%= done ? 'text-white' : 'text-gray-600' %> text-center whitespace-nowrap"><%= step.label %></p>
              <% if (current) { %>
                <p class="text-[9px] text-cyan-400 mt-0.5 text-center whitespace-nowrap">
                  <%= fmt.formatDateOnly(i === 0 ? order.createdAt : order.updatedAt) %>
                </p>
              <% } %>
            </div>
            <!-- Connector -->
            <% if (!isLast) { %>
              <div class="step-connector mx-1 rounded-full <%= done ? 'bg-cyan-400/50' : 'bg-gray-800' %>"></div>
            <% } %>
          <% }) %>

          <% if (isReturned) { %>
            <div class="step-connector mx-1 rounded-full bg-orange-400/50"></div>
            <div class="flex flex-col items-center flex-shrink-0">
              <div class="w-10 h-10 rounded-full border-2 bg-orange-400/20 border-orange-400 shadow-[0_0_16px_rgba(251,146,60,0.4)] flex items-center justify-center">
                <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
                </svg>
              </div>
              <p class="text-[10px] font-bold mt-2 text-orange-400 text-center">Returned</p>
              <p class="text-[9px] text-orange-400/70 mt-0.5 text-center">
                <%= fmt.formatDateOnly(order.updatedAt) %>
              </p>
            </div>
          <% } %>

          <% if (!isReturned && order.items.some(i => i.returnStatus === 'requested')) { %>
            <div class="step-connector mx-1 rounded-full bg-amber-400/30"></div>
            <div class="flex flex-col items-center flex-shrink-0">
              <div class="w-10 h-10 rounded-full border-2 border-dashed border-amber-400 bg-amber-400/10 flex items-center justify-center animate-pulse">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <p class="text-[10px] font-bold mt-2 text-amber-400 text-center">Return<br/>Pending</p>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- ── Main Grid ────────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- LEFT: Order Items -->
      <div class="lg:col-span-8 space-y-4 fade-up" style="animation-delay:.1s">
        <div class="card p-6">
          <div class="flex items-center justify-between mb-5">
            <h2 class="text-sm font-bold text-white uppercase tracking-widest">Order Items</h2>
            <span class="text-xs text-slate-500"><%= order.items.length %> item<%= order.items.length !== 1 ? 's' : '' %></span>
          </div>

          <div class="space-y-4">
            <% order.items.forEach((item, index) => {
                 const itemCancelled = item.status === 'cancelled' || order.status === 'cancelled';
            %>
            <div class="group flex gap-4 p-4 rounded-2xl border transition-all
              <%= itemCancelled ? 'bg-red-500/5 border-red-500/15' : 'bg-[#060c18] border-[#1a2235] hover:border-cyan-400/20' %>">

              <!-- Image -->
              <div class="w-20 h-20 rounded-xl overflow-hidden border border-white/5 flex-shrink-0 bg-[#0d1525]">
                <% if (item.imageUrl) { %>
                  <img src="<%= item.imageUrl %>" alt="<%= item.productName %>"
                       class="w-full h-full object-cover <%= itemCancelled ? 'opacity-40 grayscale' : '' %>"/>
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-slate-700">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
                    </svg>
                  </div>
                <% } %>
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <p class="text-white font-bold text-sm truncate mb-1"><%= item.productName %></p>
                <div class="flex flex-wrap gap-2 mb-2">
                  <% if (item.variantColor) { %>
                    <span class="text-[10px] bg-white/5 text-slate-400 px-2 py-0.5 rounded-full border border-white/5 capitalize"><%= item.variantColor %></span>
                  <% } %>
                  <span class="text-[10px] bg-white/5 text-slate-400 px-2 py-0.5 rounded-full border border-white/5">Qty: <%= item.quantity %></span>
                </div>
                <!-- Per-item status -->
                <% if (itemCancelled) { %>
                  <span class="sbadge s-cancelled">Cancelled</span>
                <% } else if (item.returnStatus === 'approved') { %>
                  <span class="sbadge s-returned">✓ Return Approved</span>
                <% } else if (item.returnStatus === 'requested') { %>
                  <span class="sbadge s-return-pending">⏳ Return Pending</span>
                <% } else if (item.returnStatus === 'rejected') { %>
                  <span class="sbadge s-delivered">Delivered</span>
                <% } else { %>
                  <% const ds = isReturned ? 'delivered' : order.status; %>
                  <span class="sbadge s-<%= ds %>"><%= ds %></span>
                <% } %>
                <% if (item.returnStatus === 'requested' && item.returnReason) { %>
                  <p class="text-amber-400/70 text-[10px] mt-1.5 italic">Return reason: <%= item.returnReason %></p>
                <% } %>
              </div>

              <!-- Price + Actions -->
              <div class="flex flex-col items-end justify-between flex-shrink-0">
                <p class="text-cyan-400 font-black text-base">
                  ₹<%= (item.itemTotal || item.basePrice * item.quantity).toLocaleString('en-IN') %>
                </p>
                <div class="flex flex-col gap-1.5 mt-2">
                  <% if (['pending','confirmed','processing'].includes(order.status) && item.status !== 'cancelled') { %>
                    <button onclick="cancelItem('<%= order._id %>', <%= index %>)"
                            class="text-[10px] font-bold text-red-400 border border-red-400/30 hover:bg-red-400/10 px-3 py-1.5 rounded-lg transition">
                      Cancel
                    </button>
                  <% } %>
                  <% if (order.status === 'delivered' && item.status !== 'cancelled' && item.returnStatus === 'none') { %>
                    <button onclick="openItemReturnModal('<%= order._id %>', <%= index %>, '<%= item.productName.replace(/'/g, "\\'") %>')"
                            class="text-[10px] font-bold text-orange-400 border border-orange-400/30 hover:bg-orange-400/10 px-3 py-1.5 rounded-lg transition">
                      Return
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
            <% }) %>
          </div>

          <% if (order.cancelReason && !isCancelled) { %>
            <div class="mt-4 p-3 bg-red-500/10 border border-red-500/20 rounded-xl">
              <p class="text-red-400 text-xs font-semibold">Cancellation Reason: <span class="font-normal text-slate-400"><%= order.cancelReason %></span></p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- RIGHT: Summary + Info + Payment -->
      <div class="lg:col-span-4 space-y-4 fade-up" style="animation-delay:.2s">

        <!-- Order Summary -->
        <div class="card p-5">
          <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-4">Order Summary</h3>
          <div class="space-y-2.5 text-sm">
            <div class="flex justify-between">
              <span class="text-slate-400">Subtotal</span>
              <span class="text-white font-medium">₹<%= displaySubtotal.toLocaleString('en-IN') %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Delivery</span>
              <span class="<%= displayShipping === 0 ? 'text-cyan-400 font-semibold' : 'text-white font-medium' %>">
                <%= displayShipping === 0 ? 'Free' : '₹' + displayShipping.toLocaleString('en-IN') %>
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Tax (18% GST)</span>
              <span class="text-white font-medium">₹<%= displayTax.toLocaleString('en-IN') %></span>
            </div>
            <% if (displayDiscount > 0) { %>
              <div class="flex justify-between text-green-400">
                <span>Coupon Discount<%= couponCode ? ' (' + couponCode + ')' : '' %></span>
                <span class="font-semibold">−₹<%= displayDiscount.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
            <% if (cancelledSubtotal > 0) { %>
              <div class="flex justify-between text-red-400">
                <span>Cancelled items</span>
                <span>−₹<%= cancelledSubtotal.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
            <% if (refundAmount > 0) { %>
              <div class="flex justify-between text-orange-400">
                <span>Refunded to wallet</span>
                <span>−₹<%= refundAmount.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
          </div>
          <div class="border-t border-white/5 mt-4 pt-4 flex justify-between items-center">
            <span class="text-white font-bold">Total</span>
            <span class="text-cyan-400 font-black text-xl">₹<%= displayTotal.toLocaleString('en-IN') %></span>
          </div>
        </div>

        <!-- Delivery Info -->
        <div class="card p-5">
          <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-4">Delivery Information</h3>
          <div class="space-y-3">
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-lg bg-cyan-400/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div class="text-xs">
                <p class="text-white font-semibold mb-0.5"><%= order.shippingAddress.fullName %></p>
                <p class="text-slate-400 leading-relaxed">
                  <%= order.shippingAddress.addressLine1 %><% if (order.shippingAddress.addressLine2) { %>, <%= order.shippingAddress.addressLine2 %><% } %>,
                  <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.pincode %>
                </p>
              </div>
            </div>
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-lg bg-cyan-400/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <p class="text-slate-400 text-xs self-center"><%= order.shippingAddress.phone %></p>
            </div>
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-lg bg-cyan-400/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                </svg>
              </div>
              <p class="text-slate-400 text-xs self-center">
                <%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : order.paymentMethod === 'wallet' ? 'Wallet' : order.paymentMethod === 'razorpay' ? 'Razorpay' : 'Online Payment' %>
              </p>
            </div>
          </div>
        </div>

        <!-- Payment -->
        <div class="card p-5">
          <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-4">Payment</h3>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Method</span>
              <span class="text-white font-semibold text-xs">
                <%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : order.paymentMethod === 'wallet' ? 'Wallet' : order.paymentMethod === 'razorpay' ? 'Razorpay' : 'Online' %>
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Status</span>
              <%
                const psMap = { pending:'s-pending', paid:'s-paid', failed:'s-cancelled', refunded:'s-refunded', cancelled:'s-cancelled' };
                const psLabel = { pending:'Pending', paid:'Paid', failed:'Failed', refunded:'Refunded', cancelled:'Cancelled' };
              %>
              <span class="sbadge <%= psMap[order.paymentStatus] || '' %>"><%= psLabel[order.paymentStatus] || order.paymentStatus %></span>
            </div>
            <% if (order.paymentStatus === 'paid' || order.paymentStatus === 'refunded') { %>
              <div class="flex justify-between items-center">
                <span class="text-slate-400">Date</span>
                <span class="text-slate-300 text-xs"><%= fmt.formatDateShort(order.updatedAt) %></span>
              </div>
            <% } %>
          </div>
          <% if (order.paymentStatus === 'refunded') { %>
            <div class="mt-4 p-3 bg-cyan-400/10 border border-cyan-400/20 rounded-xl flex items-start gap-2">
              <svg class="w-4 h-4 text-cyan-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
              </svg>
              <div>
                <p class="text-cyan-400 text-xs font-bold">Refunded to Wallet</p>
                <p class="text-slate-400 text-[10px] mt-0.5">₹<%= refundAmount.toLocaleString('en-IN') %> credited to your wallet.</p>
              </div>
            </div>
          <% } %>
          <% if (order.paymentStatus === 'cancelled') { %>
            <p class="text-slate-500 text-xs mt-3">No charge was made for this order.</p>
          <% } %>
        </div>

        <!-- Actions -->
        <%
          const canDownloadInvoice = (
            order.status !== 'cancelled' && order.status !== 'returned' &&
            (
              (order.paymentMethod === 'razorpay' || order.paymentMethod === 'wallet') && order.paymentStatus === 'paid'
              || order.status === 'delivered'
            )
          );
        %>
        <% if (canDownloadInvoice) { %>
          <button onclick="downloadInvoice()"
                  class="w-full bg-cyan-400 hover:bg-cyan-300 active:bg-cyan-500 text-[#05080d] font-bold text-sm py-3.5 rounded-xl transition-all shadow-[0_4px_20px_rgba(34,211,238,0.2)] flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Download Invoice
          </button>
        <% } %>

        <% if (['pending','confirmed','processing'].includes(order.status)) { %>
          <button onclick="openCancelModal()"
                  class="w-full bg-transparent border border-red-500/30 hover:border-red-400/60 hover:bg-red-500/10 text-red-400 font-semibold text-sm py-3.5 rounded-xl transition-all flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Cancel Order
          </button>
        <% } %>

        <% if (order.status === 'delivered' && order.items.some(i => i.status !== 'cancelled' && i.returnStatus === 'none')) { %>
          <div class="card p-4 border-orange-400/20 text-center">
            <p class="text-orange-400 text-xs font-semibold mb-1">Need to return an item?</p>
            <p class="text-slate-600 text-[10px]">Use the Return button next to each product above.</p>
          </div>
        <% } %>

      </div>
    </div>
  </div><!-- max-w-6xl -->
</div><!-- min-h-screen -->

<!-- ── Cancel Modal ──────────────────────────────────────────────────── -->
<div id="cancel-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="card p-6 max-w-md w-full shadow-2xl">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
        <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </div>
      <div>
        <h3 class="text-white font-bold text-base">Cancel Order</h3>
        <p class="text-slate-500 text-xs">This action cannot be undone.</p>
      </div>
    </div>

    <label class="block text-xs text-slate-500 font-semibold uppercase tracking-wider mb-2">
      Reason <span class="text-red-400">*</span>
    </label>
    <select id="cancel-reason-select"
            class="w-full bg-[#060c18] border border-[#1a2235] focus:border-red-400/50 rounded-xl p-3 text-white text-sm outline-none transition mb-3"
            onchange="toggleCustomReason(this.value)">
      <option value="">— Select a reason —</option>
      <option value="Changed my mind">Changed my mind</option>
      <option value="Found a better price elsewhere">Found a better price elsewhere</option>
      <option value="Ordered by mistake">Ordered by mistake</option>
      <option value="Delivery time too long">Delivery time too long</option>
      <option value="Shipping address is wrong">Shipping address is wrong</option>
      <option value="other">Other (specify below)</option>
    </select>
    <textarea id="cancel-reason-custom" rows="2"
              class="w-full bg-[#060c18] border border-[#1a2235] focus:border-red-400/50 rounded-xl p-3 text-white text-sm outline-none transition resize-none hidden mb-3"
              placeholder="Please describe your reason..."></textarea>
    <p id="cancel-reason-error" class="hidden text-red-400 text-xs mb-3">Please select a reason for cancellation.</p>

    <div class="flex gap-3">
      <button type="button" onclick="closeCancelModal()"
              class="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold py-3 rounded-xl transition text-sm">
        Keep Order
      </button>
      <button type="button" onclick="submitCancelOrder()"
              class="flex-1 bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded-xl transition text-sm">
        Confirm Cancel
      </button>
    </div>
  </div>
</div>

<!-- ── Return Modal ───────────────────────────────────────────────────── -->
<div id="return-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="card p-6 max-w-md w-full shadow-2xl">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-xl bg-orange-400/10 border border-orange-400/20 flex items-center justify-center">
        <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
        </svg>
      </div>
      <div>
        <h3 class="text-white font-bold text-base">Request Return</h3>
        <p id="return-item-name" class="text-orange-400 text-xs font-semibold mt-0.5"></p>
      </div>
    </div>
    <p class="text-slate-400 text-xs mb-4 leading-relaxed">Our team will review your request and respond within 24–48 hours.</p>
    <label class="block text-xs text-slate-500 font-semibold uppercase tracking-wider mb-2">Reason <span class="text-red-400">*</span></label>
    <textarea id="return-reason" rows="3" required
              class="w-full bg-[#060c18] border border-[#1a2235] focus:border-orange-400/50 rounded-xl p-3 text-white text-sm outline-none transition resize-none"
              placeholder="e.g. Received wrong item, product damaged..."></textarea>
    <p id="return-error" class="hidden text-red-400 text-xs mt-2">Please provide a reason for the return.</p>
    <div class="flex gap-3 mt-5">
      <button type="button" onclick="closeReturnModal()"
              class="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold py-3 rounded-xl transition text-sm">
        Cancel
      </button>
      <button type="button" onclick="submitItemReturn()"
              class="flex-1 bg-orange-400 hover:bg-orange-300 text-[#05080d] font-bold py-3 rounded-xl transition text-sm">
        Submit Return
      </button>
    </div>
  </div>
</div>

<script>
  function openCancelModal() {
    document.getElementById('cancel-reason-select').value = '';
    document.getElementById('cancel-reason-custom').classList.add('hidden');
    document.getElementById('cancel-reason-custom').value = '';
    document.getElementById('cancel-reason-error').classList.add('hidden');
    document.getElementById('cancel-modal').classList.remove('hidden');
  }
  function closeCancelModal() { document.getElementById('cancel-modal').classList.add('hidden'); }

  function toggleCustomReason(val) {
    const custom = document.getElementById('cancel-reason-custom');
    if (val === 'other') {
      custom.classList.remove('hidden');
    } else {
      custom.classList.add('hidden');
      custom.value = '';
    }
    document.getElementById('cancel-reason-error').classList.add('hidden');
  }
  function openReturnModal() {}
  function closeReturnModal() { document.getElementById('return-modal').classList.add('hidden'); }

  let _returnItemIndex = null;
  function openItemReturnModal(orderId, itemIndex, itemName) {
    _returnItemIndex = itemIndex;
    document.getElementById('return-reason').value = '';
    document.getElementById('return-error').classList.add('hidden');
    document.getElementById('return-item-name').textContent = itemName;
    document.getElementById('return-modal').classList.remove('hidden');
  }

  async function submitItemReturn() {
    const reason = document.getElementById('return-reason').value.trim();
    if (!reason) { document.getElementById('return-error').classList.remove('hidden'); return; }
    document.getElementById('return-error').classList.add('hidden');
    const btn = document.querySelector('#return-modal button[onclick="submitItemReturn()"]');
    btn.disabled = true; btn.textContent = 'Submitting…';
    try {
      const res  = await fetch('/orders/<%= order._id %>/items/' + _returnItemIndex + '/return', {
        method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ reason }),
      });
      const data = await res.json();
      if (data.success) {
        closeReturnModal();
        await Swal.fire({ icon:'success', title:'Return Requested', text:data.message,
          background:'#0a0f18', color:'#fff', confirmButtonColor:'#22d3ee', timer:2500, showConfirmButton:false });
        location.reload();
      } else {
        Swal.fire({ icon:'error', title:'Cannot Return', text:data.message, background:'#0a0f18', color:'#fff', confirmButtonColor:'#22d3ee' });
        btn.disabled = false; btn.textContent = 'Submit Return';
      }
    } catch {
      Swal.fire({ icon:'error', title:'Error', text:'Something went wrong.', background:'#0a0f18', color:'#fff', confirmButtonColor:'#22d3ee' });
      btn.disabled = false; btn.textContent = 'Submit Return';
    }
  }

  async function submitCancelOrder() {
    const select = document.getElementById('cancel-reason-select');
    const custom = document.getElementById('cancel-reason-custom');
    const errorEl = document.getElementById('cancel-reason-error');

    let reason = select.value;
    if (!reason) {
      errorEl.classList.remove('hidden');
      return;
    }
    if (reason === 'other') {
      reason = custom.value.trim();
      if (!reason) {
        errorEl.textContent = 'Please describe your reason.';
        errorEl.classList.remove('hidden');
        return;
      }
    }
    errorEl.classList.add('hidden');

    const btn = document.querySelector('#cancel-modal button[onclick="submitCancelOrder()"]');
    btn.disabled = true; btn.textContent = 'Cancelling…';
    try {
      const res  = await fetch('/orders/<%= order._id %>/cancel', {
        method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ reason }),
      });
      const data = await res.json();
      if (data.success) {
        closeCancelModal();
        await Swal.fire({ icon:'success', title:'Order Cancelled', text: data.message,
          background:'#0a0f18', color:'#fff', confirmButtonColor:'#22d3ee', timer:3000, showConfirmButton:false });
        location.reload();
      } else {
        Swal.fire({ icon:'error', title:'Cannot Cancel', text:data.message, background:'#0a0f18', color:'#fff', confirmButtonColor:'#22d3ee' });
        btn.disabled = false; btn.textContent = 'Confirm Cancel';
      }
    } catch {
      Swal.fire({ icon:'error', title:'Error', text:'Something went wrong.', background:'#0a0f18', color:'#fff', confirmButtonColor:'#22d3ee' });
      btn.disabled = false; btn.textContent = 'Confirm Cancel';
    }
  }

  function cancelItem(orderId, itemIndex) {
    Swal.fire({
      title:'Cancel this item?', text:'Stock will be restored. This cannot be undone.', icon:'warning',
      input:'textarea', inputPlaceholder:'Reason (optional)…', inputAttributes:{rows:2},
      showCancelButton:true, confirmButtonColor:'#ef4444', cancelButtonColor:'#334155',
      confirmButtonText:'Yes, cancel it', cancelButtonText:'Keep item',
      background:'#0a0f18', color:'#fff',
    }).then(result => {
      if (!result.isConfirmed) return;
      fetch(`/orders/${orderId}/items/${itemIndex}/cancel`, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ reason: result.value || 'Customer requested cancellation' }),
      }).then(r=>r.json()).then(data => {
        if (data.success) {
          Swal.fire({ icon:'success', title:'Item Cancelled', text:data.message,
            background:'#0a0f18', color:'#fff', confirmButtonColor:'#22d3ee', timer:2000, showConfirmButton:false,
          }).then(()=>location.reload());
        } else {
          Swal.fire({ icon:'error', title:'Failed', text:data.message, background:'#0a0f18', color:'#fff', confirmButtonColor:'#22d3ee' });
        }
      }).catch(()=>Swal.fire({ icon:'error', title:'Error', text:'Something went wrong.', background:'#0a0f18', color:'#fff', confirmButtonColor:'#22d3ee' }));
    });
  }

  function downloadInvoice() { window.open('/orders/<%= order._id %>/invoice', '_blank'); }

  document.getElementById('cancel-modal').addEventListener('click', function(e){ if(e.target===this) closeCancelModal(); });
  document.getElementById('return-modal').addEventListener('click', function(e){ if(e.target===this) closeReturnModal(); });
</script>
