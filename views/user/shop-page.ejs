<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Our Collections | Premium Watches</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body {
            background: #0a0e1a;
            font-family: 'DM Sans', sans-serif;
            color: #e2e8f0;
        }

        /* ── Radio dot ──────────────────────────────────────────────────────
           The <input> is hidden (sr-only).  We use a JS-applied class
           `.is-checked` on the <label> itself to colour the dot reliably,
           because CSS sibling selectors can be tricky with sr-only inputs
           in some browsers.
        ─────────────────────────────────────────────────────────────────── */
        .radio-dot {
            width: 16px;
            height: 16px;
            border: 2px solid #334155;
            border-radius: 50%;
            position: relative;
            flex-shrink: 0;
            transition: border-color .2s, background .2s;
        }
        /* inner pip — hidden by default */
        .radio-dot::after {
            content: '';
            width: 6px;
            height: 6px;
            background: #0a0e1a;
            border-radius: 50%;
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            display: none;
        }

        /* SELECTED state — toggled by JS via .is-checked on the <label> */
        label.is-checked .radio-dot {
            background: #00d4ff;
            border-color: #00d4ff;
        }
        label.is-checked .radio-dot::after {
            display: block;
        }

        /* hover — only when NOT selected */
        label:not(.is-checked):hover .radio-dot {
            border-color: #00d4ff;
        }

        /* ── Cards ──────────────────────────────────────────────────────── */
        .card-hover {
            transition: transform .25s, border-color .25s, box-shadow .25s;
        }
        .card-hover:hover {
            transform: translateY(-4px);
            border-color: #00d4ff !important;
            box-shadow: 0 0 24px rgba(0, 212, 255, 0.12);
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .product-card {
            animation: fadeUp 0.35s ease both;
            animation-delay: var(--delay);
        }

        /* ── Sidebar toggle ─────────────────────────────────────────────── */
        #sidebar-panel {
            transition: width .3s ease, opacity .3s ease, transform .3s ease;
            overflow: hidden;
        }
        #sidebar-panel.collapsed {
            width: 0 !important;
            opacity: 0;
            pointer-events: none;
            transform: translateX(-12px);
        }
        #toggle-sidebar-btn {
            transition: background .2s, color .2s;
        }
    </style>
</head>

<body>
<div class="min-h-screen">

    <!-- Breadcrumb -->
    <nav class="max-w-7xl mx-auto px-6 py-4 text-xs text-slate-500">
        <a href="/" class="hover:text-slate-300 transition">Home</a>
        <span class="mx-1">/</span>
        <span class="text-slate-300">Shop All</span>
    </nav>

    <main class="max-w-7xl mx-auto px-6 pb-20 flex flex-col lg:flex-row gap-8">

        <!-- ═══════════════════════════════════════════════════════════════
             SIDEBAR  — one single form for every filter + sort
             ═══════════════════════════════════════════════════════════════ -->
        <aside id="sidebar-panel" class="w-64 flex-shrink-0 hidden lg:block">
            <form id="filterForm" method="GET" action="/shop">
                <!-- carry search & reset page on every filter change -->
                <input type="hidden" name="search" value="<%= query.search || '' %>" />
                <input type="hidden" name="page"   value="1" />

                <!-- header -->
                <div class="flex items-center justify-between mb-6">
                    <span class="text-sm font-semibold text-white tracking-wide">Filter By</span>
                    <a href="/shop" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition">CLEAR ALL</a>
                </div>

                <!-- ── Categories ──────────────────────────────────────── -->
                <section class="mb-8">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-[0.15em] mb-4">Categories</p>
                    <div class="space-y-3">
                        <label class="flex items-center gap-3 cursor-pointer <%= !query.category ? 'is-checked' : '' %>">
                            <input type="radio" name="category" value=""
                                   class="sr-only filter-radio"
                                   <%= !query.category ? 'checked' : '' %>
                                   onchange="this.form.submit()" />
                            <span class="radio-dot"></span>
                            <span class="text-sm text-slate-300 group-hover:text-white transition">All</span>
                        </label>
                        <% categories.forEach(cat => {
                            const isChecked = query.category && query.category.toString() === cat._id.toString();
                        %>
                            <label class="flex items-center gap-3 cursor-pointer <%= isChecked ? 'is-checked' : '' %>">
                                <input type="radio" name="category" value="<%= cat._id %>"
                                       class="sr-only filter-radio"
                                       <%= isChecked ? 'checked' : '' %>
                                       onchange="this.form.submit()" />
                                <span class="radio-dot"></span>
                                <span class="text-sm text-slate-300 transition"><%= cat.name %></span>
                            </label>
                        <% }) %>
                    </div>
                </section>

                <!-- ── Price Range ─────────────────────────────────────── -->
                <section class="mb-8">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-[0.15em] mb-4">Price Range</p>
                    <div class="space-y-3">
                        <% const priceOpts = [
                            { label: 'All Prices',        val: '' },
                            { label: 'Under ₹5,000',      val: '0-5000' },
                            { label: '₹5,000 – ₹10,000', val: '5000-10000' },
                            { label: 'Above ₹10,000',     val: '10000-' },
                        ]; %>
                        <% priceOpts.forEach(opt => {
                            const isChecked = (query.price || '') === opt.val;
                        %>
                            <label class="flex items-center gap-3 cursor-pointer <%= isChecked ? 'is-checked' : '' %>">
                                <input type="radio" name="price" value="<%= opt.val %>"
                                       class="sr-only filter-radio"
                                       <%= isChecked ? 'checked' : '' %>
                                       onchange="this.form.submit()" />
                                <span class="radio-dot"></span>
                                <span class="text-sm text-slate-300 transition"><%= opt.label %></span>
                            </label>
                        <% }) %>
                    </div>
                </section>

                <!-- ── Brand ──────────────────────────────────────────── -->
                <% if (brands && brands.length > 0) { %>
                <section class="mb-8">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-[0.15em] mb-4">Brand</p>
                    <div class="space-y-3">
                        <label class="flex items-center gap-3 cursor-pointer <%= !query.brand ? 'is-checked' : '' %>">
                            <input type="radio" name="brand" value=""
                                   class="sr-only filter-radio"
                                   <%= !query.brand ? 'checked' : '' %>
                                   onchange="this.form.submit()" />
                            <span class="radio-dot"></span>
                            <span class="text-sm text-slate-300 transition">All Brands</span>
                        </label>
                        <% brands.forEach(b => {
                            const isChecked = (query.brand || '').toLowerCase() === b.toLowerCase();
                        %>
                            <label class="flex items-center gap-3 cursor-pointer <%= isChecked ? 'is-checked' : '' %>">
                                <input type="radio" name="brand" value="<%= b %>"
                                       class="sr-only filter-radio"
                                       <%= isChecked ? 'checked' : '' %>
                                       onchange="this.form.submit()" />
                                <span class="radio-dot"></span>
                                <span class="text-sm text-slate-300 transition"><%= b %></span>
                            </label>
                        <% }) %>
                    </div>
                </section>
                <% } %>

                <!-- ── Sort By ─────────────────────────────────────────── -->
                <section class="mb-8">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-[0.15em] mb-4">Sort By</p>
                    <div class="space-y-3">
                        <% const sortOpts = [
                            { val: 'az',        label: 'A – Z' },
                            { val: 'za',        label: 'Z – A' },
                            { val: 'lowToHigh', label: 'Price: Low to High' },
                            { val: 'highToLow', label: 'Price: High to Low' },
                        ]; %>
                        <% sortOpts.forEach(opt => {
                            const isChecked = (query.sort || 'az') === opt.val;
                        %>
                            <label class="flex items-center gap-3 cursor-pointer <%= isChecked ? 'is-checked' : '' %>">
                                <input type="radio" name="sort" value="<%= opt.val %>"
                                       class="sr-only filter-radio"
                                       <%= isChecked ? 'checked' : '' %>
                                       onchange="this.form.submit()" />
                                <span class="radio-dot"></span>
                                <span class="text-sm text-slate-300 transition"><%= opt.label %></span>
                            </label>
                        <% }) %>
                    </div>
                </section>

            </form>
        </aside>


        <!-- ═══════════════════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════════════════ -->
        <div class="flex-1 min-w-0">

            <!-- Toggle sidebar button (desktop only) -->
            <button id="toggle-sidebar-btn"
                    onclick="toggleSidebar()"
                    class="hidden lg:flex items-center gap-2 mb-4 px-4 py-2 bg-[#0f1526] border border-[#1e2640] rounded-xl text-slate-400 hover:text-cyan-400 hover:border-cyan-400 transition text-xs font-semibold">
                <svg id="toggle-icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                <span id="toggle-text">Hide Filters</span>
            </button>

            <!-- Search bar -->
            <form method="GET" action="/shop" id="searchForm" class="mb-8">
                <input type="hidden" name="category" value="<%= query.category || '' %>" />
                <input type="hidden" name="price"    value="<%= query.price    || '' %>" />
                <input type="hidden" name="brand"    value="<%= query.brand    || '' %>" />
                <input type="hidden" name="sort"     value="<%= query.sort     || 'az' %>" />
                <input type="hidden" name="page"     value="1" />

                <div class="flex gap-3">
                    <div class="relative flex-1">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </span>
                        <input type="text" name="search" value="<%= query.search || '' %>"
                               placeholder="Search watches..."
                               class="w-full bg-[#0f1526] border border-[#1e2640] rounded-xl pl-11 pr-10 py-3 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition" />
                        <% if (query.search) {
                            const clearP = new URLSearchParams({
                                ...(query.category && { category: query.category }),
                                ...(query.price    && { price:    query.price }),
                                ...(query.brand    && { brand:    query.brand }),
                                sort: query.sort || 'az',
                                page: 1,
                            });
                        %>
                            <a href="/shop?<%= clearP.toString() %>"
                               class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white text-xl leading-none"
                               title="Clear search">&times;</a>
                        <% } %>
                    </div>
                    <button type="submit"
                            class="px-7 py-3 bg-cyan-400 text-[#0a0e1a] text-sm font-bold rounded-xl hover:bg-cyan-300 transition">
                        SEARCH
                    </button>
                    <button type="button"
                            onclick="document.getElementById('mobileFilter').classList.toggle('hidden')"
                            class="lg:hidden px-4 py-3 bg-[#161d30] border border-[#1e2640] text-slate-300 text-sm rounded-xl">
                        Filters
                    </button>
                </div>
            </form>

            <!-- Mobile filter panel -->
            <div id="mobileFilter" class="hidden lg:hidden bg-[#0f1526] border border-[#1e2640] rounded-2xl p-6 mb-8">
                <form method="GET" action="/shop" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <input type="hidden" name="search" value="<%= query.search || '' %>" />
                    <input type="hidden" name="page"   value="1" />
                    <div>
                        <label class="text-xs text-slate-500 font-bold uppercase mb-2 block">Category</label>
                        <select name="category" class="w-full bg-[#161d30] border border-[#1e2640] text-slate-300 text-sm rounded-lg p-2.5 focus:outline-none">
                            <option value="">All Categories</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat._id %>" <%= query.category === cat._id.toString() ? 'selected' : '' %>>
                                    <%= cat.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs text-slate-500 font-bold uppercase mb-2 block">Brand</label>
                        <select name="brand" class="w-full bg-[#161d30] border border-[#1e2640] text-slate-300 text-sm rounded-lg p-2.5 focus:outline-none">
                            <option value="">All Brands</option>
                            <% (brands || []).forEach(b => { %>
                                <option value="<%= b %>" <%= (query.brand||'').toLowerCase()===b.toLowerCase() ? 'selected':'' %>>
                                    <%= b %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs text-slate-500 font-bold uppercase mb-2 block">Price Range</label>
                        <select name="price" class="w-full bg-[#161d30] border border-[#1e2640] text-slate-300 text-sm rounded-lg p-2.5 focus:outline-none">
                            <option value="">All Prices</option>
                            <option value="0-5000"     <%= query.price==='0-5000'     ? 'selected':'' %>>Under ₹5,000</option>
                            <option value="5000-10000" <%= query.price==='5000-10000' ? 'selected':'' %>>₹5,000 – ₹10,000</option>
                            <option value="10000-"     <%= query.price==='10000-'     ? 'selected':'' %>>Above ₹10,000</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs text-slate-500 font-bold uppercase mb-2 block">Sort By</label>
                        <select name="sort" class="w-full bg-[#161d30] border border-[#1e2640] text-slate-300 text-sm rounded-lg p-2.5 focus:outline-none">
                            <option value="az"        <%= (query.sort||'az')==='az'        ? 'selected':'' %>>A – Z</option>
                            <option value="za"        <%= query.sort==='za'                ? 'selected':'' %>>Z – A</option>
                            <option value="lowToHigh" <%= query.sort==='lowToHigh'         ? 'selected':'' %>>Price: Low → High</option>
                            <option value="highToLow" <%= query.sort==='highToLow'         ? 'selected':'' %>>Price: High → Low</option>
                        </select>
                    </div>
                    <button type="submit" class="sm:col-span-2 w-full py-3 bg-cyan-400 text-[#0a0e1a] font-bold rounded-xl">
                        APPLY FILTERS
                    </button>
                </form>
            </div>

            <!-- Results count + active chips -->
            <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
                <p class="text-sm text-slate-400">
                    Showing <span class="text-white font-bold"><%= products.length %></span>
                    of <span class="text-white font-bold"><%= totalProducts %></span> results
                </p>

                <div class="flex flex-wrap gap-2">
                    <% if (query.category) {
                        const cat = categories.find(c => c._id.toString() === query.category);
                        if (cat) {
                            const noCat = new URLSearchParams(Object.assign({}, query, { page: 1 }));
                            noCat.delete('category');
                    %>
                        <span class="text-[10px] bg-cyan-400/10 text-cyan-400 border border-cyan-400/20 px-3 py-1 rounded-full flex items-center uppercase font-bold tracking-wider">
                            <%= cat.name %>
                            <a href="/shop?<%= noCat.toString() %>" class="ml-2 hover:text-white text-sm">&times;</a>
                        </span>
                    <% }} %>

                    <% if (query.brand) {
                        const noBrand = new URLSearchParams(Object.assign({}, query, { page: 1 }));
                        noBrand.delete('brand');
                    %>
                        <span class="text-[10px] bg-purple-400/10 text-purple-400 border border-purple-400/20 px-3 py-1 rounded-full flex items-center uppercase font-bold tracking-wider">
                            <%= query.brand %>
                            <a href="/shop?<%= noBrand.toString() %>" class="ml-2 hover:text-white text-sm">&times;</a>
                        </span>
                    <% } %>

                    <% if (query.price) {
                        const priceLabel = { '0-5000':'Under ₹5K', '5000-10000':'₹5K–₹10K', '10000-':'Above ₹10K' }[query.price] || query.price;
                        const noPrice = new URLSearchParams(Object.assign({}, query, { page: 1 }));
                        noPrice.delete('price');
                    %>
                        <span class="text-[10px] bg-green-400/10 text-green-400 border border-green-400/20 px-3 py-1 rounded-full flex items-center uppercase font-bold tracking-wider">
                            <%= priceLabel %>
                            <a href="/shop?<%= noPrice.toString() %>" class="ml-2 hover:text-white text-sm">&times;</a>
                        </span>
                    <% } %>

                    <% if (query.search) {
                        const noSearch = new URLSearchParams(Object.assign({}, query, { page: 1 }));
                        noSearch.delete('search');
                    %>
                        <span class="text-[10px] bg-slate-400/10 text-slate-400 border border-slate-400/20 px-3 py-1 rounded-full flex items-center font-bold tracking-wider">
                            "<%= query.search %>"
                            <a href="/shop?<%= noSearch.toString() %>" class="ml-2 hover:text-white text-sm">&times;</a>
                        </span>
                    <% } %>
                </div>
            </div>

            <!-- Product grid -->
            <% if (products.length === 0) { %>
                <div class="text-center py-32 border border-dashed border-slate-800 rounded-3xl">
                    <p class="text-slate-500 italic">No timepieces match your criteria.</p>
                    <a href="/shop" class="text-cyan-400 text-sm mt-4 inline-block hover:underline">View All Collection</a>
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                    <% products.forEach((product, i) => { %>
                        <%
                            const v        = product.variant;
                            const salePrice = v ? (v.basePrice    ?? 0) : 0;
                            const regPrice  = v ? (v.regularPrice ?? salePrice) : 0;
                            const discPct   = (regPrice > salePrice && regPrice > 0)
                                                ? Math.round((regPrice - salePrice) / regPrice * 100)
                                                : 0;
                            const stock     = v ? (v.stock ?? 0) : 0;
                            const isOOS     = stock === 0;
                            const isLowStock = !isOOS && stock <= 5;
                        %>
                        <article class="product-card bg-[#0f1526] border rounded-2xl overflow-hidden <%= isOOS ? 'border-slate-700/50 opacity-75' : 'border-[#1e2640] card-hover' %>"
                                 style="--delay: <%= i * 0.05 %>s">

                            <div class="relative aspect-square bg-[#161d30] overflow-hidden group">
                                <% if (product.variant && product.variant.displayImage) { %>
                                    <img src="<%= product.variant.displayImage %>"
                                         alt="<%= product.name %>"
                                         class="w-full h-full object-cover transition-transform duration-500 <%= isOOS ? 'grayscale opacity-50' : 'group-hover:scale-110' %>"
                                         onerror="this.onerror=null;this.src='data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAwIiBoZWlnaHQ9IjQwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwJSIgaGVpZ2h0PSIxMDAlIiBmaWxsPSIjMTYxZDMwIi8+PHRleHQgeD0iNTAlIiB5PSI1MCUiIGZpbGw9IiM2NDc0OGIiIGZvbnQtc2l6ZT0iMTQiIHRleHQtYW5jaG9yPSJtaWRkbGUiPk5FTy1MVVhFPC90ZXh0Pjwvc3ZnPg==';" />
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center bg-[#161d30]">
                                        <span class="text-[10px] text-slate-600 uppercase tracking-widest italic">No Image</span>
                                    </div>
                                <% } %>

                                <!-- Out-of-stock overlay -->
                                <% if (isOOS) { %>
                                    <div class="absolute inset-0 flex items-center justify-center bg-black/40">
                                        <span class="bg-red-600/90 text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider shadow-lg">
                                            Out of Stock
                                        </span>
                                    </div>
                                <% } %>

                                <!-- Top-left badges -->
                                <div class="absolute top-3 left-3 flex flex-col gap-1.5">
                                    <% if (!isOOS && (new Date() - new Date(product.createdAt)) < 7*24*60*60*1000) { %>
                                        <span class="bg-cyan-400 text-[#0a0e1a] text-[9px] font-black px-2 py-0.5 rounded uppercase tracking-tighter shadow-lg shadow-cyan-400/20">New</span>
                                    <% } %>
                                    <% if (isLowStock) { %>
                                        <span class="bg-amber-500/90 text-white text-[9px] font-black px-2 py-0.5 rounded uppercase tracking-tighter">Only <%= stock %> left</span>
                                    <% } %>
                                </div>

                                <!-- Top-right: discount badge (only when in stock) -->
                                <% if (!isOOS && discPct > 0) { %>
                                    <div class="absolute top-3 right-3 bg-red-500 text-white text-[11px] font-black px-2.5 py-1 rounded-lg shadow-lg shadow-red-500/30 leading-none">
                                        −<%= discPct %>%
                                    </div>
                                <% } %>
                            </div>

                            <div class="p-6">
                                <h3 class="<%= isOOS ? 'text-slate-500' : 'text-white' %> text-base font-bold truncate mb-1"><%= product.name %></h3>
                                <p class="text-slate-500 text-[12px] mb-3 uppercase tracking-[0.15em] font-medium">
                                    <%= product.category ? product.category.name : 'Uncategorized' %>
                                </p>

                                <div class="flex items-center justify-between mb-6">
                                    <div class="flex flex-col gap-0.5">
                                        <span class="<%= isOOS ? 'text-slate-500' : 'text-white' %> font-bold text-xl tracking-tight">
                                            ₹<%= salePrice.toLocaleString('en-IN') %>
                                        </span>
                                        <% if (!isOOS && regPrice > salePrice) { %>
                                            <span class="text-slate-500 text-xs line-through">
                                                ₹<%= regPrice.toLocaleString('en-IN') %>
                                            </span>
                                        <% } %>
                                    </div>

                                    <!-- Cart button — disabled when OOS -->
                                    <% if (isOOS) { %>
                                        <button disabled
                                                title="Out of stock"
                                                class="w-11 h-11 bg-[#161d30] border border-slate-700/50 rounded-xl flex items-center justify-center text-slate-600 cursor-not-allowed">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                                            </svg>
                                        </button>
                                    <% } else { %>
                                        <button type="button"
                                                id="cartBtn-<%= product.variant._id %>"
                                                onclick="addToCart(this, '<%= product._id %>', '<%= product.variant._id %>')"
                                                title="Add to cart"
                                                class="w-11 h-11 bg-[#1e2640] border border-[#252e47] rounded-xl flex items-center justify-center text-slate-400 hover:text-cyan-400 hover:border-cyan-400 hover:bg-cyan-400/5 transition-all">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                                            </svg>
                                        </button>
                                    <% } %>
                                </div>

                                <a href="/shop/<%= product._id %>"
                                   class="block text-center text-[11px] font-bold border py-3.5 rounded-xl transition-all uppercase tracking-widest
                                          <%= isOOS
                                              ? 'text-slate-400 border-[#1e2640] hover:border-red-400/50 hover:text-red-400'
                                              : 'text-slate-400 border-[#1e2640] hover:border-cyan-400 hover:text-cyan-400 hover:bg-cyan-400/5' %>">
                                    <%= isOOS ? 'View Details' : 'Discover Timepiece' %>
                                </a>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <nav class="flex items-center justify-center gap-2 mt-16">
                    <% const baseQ = Object.assign({}, query); delete baseQ.page; %>

                    <% if (currentPage > 1) { %>
                        <a href="/shop?<%= new URLSearchParams({...baseQ, page: currentPage - 1}).toString() %>"
                           class="w-10 h-10 bg-[#0f1526] border border-[#1e2640] rounded-xl flex items-center justify-center text-slate-400 hover:border-cyan-400 hover:text-cyan-400 transition">
                            &larr;
                        </a>
                    <% } %>

                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <a href="/shop?<%= new URLSearchParams({...baseQ, page: i}).toString() %>"
                           class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-bold transition
                           <%= currentPage == i ? 'bg-cyan-400 text-[#0a0e1a]' : 'bg-[#0f1526] border border-[#1e2640] text-slate-400 hover:border-cyan-400' %>">
                            <%= i %>
                        </a>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="/shop?<%= new URLSearchParams({...baseQ, page: currentPage + 1}).toString() %>"
                           class="w-10 h-10 bg-[#0f1526] border border-[#1e2640] rounded-xl flex items-center justify-center text-slate-400 hover:border-cyan-400 hover:text-cyan-400 transition">
                            &rarr;
                        </a>
                    <% } %>
                </nav>
            <% } %>

        </div><!-- end main content -->
    </main>
</div>

<script>
  // ── Sidebar toggle ────────────────────────────────────────────────────────
  const sidebar    = document.getElementById('sidebar-panel');
  const toggleText = document.getElementById('toggle-text');
  const toggleIcon = document.getElementById('toggle-icon');

  // Restore saved preference (default: open)
  let sidebarOpen = localStorage.getItem('shopSidebarOpen') !== 'false';

  function applySidebarState() {
    if (!sidebar) return;
    if (sidebarOpen) {
      sidebar.classList.remove('collapsed');
      if (toggleText) toggleText.textContent = 'Hide Filters';
      if (toggleIcon) toggleIcon.style.transform = '';
    } else {
      sidebar.classList.add('collapsed');
      if (toggleText) toggleText.textContent = 'Show Filters';
      if (toggleIcon) toggleIcon.style.transform = 'rotate(90deg)';
    }
  }

  function toggleSidebar() {
    sidebarOpen = !sidebarOpen;
    localStorage.setItem('shopSidebarOpen', sidebarOpen);
    applySidebarState();
  }

  // Apply on page load (no animation flash)
  applySidebarState();
</script>
</body>
</html>
