<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmed | Neo-Luxe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    body { font-family: "Inter", sans-serif; }
    @keyframes pop {
      0%   { transform: scale(0.4); opacity: 0; }
      70%  { transform: scale(1.12); }
      100% { transform: scale(1);   opacity: 1; }
    }
    .pop { animation: pop .6s cubic-bezier(.34,1.56,.64,1) both; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up  { animation: fadeUp .5s ease both; }
    .delay-1  { animation-delay: .15s; }
    .delay-2  { animation-delay: .3s; }
    .delay-3  { animation-delay: .45s; }
  </style>
</head>
<body class="bg-[#05080d] text-white min-h-screen flex flex-col">

  <%- include('../partials/user-header') %>

  <main class="max-w-5xl mx-auto w-full px-5 sm:px-8 pt-10 pb-28 flex-grow">

    <!-- ── Progress Steps ──────────────────────────────────────────── -->
    <div class="flex items-center justify-center gap-3 mb-12 text-xs font-semibold select-none">
      <div class="flex items-center gap-2 text-slate-600">
        <div class="w-7 h-7 rounded-full bg-[#0a0f18] border border-slate-800 flex items-center justify-center">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        Cart
      </div>
      <div class="flex-1 max-w-[60px] h-px bg-slate-800"></div>
      <div class="flex items-center gap-2 text-slate-600">
        <div class="w-7 h-7 rounded-full bg-[#0a0f18] border border-slate-800 flex items-center justify-center">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        Checkout
      </div>
      <div class="flex-1 max-w-[60px] h-px bg-cyan-500/50"></div>
      <div class="flex items-center gap-2 text-cyan-400">
        <div class="w-7 h-7 rounded-full bg-cyan-400/15 border border-cyan-400/40 flex items-center justify-center shadow-[0_0_12px_rgba(0,212,255,0.25)]">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        Confirmation
      </div>
    </div>

    <!-- ── Hero Success Card ────────────────────────────────────────── -->
    <div class="bg-[#0a0f18] border border-gray-800/60 rounded-3xl px-8 py-14 text-center mb-8 fade-up relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(0,212,255,0.07),transparent_65%)] pointer-events-none"></div>

      <!-- Animated check -->
      <div class="pop relative w-24 h-24 mx-auto mb-8">
        <div class="absolute inset-0 rounded-full bg-cyan-400/10 border-2 border-cyan-400/25 shadow-[0_0_50px_rgba(0,212,255,0.18)]"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <svg class="w-11 h-11 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
      </div>

      <h1 class="text-4xl font-bold text-white mb-3 tracking-tight">Order Confirmed!</h1>
      <p class="text-slate-400 text-sm max-w-md mx-auto leading-relaxed">
        Thank you for your purchase. Your luxury timepiece is being prepared for shipment.
      </p>

      <!-- Order ID pill -->
      <div class="inline-flex items-center gap-3 mt-6 px-6 py-2.5 rounded-full border border-gray-800 bg-[#060b14]">
        <span class="text-slate-500 text-[10px] uppercase tracking-widest font-bold">Order ID</span>
        <span class="w-px h-3 bg-gray-700"></span>
        <span class="text-cyan-400 font-mono font-bold text-sm tracking-wide">
          #<%= order.orderId || order._id.toString().slice(-8).toUpperCase() %>
        </span>
      </div>

      <p class="text-slate-600 text-xs mt-4">
        A confirmation has been sent to your registered email.
      </p>
    </div>

    <!-- ── Two-column layout ────────────────────────────────────────── -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Left: Items + Order Info -->
      <div class="lg:col-span-7 space-y-6">

        <!-- Ordered Items -->
        <div class="bg-[#0a0f18] border border-gray-800/60 rounded-2xl p-6 fade-up delay-1">
          <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-5">
            Ordered Items
            <span class="ml-2 text-slate-600 font-normal normal-case tracking-normal">
              (<%= order.items.length %> item<%= order.items.length !== 1 ? 's' : '' %>)
            </span>
          </h2>
          <div class="space-y-5">
            <% order.items.forEach(item => { %>
              <div class="flex gap-4 items-center">
                <!-- Image -->
                <div class="w-16 h-16 bg-[#111827] rounded-xl overflow-hidden border border-gray-800/80 flex-shrink-0">
                  <% if (item.imageUrl) { %>
                    <img src="<%= item.imageUrl %>" alt="<%= item.productName %>" class="w-full h-full object-cover"/>
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
                      </svg>
                    </div>
                  <% } %>
                </div>
                <!-- Details -->
                <div class="flex-1 min-w-0">
                  <p class="text-white text-sm font-semibold leading-snug truncate"><%= item.productName %></p>
                  <% if (item.variantColor) { %>
                    <p class="text-slate-500 text-xs mt-1">Color: <span class="text-slate-400 capitalize"><%= item.variantColor %></span></p>
                  <% } %>
                  <p class="text-slate-600 text-xs mt-0.5">Qty: <span class="text-slate-400"><%= item.quantity %></span></p>
                </div>
                <!-- Price -->
                <p class="text-cyan-400 font-bold text-sm flex-shrink-0">
                  ₹<%= item.itemTotal.toLocaleString('en-IN') %>
                </p>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Order Information -->
        <div class="bg-[#0a0f18] border border-gray-800/60 rounded-2xl p-6 fade-up delay-2">
          <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-6">Order Information</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">

            <!-- Delivery Address -->
            <div>
              <p class="text-[10px] text-slate-500 uppercase tracking-widest font-bold mb-3">Delivery Address</p>
              <p class="text-white text-sm font-semibold mb-1"><%= order.shippingAddress.fullName %></p>
              <p class="text-slate-400 text-xs leading-relaxed">
                <%= order.shippingAddress.addressLine1 %><% if (order.shippingAddress.addressLine2) { %>, <%= order.shippingAddress.addressLine2 %><% } %>,<br/>
                <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> — <%= order.shippingAddress.pincode %>
              </p>
              <p class="text-slate-500 text-xs mt-2 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <%= order.shippingAddress.phone %>
              </p>
            </div>

            <!-- Payment + Delivery -->
            <div class="space-y-5">
              <div>
                <p class="text-[10px] text-slate-500 uppercase tracking-widest font-bold mb-2">Payment Method</p>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                  </svg>
                  <p class="text-white text-sm font-medium">
                    <%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Online Payment' %>
                  </p>
                </div>
              </div>
              <div>
                <p class="text-[10px] text-slate-500 uppercase tracking-widest font-bold mb-2">Estimated Delivery</p>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
                  </svg>
                  <p class="text-white text-sm font-medium">
                    <%
                      const d = new Date(order.createdAt);
                      const s = new Date(d); s.setDate(s.getDate() + 3);
                      const e = new Date(d); e.setDate(e.getDate() + 5);
                      const fmt = x => x.toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
                    %>
                    <%= fmt(s) %> – <%= fmt(e) %>
                  </p>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Right: Payment Summary + Actions -->
      <div class="lg:col-span-5 fade-up delay-3">
        <div class="bg-[#0a0f18] border border-gray-800/60 rounded-2xl p-6 lg:sticky lg:top-6">
          <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-6">Payment Summary</h2>

          <div class="space-y-3.5 text-sm mb-6">
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Subtotal</span>
              <span class="text-white font-medium">₹<%= order.subtotal.toLocaleString('en-IN') %></span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Shipping</span>
              <span class="<%= order.shipping === 0 ? 'text-cyan-400 font-semibold' : 'text-white font-medium' %>">
                <%= order.shipping === 0 ? 'Free' : '₹' + order.shipping.toLocaleString('en-IN') %>
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Tax (18% GST)</span>
              <span class="text-white font-medium">₹<%= order.tax.toLocaleString('en-IN') %></span>
            </div>
            <% if (order.discount && order.discount > 0) { %>
              <div class="flex justify-between items-center">
                <span class="text-emerald-400">Discount</span>
                <span class="text-emerald-400 font-semibold">−₹<%= order.discount.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
          </div>

          <div class="border-t border-gray-800 pt-5 flex justify-between items-center mb-7">
            <div>
              <p class="text-white font-bold text-sm">Total Paid</p>
              <p class="text-slate-600 text-[10px] mt-0.5">Incl. all taxes</p>
            </div>
            <span class="text-cyan-400 font-bold text-2xl">₹<%= order.total.toLocaleString('en-IN') %></span>
          </div>

          <!-- CTA Buttons -->
          <div class="space-y-3">
            <a href="/orders/<%= order._id %>/details"
               class="w-full flex items-center justify-center gap-2 bg-cyan-400 hover:bg-cyan-300 active:bg-cyan-500 text-[#05080d] font-bold text-sm px-5 py-3.5 rounded-xl transition-all shadow-[0_4px_24px_rgba(0,212,255,0.18)]">
              Track Order
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="/shop"
               class="w-full flex items-center justify-center gap-2 bg-transparent border border-gray-700 hover:border-gray-600 hover:bg-white/5 text-slate-300 hover:text-white font-semibold text-sm px-5 py-3.5 rounded-xl transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
              Continue Shopping
            </a>
          </div>

          <p class="text-center text-slate-600 text-[11px] mt-5 leading-relaxed">
            Need help?
            <a href="#" class="text-cyan-400 hover:underline ml-0.5">Contact Support</a>
          </p>
        </div>
      </div>

    </div>
  </main>

  <footer class="py-8 border-t border-white/5 text-center">
    <p class="text-slate-700 text-xs">&copy; 2026 Luxe Time Inc. All rights reserved.</p>
    <div class="flex justify-center gap-6 mt-2 text-[10px] text-slate-700 uppercase tracking-widest">
      <a href="#" class="hover:text-slate-500 transition">Privacy Policy</a>
      <a href="#" class="hover:text-slate-500 transition">Terms of Service</a>
    </div>
  </footer>

</body>
</html>
