<style>
  body { background: #05080d; }

  /* Progress bar */
  .step-line { height: 2px; flex: 1; background: #1f2937; }
  .step-line.done { background: #00d4ff; }

  /* Address cards */
  .addr-card {
    border: 1.5px solid #1f2937;
    border-radius: 14px;
    padding: 14px 16px;
    cursor: pointer;
    transition: all .15s ease;
    background: #080d16;
  }
  .addr-card:hover  { border-color: rgba(0,212,255,0.35); background: #0a1220; }
  .addr-card.selected { border-color: #00d4ff; background: #071525; }
  .addr-card input[type="radio"] { accent-color: #00d4ff; }

  /* Scrollbar for items list */
  .items-scroll::-webkit-scrollbar { width: 4px; }
  .items-scroll::-webkit-scrollbar-track { background: transparent; }
  .items-scroll::-webkit-scrollbar-thumb { background: #1e2640; border-radius: 4px; }
</style>

<div class="min-h-screen bg-[#05080d]">
<div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 pb-24">

  <!-- ── Progress Steps ──────────────────────────────────────────────── -->
  <div class="flex items-center justify-center gap-3 mb-10 text-xs font-semibold select-none">
    <div class="flex items-center gap-2 text-slate-500">
      <div class="w-7 h-7 rounded-full bg-[#0a0f18] border border-slate-700 flex items-center justify-center">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <span>Cart</span>
    </div>
    <div class="step-line done w-16 sm:w-24"></div>
    <div class="flex items-center gap-2 text-cyan-400">
      <div class="w-7 h-7 rounded-full bg-cyan-400/15 border border-cyan-400/50 flex items-center justify-center shadow-[0_0_12px_rgba(0,212,255,0.25)]">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        </svg>
      </div>
      <span>Checkout</span>
    </div>
    <div class="step-line w-16 sm:w-24"></div>
    <div class="flex items-center gap-2 text-slate-600">
      <div class="w-7 h-7 rounded-full bg-[#0a0f18] border border-slate-800 flex items-center justify-center">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <span>Confirmation</span>
    </div>
  </div>

  <!-- ── Alerts ──────────────────────────────────────────────────────── -->
  <% if (typeof blockedItems !== 'undefined' && blockedItems.length) { %>
    <div class="bg-red-500/10 border border-red-500/30 rounded-2xl px-5 py-4 mb-6 space-y-1.5">
      <p class="text-red-400 text-xs font-bold uppercase tracking-widest mb-2">Items Removed</p>
      <% blockedItems.forEach(reason => { %>
        <p class="text-red-300 text-sm flex items-start gap-2">
          <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <%= reason %>
        </p>
      <% }) %>
    </div>
  <% } %>

  <% if (typeof stockErrors !== 'undefined' && stockErrors.length) { %>
    <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl px-5 py-4 mb-6 space-y-1.5">
      <p class="text-amber-400 text-xs font-bold uppercase tracking-widest mb-2">Quantities Adjusted</p>
      <% stockErrors.forEach(e => { %>
        <p class="text-amber-300 text-sm flex items-start gap-2">
          <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <strong class="text-white"><%= e.name %></strong>: adjusted to <%= e.available %> (only <%= e.available %> in stock)
        </p>
      <% }) %>
    </div>
  <% } %>

  <!-- ── Main Grid ───────────────────────────────────────────────────── -->
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 items-start">

    <!-- ── LEFT: Address + Payment (3 cols) ───────────────────────── -->
    <div class="lg:col-span-3 space-y-5">

      <!-- Delivery Address -->
      <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-6">

        <div class="flex items-center justify-between mb-5">
          <h2 class="text-white font-bold text-sm flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Delivery Address
          </h2>
          <a href="/addresses" class="text-[10px] text-cyan-400 hover:text-cyan-300 font-semibold uppercase tracking-wider transition flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add New
          </a>
        </div>

        <% if (!addresses || addresses.length === 0) { %>
          <div class="text-center py-10 border border-dashed border-gray-800 rounded-xl">
            <svg class="w-10 h-10 text-slate-700 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            </svg>
            <p class="text-slate-400 text-sm mb-4">No saved addresses yet.</p>
            <a href="/addresses" class="inline-block bg-cyan-400 text-[#05080d] font-bold text-xs px-5 py-2.5 rounded-xl hover:bg-cyan-300 transition">
              Add an Address
            </a>
          </div>
        <% } else { %>
          <div class="space-y-2.5" id="addressList">
            <% addresses.forEach((addr, i) => {
                 const isDefault = addr.isDefault;
                 const isSelected = isDefault || (i === 0 && !addresses.some(a => a.isDefault));
            %>
              <label class="addr-card flex items-start gap-3 <%= isSelected ? 'selected' : '' %>"
                     id="addrCard-<%= addr._id %>"
                     onclick="selectAddress('<%= addr._id %>')">
                <!-- Radio -->
                <div class="mt-0.5 flex-shrink-0">
                  <input type="radio" name="addressId" value="<%= addr._id %>"
                         id="addr-<%= addr._id %>" <%= isSelected ? 'checked' : '' %>
                         class="w-4 h-4"/>
                </div>
                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-1.5 mb-1">
                    <span class="text-white font-semibold text-sm"><%= addr.fullName %></span>
                    <span class="text-[9px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full border border-slate-700 uppercase tracking-wider">
                      <%= addr.addressType %>
                    </span>
                    <% if (addr.isDefault) { %>
                      <span class="text-[9px] bg-cyan-400/10 text-cyan-400 px-2 py-0.5 rounded-full border border-cyan-400/25 uppercase tracking-wider">Default</span>
                    <% } %>
                  </div>
                  <p class="text-slate-400 text-xs leading-relaxed">
                    <%= addr.streetAddress %>, <%= addr.city %>, <%= addr.state %> — <%= addr.pincode %>
                  </p>
                  <p class="text-slate-500 text-[11px] mt-1 flex items-center gap-1">
                    <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    <%= addr.phone %>
                  </p>
                </div>
              </label>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Payment Method -->
      <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-6">
        <h2 class="text-white font-bold text-sm mb-4 flex items-center gap-2">
          <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
          </svg>
          Payment Method
        </h2>

        <div class="space-y-2.5">
          <!-- Online Payment (default) -->
          <label class="addr-card selected flex items-center gap-3" id="pmCard-razorpay" onclick="selectPayment('razorpay')">
            <input type="radio" name="paymentMethod" value="razorpay" id="pm-razorpay" checked class="w-4 h-4 flex-shrink-0"/>
            <div class="w-9 h-9 bg-blue-500/10 border border-blue-500/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm">Online Payment</p>
              <p class="text-slate-500 text-xs">UPI · Cards · Net Banking</p>
            </div>
          </label>

          <!-- Wallet -->
          <%
            const walletSufficient = walletBalance >= totals.total;
          %>
          <label class="addr-card flex items-center gap-3 <%= !walletSufficient ? 'opacity-50 cursor-not-allowed' : '' %>"
                 id="pmCard-wallet"
                 onclick="<%= walletSufficient ? 'selectPayment(\'wallet\')' : 'showInsufficientWallet()' %>">
            <input type="radio" name="paymentMethod" value="wallet" id="pm-wallet"
                   class="w-4 h-4 flex-shrink-0" <%= !walletSufficient ? 'disabled' : '' %>/>
            <div class="w-9 h-9 bg-green-500/10 border border-green-500/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-white font-semibold text-sm">Wallet</p>
              <p class="text-slate-500 text-xs">
                Balance: <span class="<%= walletSufficient ? 'text-green-400' : 'text-red-400' %> font-semibold">
                  ₹<%= walletBalance.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </span>
                <% if (!walletSufficient) { %>
                  <span class="text-red-400 ml-1">— Insufficient</span>
                <% } %>
              </p>
            </div>
          </label>

          <!-- COD -->
          <label class="addr-card flex items-center gap-3" id="pmCard-cod" onclick="selectPayment('cod')">
            <input type="radio" name="paymentMethod" value="cod" id="pm-cod" class="w-4 h-4 flex-shrink-0"/>
            <div class="w-9 h-9 bg-slate-800 border border-slate-700 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm">Cash on Delivery</p>
              <p class="text-slate-500 text-xs">Pay when your order arrives</p>
            </div>
          </label>
        </div>
      </div>

    </div>

    <!-- ── RIGHT: Order Summary (2 cols) ──────────────────────────── -->
    <div class="lg:col-span-2">
      <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-5 sticky top-6">

        <h2 class="text-white font-bold text-sm mb-4 flex items-center gap-2">
          <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          Order Summary
        </h2>

        <!-- Items list -->
        <div class="space-y-3 mb-4 max-h-52 overflow-y-auto items-scroll pr-0.5">
          <% checkoutItems.forEach(item => {
               const discPct = (item.regularPrice > item.basePrice && item.regularPrice > 0)
                 ? Math.round((item.regularPrice - item.basePrice) / item.regularPrice * 100) : 0;
          %>
            <div class="flex gap-3 items-start">
              <!-- Thumbnail -->
              <div class="w-12 h-12 bg-[#111827] rounded-lg overflow-hidden border border-gray-800/80 flex-shrink-0 relative">
                <% if (item.imageUrl) { %>
                  <img src="<%= item.imageUrl %>" alt="<%= item.productName %>" class="w-full h-full object-cover"/>
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-slate-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="1.5"/></svg>
                  </div>
                <% } %>
                <% if (discPct > 0) { %>
                  <span class="absolute -top-0.5 -right-0.5 bg-red-500 text-white text-[7px] font-black px-1 rounded leading-tight">-<%= discPct %>%</span>
                <% } %>
              </div>
              <!-- Info -->
              <div class="flex-1 min-w-0">
                <p class="text-white text-xs font-semibold truncate leading-snug"><%= item.productName %></p>
                <p class="text-slate-500 text-[10px] mt-0.5"><%= item.color %> · Qty <%= item.quantity %></p>
                <% if (discPct > 0) { %>
                  <p class="text-[10px] mt-0.5 text-green-400 font-medium">
                    Save ₹<%= ((item.regularPrice - item.basePrice) * item.quantity).toLocaleString('en-IN') %>
                  </p>
                <% } %>
              </div>
              <!-- Price -->
              <p class="text-white text-xs font-bold flex-shrink-0 mt-0.5">
                ₹<%= item.itemTotal.toLocaleString('en-IN') %>
              </p>
            </div>
          <% }) %>
        </div>

        <!-- Coupon Section -->
        <div class="border-t border-gray-800/60 pt-4 mb-4">
          <h3 class="text-white font-bold text-xs mb-3 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
            Apply Coupon
          </h3>

          <!-- Applied coupon display -->
          <div id="appliedCouponBox" class="hidden mb-3 p-2.5 bg-green-500/10 border border-green-500/20 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <div>
                <p class="text-green-400 text-[11px] font-bold" id="appliedCouponCode"></p>
                <p class="text-green-300 text-[10px]" id="appliedCouponSaving"></p>
              </div>
            </div>
            <button onclick="removeCouponAction()" class="text-red-400 hover:text-red-300 text-[10px] font-bold border border-red-400/30 hover:bg-red-400/10 px-2.5 py-1 rounded-lg transition">
              Remove
            </button>
          </div>

          <!-- Coupon input -->
          <div id="couponInputBox" class="flex gap-2 mb-3">
            <input type="text" id="couponCodeInput" placeholder="Enter code"
                   class="flex-1 bg-[#111827] border border-gray-700 rounded-lg py-2 px-3 text-white text-xs uppercase focus:outline-none focus:border-cyan-400/50 transition"/>
            <button onclick="applyCouponAction()" id="applyCouponBtn"
                    class="bg-cyan-400 hover:bg-cyan-300 text-[#05080d] font-bold text-[10px] px-4 rounded-lg transition flex-shrink-0">
              Apply
            </button>
          </div>
          <p id="couponError" class="text-red-400 text-[10px] hidden mb-2"></p>

          <!-- Available coupons toggle -->
          <button onclick="toggleAvailableCoupons()" class="text-cyan-400 text-[11px] font-semibold hover:text-cyan-300 transition flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
            View Available Coupons (<%= typeof coupons !== 'undefined' ? coupons.length : 0 %>)
          </button>

          <!-- Available coupons list -->
          <div id="availableCouponsList" class="hidden mt-2 space-y-2 max-h-48 overflow-y-auto pr-0.5">
            <% if (typeof coupons !== 'undefined' && coupons.length > 0) { %>
              <% coupons.forEach(c => { %>
                <div class="p-2.5 bg-[#060c18] border border-gray-800/60 rounded-xl hover:border-cyan-400/20 transition cursor-pointer"
                     onclick="selectCoupon('<%= c.code %>')">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-mono text-cyan-400 text-[10px] font-bold bg-cyan-400/10 px-1.5 py-0.5 rounded border border-cyan-400/20"><%= c.code %></span>
                    <span class="text-white font-bold text-xs"><%= c.discount %>% OFF</span>
                  </div>
                  <p class="text-white text-[11px] font-semibold mb-1"><%= c.title %></p>
                  <div class="flex flex-wrap gap-x-3 gap-y-0.5 text-[9px] text-slate-500">
                    <span>Min: ₹<%= c.minSpend.toLocaleString('en-IN') %></span>
                    <span>Max: ₹<%= c.maxCap.toLocaleString('en-IN') %></span>
                    <span>Left: <%= c.usageLimit - c.usedCount %></span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-slate-600 text-[10px] text-center py-3">No coupons available.</p>
            <% } %>
          </div>
        </div>

        <!-- Divider -->
        <div class="border-t border-gray-800/60 pt-4 space-y-2 mb-4">
          <div class="flex justify-between text-xs">
            <span class="text-slate-400">Subtotal</span>
            <span class="text-white font-medium">₹<%= totals.subtotal.toLocaleString('en-IN') %></span>
          </div>
          <%
            const totalRegular = checkoutItems.reduce((s, i) => s + i.regularPrice * i.quantity, 0);
            const totalSaving  = totalRegular - totals.subtotal;
          %>
          <% if (totalSaving > 0) { %>
            <div class="flex justify-between text-xs">
              <span class="text-green-400">Discount</span>
              <span class="text-green-400 font-semibold">−₹<%= totalSaving.toLocaleString('en-IN') %></span>
            </div>
          <% } %>
          <div class="flex justify-between text-xs">
            <span class="text-slate-400">Shipping</span>
            <span class="<%= totals.shipping === 0 ? 'text-cyan-400 font-semibold' : 'text-white font-medium' %>">
              <%= totals.shipping === 0 ? 'Free' : '₹' + totals.shipping %>
            </span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-slate-400">Tax (18% GST)</span>
            <span class="text-white font-medium">₹<%= totals.tax.toLocaleString('en-IN') %></span>
          </div>
          <!-- Coupon discount line (updated dynamically) -->
          <div id="couponDiscountLine" class="flex justify-between text-xs hidden">
            <span class="text-green-400">Coupon Discount</span>
            <span class="text-green-400 font-semibold" id="couponDiscountAmount">−₹0</span>
          </div>
        </div>

        <!-- Total -->
        <div class="border-t border-gray-800/60 pt-3 flex items-center justify-between mb-5">
          <div>
            <p class="text-white font-bold text-sm">Total</p>
            <p class="text-slate-500 text-[10px]">Incl. all taxes</p>
          </div>
          <p class="text-cyan-400 font-bold text-xl" data-checkout-total>₹<%= totals.total.toLocaleString('en-IN') %></p>
        </div>

        <!-- Place Order button -->
        <button id="placeOrderBtn"
                onclick="placeOrder()"
                class="w-full py-3 rounded-xl flex items-center justify-center gap-2 font-bold text-sm transition-all duration-200
                       <%= (!addresses || addresses.length === 0)
                           ? 'bg-slate-800 text-slate-500 border border-gray-800 hover:border-cyan-400/30 hover:text-slate-400 cursor-pointer'
                           : 'bg-cyan-400 text-[#05080d] hover:bg-cyan-300 shadow-[0_4px_20px_rgba(0,212,255,0.15)]' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          Place Order
        </button>

        <!-- Trust badges -->
        <div class="mt-4 flex items-center justify-center gap-3 text-slate-600 text-[10px]">
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
            </svg>
            Secure SSL
          </span>
          <span class="w-px h-3 bg-gray-800"></span>
          <span>2-Year Warranty</span>
        </div>

      </div>
    </div>

  </div>
</div>
<!-- ── Coupon Modal ──────────────────────────────────────────────── -->
<div id="couponModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="toggleCouponModal()"></div>
  <div class="bg-[#0a0f18] border border-gray-800 w-full max-w-sm rounded-2xl p-6 relative z-10 shadow-2xl">
    <h3 class="text-white font-bold text-lg mb-4">Available Coupons</h3>
    <div class="space-y-3 max-h-64 overflow-y-auto pr-2 items-scroll">
      
      <!-- Logic Fix: Just check for 'coupons' directly -->
      <% if (locals.coupons && coupons.length > 0) { %>
        <% coupons.forEach(coupon => { %>
          <div class="p-4 border border-gray-800 rounded-xl bg-[#05080d] hover:border-cyan-400/50 transition-all cursor-pointer group"
               onclick="selectCoupon('<%= coupon.code %>')">
            <div class="flex justify-between items-start mb-1">
              <span class="text-cyan-400 font-bold text-sm uppercase"><%= coupon.code %></span>
              <!-- Database uses 'discount', not 'discountAmount' -->
              <span class="text-green-400 text-[10px] font-bold uppercase">Save <%= coupon.discount %>%</span>
            </div>
            <p class="text-slate-400 text-xs line-clamp-1"><%= coupon.title || 'Special Discount' %></p>
            <!-- Database uses 'minSpend', not 'minPurchase' -->
            <p class="text-slate-600 text-[9px] mt-2 italic">Min. Purchase: ₹<%= coupon.minSpend %></p>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-8">
           <p class="text-slate-500 text-sm">No coupons available right now.</p>
           <p class="text-slate-600 text-[10px] mt-1">Check back later for new offers!</p>
        </div>
      <% } %>

    </div>
    <button onclick="toggleCouponModal()" class="w-full mt-5 py-3 text-slate-400 font-bold text-xs uppercase tracking-widest hover:text-white transition">Close</button>
  </div>
</div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const RAZORPAY_KEY_ID = '<%= razorpayKeyId %>';

  let selectedAddressId = '<%= addresses && addresses.length ? (addresses.find(a => a.isDefault) || addresses[0])._id : "" %>';
  let selectedPayment   = 'razorpay'; // default to online payment

  function selectAddress(id) {
    selectedAddressId = id;
    document.querySelectorAll('.addr-card[id^="addrCard-"]').forEach(c => c.classList.remove('selected'));
    const card = document.getElementById('addrCard-' + id);
    if (card) card.classList.add('selected');
    document.getElementById('addr-' + id).checked = true;
  }

  function selectPayment(method) {
    selectedPayment = method;
    ['cod', 'razorpay', 'wallet'].forEach(m => {
      const card  = document.getElementById('pmCard-' + m);
      const radio = document.getElementById('pm-' + m);
      if (card)  card.classList.toggle('selected', m === method);
      if (radio) radio.checked = (m === method);
    });
  }

  function showInsufficientWallet() {
    Swal.fire({
      title: 'Insufficient Wallet Balance',
      text: 'Your wallet balance is not enough for this order. Please use another payment method.',
      icon: 'warning',
      confirmButtonColor: '#06b6d4',
      background: '#0a0f18',
      color: '#e2e8f0',
    });
  }

  // ── Shared button helpers ─────────────────────────────────────────────────
  function setLoading(btn, text = 'Processing…') {
    btn.disabled = true;
    btn.innerHTML = `
      <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
      </svg>
      ${text}`;
  }

  function resetBtn(btn) {
    btn.disabled = false;
    btn.innerHTML = `
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
      </svg>
      Place Order`;
  }

  // ── Main place order handler ──────────────────────────────────────────────
  async function placeOrder() {
    if (!selectedAddressId) {
      const result = await Swal.fire({
        title: 'No Delivery Address',
        text: 'Please add a delivery address to place your order.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#06b6d4',
        cancelButtonColor: '#475569',
        confirmButtonText: 'Add Address',
        cancelButtonText: 'Cancel',
        background: '#0a0f18',
        color: '#e2e8f0',
      });
      if (result.isConfirmed) window.location.href = '/addresses';
      return;
    }

    const btn = document.getElementById('placeOrderBtn');

    if (selectedPayment === 'razorpay') {
      await handleRazorpayPayment(btn);
    } else {
      // COD and Wallet both go through /checkout/place-order
      await handleCodOrder(btn);
    }
  }

  // ── COD flow ──────────────────────────────────────────────────────────────
  async function handleCodOrder(btn) {
    setLoading(btn, selectedPayment === 'wallet' ? 'Processing Payment…' : 'Placing Order…');
    try {
      const res  = await fetch('/checkout/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ addressId: selectedAddressId, paymentMethod: selectedPayment }),
      });
      const data = await res.json();

      if (data.success) {
        window.location.href = data.redirect;
        return;
      }

      if (data.redirect === '/cart') {
        const r = await Swal.fire({
          title: 'Cart Updated', text: data.message, icon: 'warning',
          showCancelButton: true, confirmButtonColor: '#06b6d4', cancelButtonColor: '#475569',
          confirmButtonText: 'Go to Cart', cancelButtonText: 'Stay Here',
          background: '#0a0f18', color: '#e2e8f0',
        });
        if (r.isConfirmed) window.location.href = '/cart';
        else resetBtn(btn);
        return;
      }

      await Swal.fire({ title: 'Cannot Place Order', text: data.message || 'Something went wrong.',
        icon: 'error', confirmButtonColor: '#06b6d4', background: '#0a0f18', color: '#e2e8f0' });
      resetBtn(btn);
    } catch {
      await Swal.fire({ title: 'Connection Error', text: 'Could not reach the server.',
        icon: 'error', confirmButtonColor: '#06b6d4', background: '#0a0f18', color: '#e2e8f0' });
      resetBtn(btn);
    }
  }

  // ── Razorpay flow ─────────────────────────────────────────────────────────
  async function handleRazorpayPayment(btn) {
    setLoading(btn, 'Initialising Payment…');

    try {
      // Step 1 — validate cart + create Razorpay order (NO DB order, NO stock deduction)
      const res  = await fetch('/checkout/razorpay/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ addressId: selectedAddressId }),
      });
      const data = await res.json();

      if (!data.success) {
        await Swal.fire({ title: 'Order Error', text: data.message || 'Could not initialise payment.',
          icon: 'error', confirmButtonColor: '#06b6d4', background: '#0a0f18', color: '#e2e8f0' });
        resetBtn(btn);
        return;
      }

      // Step 2 — open Razorpay checkout modal
      let paymentFailed = false; // flag: payment.failed fired → ondismiss should not double-handle

      const options = {
        key:         RAZORPAY_KEY_ID,
        amount:      data.amount,
        currency:    data.currency,
        name:        'Neo-Luxe',
        description: 'Premium Watch Purchase',
        order_id:    data.razorpayOrderId,
        theme:       { color: '#06b6d4' },

        handler: async function (response) {
          // Step 3 — payment succeeded on Razorpay side
          // Verify signature on server → THEN create DB order + deduct stock + clear cart
          setLoading(btn, 'Verifying Payment…');
          try {
            const verifyRes = await fetch('/checkout/razorpay/verify', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                razorpay_order_id:   response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature:  response.razorpay_signature,
              }),
            });
            const verifyData = await verifyRes.json();

            if (verifyData.success) {
              // Payment verified + order created → go to confirmation
              window.location.href = verifyData.redirect;
            } else if (verifyData.outOfStock) {
              // Race condition — stock ran out, refund initiated automatically
              // Redirect to payment-failed page with proper message
              window.location.href = '/payment-failed?reason=outofstock';
            } else {
              // Any other verification failure — show message and go to cart
              await Swal.fire({
                title: 'Order Could Not Be Placed',
                html: `<p class="text-slate-300 text-sm">${verifyData.message || 'Something went wrong during verification.'}</p>
                       <p class="text-slate-500 text-xs mt-3">If payment was deducted, it will be refunded within 5–7 business days.</p>`,
                icon: 'error',
                confirmButtonText: 'Go to Cart',
                confirmButtonColor: '#06b6d4',
                background: '#0a0f18',
                color: '#e2e8f0',
              });
              window.location.href = '/cart';
            }
          } catch {
            await Swal.fire({ title: 'Verification Error', text: 'Could not verify payment. Contact support.',
              icon: 'error', confirmButtonColor: '#06b6d4', background: '#0a0f18', color: '#e2e8f0' });
            window.location.href = '/payment-failed';
          }
        },

        modal: {
          ondismiss: async function () {
            // If payment.failed already fired, it handles the redirect — do nothing here
            if (paymentFailed) return;

            // User closed the modal without attempting payment
            // No order was created, no stock was deducted — just clean up session
            await fetch('/checkout/razorpay/failed', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({}),
            });

            // Stay on checkout — let user retry or switch to COD
            resetBtn(btn);
            Swal.fire({
              toast: true, position: 'top-end', icon: 'info',
              title: 'Payment cancelled — you can try again',
              showConfirmButton: false, timer: 3000,
              background: '#0a0f18', color: '#e2e8f0',
            });
          },
        },
      };

      const rzp = new Razorpay(options);

      // ── Payment failed inside the modal (wrong card, declined, etc.) ──────
      rzp.on('payment.failed', async function (response) {
        paymentFailed = true;
        // No order was created — just clean up session and redirect
        await fetch('/checkout/razorpay/failed', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({}),
        });
        window.location.href = '/payment-failed';
      });

      btn.disabled = false; // re-enable so user can retry if they dismiss
      rzp.open();

    } catch {
      await Swal.fire({ title: 'Connection Error', text: 'Could not reach the server.',
        icon: 'error', confirmButtonColor: '#06b6d4', background: '#0a0f18', color: '#e2e8f0' });
      resetBtn(btn);
    }
  }
  // ── Coupon Logic ──────────────────────────────────────────────────
function toggleCouponModal() {
  const modal = document.getElementById('couponModal');
  modal.classList.toggle('hidden');
}

function selectCoupon(code) {
  document.getElementById('couponCode').value = code;
  toggleCouponModal();
}

async function applyCoupon() {
  const code = document.getElementById('couponCode').value.trim();
  const btn = document.getElementById('applyCouponBtn');
  const msg = document.getElementById('couponMessage');

  if (!code) return;

  setLoading(btn, '...');
  
  try {
    const res = await fetch('/checkout/apply-coupon', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ couponCode: code, subtotal: <%= totals.subtotal %> })
    });
    
    const data = await res.json();
    resetBtn(btn);
    btn.innerText = "Apply"; // Reset text back from "Place Order" icon

    if (data.success) {
      msg.className = "mt-2 text-[10px] font-medium text-green-400";
      msg.innerText = `Coupon applied! You saved ₹${data.discount}`;
      msg.classList.remove('hidden');
      
      // Update the UI totals
      document.getElementById('couponDiscountRow').classList.remove('hidden');
      document.getElementById('couponDiscountValue').innerText = `−₹${data.discount.toLocaleString('en-IN')}`;
      
      // Update the Grand Total (Recalculated on Server and returned)
      // Assuming your server returns the new total
      // document.querySelector('.text-cyan-400.text-xl').innerText = `₹${data.newTotal.toLocaleString('en-IN')}`;
      
      // Optional: Refresh page to get exact calculations from server
      // window.location.reload(); 
    } else {
      msg.className = "mt-2 text-[10px] font-medium text-red-400";
      msg.innerText = data.message;
      msg.classList.remove('hidden');
    }
  } catch (err) {
    resetBtn(btn);
    btn.innerText = "Apply";
  }
}

  // ── Coupon functions ──────────────────────────────────────────────────────
  const SUBTOTAL = <%= totals.subtotal %>;
  let appliedDiscount = 0;

  function toggleAvailableCoupons() {
    document.getElementById('availableCouponsList').classList.toggle('hidden');
  }

  function selectCoupon(code) {
    document.getElementById('couponCodeInput').value = code;
    document.getElementById('availableCouponsList').classList.add('hidden');
    applyCouponAction();
  }

  async function applyCouponAction() {
    const code    = document.getElementById('couponCodeInput').value.trim();
    const errorEl = document.getElementById('couponError');
    errorEl.classList.add('hidden');

    if (!code) {
      errorEl.textContent = 'Please enter a coupon code.';
      errorEl.classList.remove('hidden');
      return;
    }

    const btn = document.getElementById('applyCouponBtn');
    btn.disabled = true; btn.textContent = '...';

    try {
      const res  = await fetch('/checkout/apply-coupon', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, subtotal: SUBTOTAL }),
      });
      const data = await res.json();

      if (data.success) {
        appliedDiscount = data.discountAmount;
        // Show applied box
        document.getElementById('appliedCouponCode').textContent = data.couponCode;
        document.getElementById('appliedCouponSaving').textContent = `You save ₹${data.discountAmount.toLocaleString('en-IN')}`;
        document.getElementById('appliedCouponBox').classList.remove('hidden');
        document.getElementById('couponInputBox').classList.add('hidden');
        // Show discount in summary
        document.getElementById('couponDiscountLine').classList.remove('hidden');
        document.getElementById('couponDiscountAmount').textContent = '−₹' + data.discountAmount.toLocaleString('en-IN');
        // Update total
        updateTotalWithDiscount();

        Swal.fire({ toast: true, position: 'top-end', icon: 'success',
          title: data.message, showConfirmButton: false, timer: 2500,
          background: '#0a0f18', color: '#e2e8f0' });
      } else {
        errorEl.textContent = data.message;
        errorEl.classList.remove('hidden');
      }
    } catch {
      errorEl.textContent = 'Something went wrong. Try again.';
      errorEl.classList.remove('hidden');
    } finally {
      btn.disabled = false; btn.textContent = 'Apply';
    }
  }

  async function removeCouponAction() {
    try {
      await fetch('/checkout/remove-coupon', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    } catch { /* non-fatal */ }

    appliedDiscount = 0;
    document.getElementById('appliedCouponBox').classList.add('hidden');
    document.getElementById('couponInputBox').classList.remove('hidden');
    document.getElementById('couponCodeInput').value = '';
    document.getElementById('couponDiscountLine').classList.add('hidden');
    updateTotalWithDiscount();

    Swal.fire({ toast: true, position: 'top-end', icon: 'info',
      title: 'Coupon removed', showConfirmButton: false, timer: 1500,
      background: '#0a0f18', color: '#e2e8f0' });
  }

  function updateTotalWithDiscount() {
    const originalTotal = <%= totals.total %>;
    const newTotal = Math.max(0, originalTotal - appliedDiscount);
    const totalEl = document.querySelector('[data-checkout-total]');
    if (totalEl) totalEl.textContent = '₹' + newTotal.toLocaleString('en-IN');
  }
</script>
