<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neo-Luxe | Watch Categories</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { background-color: #020617; }
        .sidebar-bg { background-color: #020617; border-right: 1px solid #1e293b; }
        .card-bg { background-color: #0b1120; border: 1px solid #1e293b; }
        .custom-glow { box-shadow: 0 0 15px rgba(6, 182, 212, 0.3); }
        
        #categoryModalOverlay {
            background-color: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
        }

        textarea#categoryDescription {
            resize: none;
            min-height: 120px;
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: #020617; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #06b6d4; }
    </style>
</head>
<body class="text-slate-300 font-sans antialiased overflow-hidden">

<div class="flex h-screen w-full">
    
    <%- include('../partials/admin-sidebar', { path: 'categories' }) %>

    <main class="flex-1 flex flex-col min-w-0 bg-[#020617]">
        
        <header class="p-8 pb-4 flex-shrink-0">
            
            <div class="flex justify-between items-end">
                <div>
                    <h2 class="text-2xl font-bold text-white tracking-tight">Watch Categories</h2>
                    <p class="text-sm text-slate-400">Manage categories by gender and collections.</p>
                </div>
            </div>
        </header>

        <section class="px-8 mb-6 flex-shrink-0">
            <div class="card-bg p-4 rounded-xl flex flex-wrap items-center justify-between gap-4">
                <div class="relative w-full md:w-72">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
                    <input type="text" id="categorySearchInput" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search categories..." class="w-full bg-[#1e293b]/40 border border-slate-700 rounded-lg py-2 pl-9 pr-4 text-sm focus:outline-none focus:border-cyan-500/50 transition">
                </div>
                <div class="flex items-center space-x-3">
                    <button id="searchBtn" class="bg-cyan-500 text-slate-900 px-5 py-2 rounded-lg font-bold text-xs uppercase tracking-wider hover:bg-cyan-400 transition text-nowrap">Search</button>
                    <button id="clearSearchBtn" class="bg-transparent border border-slate-700 px-5 py-2 rounded-lg text-xs font-semibold hover:bg-slate-800 transition text-nowrap">Clear</button>
                    <button id="addCategoryBtn" class="bg-cyan-500 text-slate-900 px-5 py-2 rounded-lg font-bold text-xs uppercase tracking-wider flex items-center custom-glow hover:bg-cyan-400 transition text-nowrap">
                        <i class="fas fa-plus mr-2"></i> Add Category
                    </button>
                </div>
            </div>
        </section>

        <section class="px-8 flex-1 overflow-hidden flex flex-col pb-4">
            <div class="card-bg rounded-xl flex-1 overflow-hidden flex flex-col">
                <div class="overflow-x-auto overflow-y-auto custom-scroll flex-1">
                    <table class="w-full text-left text-sm min-w-[900px]">
                        <thead class="bg-slate-800/30 border-b border-slate-800 text-[10px] uppercase tracking-[0.15em] text-slate-500 font-bold sticky top-0 z-10 backdrop-blur-md">
                            <tr>
                                <th class="px-6 py-4">Category Name</th>
                                <th class="px-6 py-4">Description</th>
                                
                                <th class="px-6 py-4 text-center">Status</th>
                                <th class="px-6 py-4 text-center">Visibility</th>
                                <th class="px-6 py-4 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800/50">
                            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                <% categories.forEach(category => { %>
                                <tr class="hover:bg-slate-800/20 transition-colors">
                                    <td class="px-6 py-5 font-bold text-white"><%= category.name %></td>
                                    <td class="px-6 py-5 text-slate-400 text-xs max-w-xs truncate"><%= category.description %></td>
                                    
                                    <td class="px-6 py-5 text-center">
                                        <span id="status-badge-<%= category._id %>" class="text-[9px] font-black border border-cyan-500/30 px-2 py-0.5 rounded text-cyan-400 bg-cyan-500/5">
                                            <%= category.isListed ? 'LISTED' : 'UNLISTED' %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-5 text-center">
                                        <label class="relative inline-flex items-center cursor-pointer">
                                            <input type="checkbox" <%= category.isListed ? 'checked' : '' %> 
                                                   onchange="toggleCategoryStatus('<%= category._id %>')" 
                                                   class="sr-only peer">
                                            <div class="w-9 h-5 bg-slate-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-cyan-500"></div>
                                        </label>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="flex justify-center space-x-4 text-slate-500">
                                           <button class="editBtn hover:text-cyan-400 transition" 
        data-id="<%= category._id %>"
        data-name="<%= category.name %>"
        data-desc="<%= category.description %>"
        > <i class="fas fa-edit"></i>
</button>
                                            <button onclick="deleteCategory('<%= category._id %>')" class="hover:text-red-400 transition">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="6" class="px-6 py-10 text-center text-slate-500">No categories found.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <footer class="mt-4 text-center text-[10px] text-slate-600 tracking-widest uppercase flex-shrink-0">
                © 2026 NEO-LUXE Admin Portal.
            </footer>
        </section>
    </main>
</div>

<div id="categoryModalOverlay" class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300">
    <div class="card-bg w-full max-w-2xl rounded-2xl shadow-2xl relative border border-slate-800">
        <div class="p-6 border-b border-slate-800">
            <h3 id="modalTitle" class="text-xl font-bold text-white tracking-tight">Add Watch Category</h3>
            <button id="closeModalX" class="absolute top-5 right-5 text-slate-500 hover:text-white transition">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form id="categoryForm" class="p-8 space-y-6">
            <input type="hidden" id="categoryId" name="id">
            
            <div class="space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold">Category Name *</label>
                <input type="text" id="categoryName" name="name" required class="w-full bg-[#1e293b]/50 border border-slate-700 rounded-lg py-2.5 px-4 text-sm text-white focus:outline-none focus:border-cyan-500/50 transition">
            </div>

            <div class="space-y-1.5">
                <label class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold">Category Description</label>
                <textarea id="categoryDescription" name="description" class="w-full bg-[#1e293b]/50 border border-slate-700 rounded-lg py-2.5 px-4 text-sm text-white focus:outline-none focus:border-cyan-500/50 transition"></textarea>
            </div>

            

            <div class="flex justify-end items-center space-x-4 pt-6 border-t border-slate-800">
                <button type="button" id="closeModalBtn" class="bg-transparent px-6 py-2.5 rounded-lg text-slate-400 hover:text-white transition text-sm font-semibold">Cancel</button>
                <button type="submit" id="submitBtn" class="bg-cyan-500 text-slate-900 px-8 py-2.5 rounded-lg font-bold text-sm uppercase tracking-wider custom-glow hover:bg-cyan-400 transition">
                    Save Category
                </button>
            </div>
        </form>
    </div>
</div>

<div id="toastContainer" class="fixed top-10 right-10 z-[100] flex flex-col gap-3"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- Core UI Elements ---
        const modal = document.getElementById('categoryModalOverlay');
        const form = document.getElementById('categoryForm');
        const submitBtn = document.getElementById('submitBtn');
        const categoryIdInput = document.getElementById('categoryId');
        const nameInput = document.getElementById('categoryName');
        const descInput = document.getElementById('categoryDescription');
      

        // --- Toast Notification System ---
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            const isSuccess = type === 'success';
            const bgColor = isSuccess ? 'bg-cyan-500/10 border-cyan-500/30' : 'bg-red-500/10 border-red-500/30';
            const textColor = isSuccess ? 'text-cyan-400' : 'text-red-400';
            const icon = isSuccess ? 'fa-check-circle' : 'fa-exclamation-circle';

            toast.className = `${bgColor} ${textColor} border backdrop-blur-xl px-6 py-4 rounded-xl shadow-2xl flex items-center min-w-[320px] transform translate-y-10 opacity-0 transition-all duration-500 ease-out`;
            toast.innerHTML = `
                <i class="fas ${icon} mr-3 text-lg"></i>
                <span class="text-[11px] font-black uppercase tracking-widest">${message}</span>
            `;

            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-10', 'opacity-0'), 10);
            
            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-x-10');
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }

        // --- Modal Control ---
        const openModal = () => {
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.add('opacity-100'), 10);
        };

        const closeModal = () => {
            modal.classList.remove('opacity-100');
            setTimeout(() => modal.classList.add('hidden'), 300);
        };

        // --- Search Logic ---
        const searchInput = document.getElementById('categorySearchInput');
        const performSearch = () => {
            const query = searchInput.value.trim();
            window.location.href = `/admin/categories?search=${encodeURIComponent(query)}&page=1`;
        };

        document.getElementById('searchBtn').addEventListener('click', performSearch);
        searchInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') performSearch(); });
        document.getElementById('clearSearchBtn').addEventListener('click', () => { window.location.href = '/admin/categories'; });

        // --- Add Button ---
        document.getElementById('addCategoryBtn').addEventListener('click', () => {
            form.reset();
            categoryIdInput.value = "";
            document.getElementById('modalTitle').innerText = "Add Watch Category";
            submitBtn.innerText = "Add Category";
            openModal();
        });

        // --- Edit Button (Delegation) ---
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.editBtn');
            if (btn) {
                document.getElementById('modalTitle').innerText = "Edit Watch Category";
                submitBtn.innerText = "Update Category";
                categoryIdInput.value = btn.dataset.id;
                nameInput.value = btn.dataset.name;
                descInput.value = btn.dataset.desc;
               
                openModal();
            }
        });

        // --- AJAX Form Submission (Add/Edit) ---
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = categoryIdInput.value;
            const url = id ? '/admin/edit-category' : '/admin/add-category';
            const method = id ? 'PUT' : 'POST'; 

            const formData = {
                id,
                name: nameInput.value.trim(),
                description: descInput.value.trim(),
               
            };

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Processing';

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showToast(result.message, 'success');
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showToast(result.message, 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerText = id ? "Update Category" : "Add Category";
                }
            } catch (error) { 
                showToast("Server communication error", 'error');
                submitBtn.disabled = false;
            }
        });

        // --- Toggle Logic ---
        window.toggleCategoryStatus = async (id) => {
            try {
                const response = await fetch(`/admin/toggle-category/${id}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await response.json();
                if (result.success) {
                    const badge = document.getElementById(`status-badge-${id}`);
                    const isNowListed = badge.innerText.trim() === 'UNLISTED';
                    badge.innerText = isNowListed ? 'LISTED' : 'UNLISTED';
                    showToast(`Category ${isNowListed ? 'Listed' : 'Unlisted'}`, 'success');
                } else { 
                    showToast(result.message, 'error');
                }
            } catch (error) { 
                showToast("Failed to update status", 'error');
            }
        };

        // --- Delete Logic with SweetAlert2 ---
window.deleteCategory = (id) => {
    Swal.fire({
        title: 'ARE YOU SURE?',
        text: "This category will be moved to trash.",
        icon: 'warning',
        showCancelButton: true,
        background: '#0b1120', // Matches your card-bg
        color: '#f8fafc',      // text-slate-300
        confirmButtonColor: '#06b6d4', // Cyan-500
        cancelButtonColor: '#1e293b',  // Slate-800
        confirmButtonText: 'YES, DELETE IT',
        cancelButtonText: 'CANCEL',
        customClass: {
            popup: 'border border-slate-800 rounded-2xl',
            title: 'font-bold tracking-tight',
            confirmButton: 'rounded-lg px-6 py-2 font-bold text-xs uppercase tracking-widest',
            cancelButton: 'rounded-lg px-6 py-2 font-bold text-xs uppercase tracking-widest'
        }
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                const response = await fetch(`/admin/delete-category/${id}`, { method: 'DELETE' });
                const data = await response.json();
                
                if (data.success) {
                    showToast("Category deleted successfully", 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (error) {
                showToast("Deletion failed", 'error');
            }
        }
    });
};

        // Modal Close Listeners
        document.getElementById('closeModalBtn').addEventListener('click', closeModal);
        document.getElementById('closeModalX').addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    });
</script>
</body>
</html>