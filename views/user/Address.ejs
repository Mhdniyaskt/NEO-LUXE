<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Neo-Luxe | My Addresses</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: "Inter", sans-serif; }
        .active-nav-item {
            background: linear-gradient(90deg, rgba(0, 163, 255, 0.1) 0%, rgba(0, 163, 255, 0.02) 100%);
            border-right: 2px solid #00a3ff;
            color: #00a3ff;
        }
        .modal-active { display: flex !important; }
        .address-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .address-card:hover { transform: translateY(-5px); border-color: #00a3ff; }
    </style>
</head>
<body class="bg-[#05080d] text-white min-h-screen flex flex-col">

    <main class="max-w-7xl mx-auto w-full px-6 py-8 flex-grow">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
                    <%- include('../partials/profileSidebar') %>


            <div class="lg:col-span-9 space-y-8">
                <div class="flex justify-between items-end">
                    <div>
                        <h1 class="text-3xl font-bold mb-2">My Addresses</h1>
                        <p class="text-gray-400 text-sm">Manage your saved delivery locations</p>
                    </div>
                    <button onclick="toggleModal('add')" class="bg-[#00a3ff] hover:bg-[#0082cc] text-white text-xs font-bold py-3.5 px-6 rounded-full shadow-lg shadow-cyan-500/20 transition flex items-center gap-2">
                        <i class="fas fa-plus"></i> Add New Address
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <% if (addresses && addresses.length > 0) { %>
                        <% addresses.forEach(addr => { %>
                            <div class="address-card bg-[#0a0f18] rounded-3xl border border-gray-800 p-8 relative">
                                <div class="flex justify-between items-start mb-6">
                                    <span class="bg-[#00a3ff]/10 text-[#00a3ff] text-[9px] font-bold px-3 py-1 rounded-full uppercase tracking-widest border border-[#00a3ff]/20">
                                        <%= addr.addressType || 'Home' %>
                                    </span>
                                    <div class="flex gap-4 text-gray-500">
                                       <button onclick="editAddress('<%= encodeURIComponent(JSON.stringify(addr)) %>')" class="hover:text-white transition">
    <i class="fas fa-pencil-alt text-xs"></i>
</button>
                                           
                                        </button>
                                        <button onclick="deleteAddress('<%= addr._id %>')" class="hover:text-red-400 transition">
                                            <i class="far fa-trash-alt text-xs"></i>
                                        </button>
                                    </div>
                                </div>
                                <h3 class="text-lg font-bold mb-2"><%= addr.fullName %></h3>
                                <p class="text-gray-400 text-sm leading-relaxed mb-6">
                                    <%= addr.streetAddress %>,<br>
                                    <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
                                </p>
                                <div class="pt-6 border-t border-gray-800 text-gray-400 text-sm flex items-center gap-3 font-medium">
                                    <i class="fas fa-phone-alt text-[#00a3ff] text-xs"></i> <%= addr.phone %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-2 text-center py-20 bg-[#0a0f18] rounded-3xl border border-dashed border-gray-800">
                            <i class="fas fa-map-marked-alt text-4xl text-gray-700 mb-4"></i>
                            <p class="text-gray-500">No addresses found. Add one to get started!</p>
                        </div>
                    <% } %>
                </div>

                <% if (totalPages > 1) { %>
                    <div class="mt-8 flex justify-center gap-2">
                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <a href="?page=<%= i %>" 
                               class="w-10 h-10 flex items-center justify-center rounded-xl border <%= currentPage === i ? 'bg-[#00a3ff] text-white border-[#00a3ff]' : 'border-gray-800 text-gray-400 hover:bg-gray-800' %> transition">
                                <%= i %>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <div id="addressModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
        <div class="w-full max-w-xl bg-[#0a0f18] rounded-[2.5rem] shadow-2xl overflow-hidden border border-gray-800">
            <div class="flex justify-between items-center px-10 py-8">
                <h2 id="modalTitle" class="text-white text-xl font-bold">Add New Address</h2>
                <button onclick="toggleModal()" class="text-gray-500 hover:text-white transition"><i class="fas fa-times text-lg"></i></button>
            </div>

            <form id="addressForm" class="px-10 pb-10 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Full Name</label>
                        <input type="text" name="fullName" required class="w-full bg-[#05080d] border border-gray-800 text-white rounded-2xl p-4 focus:ring-1 focus:ring-[#00a3ff] outline-none transition">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Mobile Number</label>
                        <input type="tel" name="phone" required class="w-full bg-[#05080d] border border-gray-800 text-white rounded-2xl p-4 focus:ring-1 focus:ring-[#00a3ff] outline-none transition">
                    </div>
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Street Address</label>
                    <input type="text" name="streetAddress" required class="w-full bg-[#05080d] border border-gray-800 text-white rounded-2xl p-4 focus:ring-1 focus:ring-[#00a3ff] outline-none transition">
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <input type="text" name="city" placeholder="City" required class="w-full bg-[#05080d] border border-gray-800 text-white rounded-2xl p-4 focus:ring-1 focus:ring-[#00a3ff] outline-none">
                    <input type="text" name="state" placeholder="State" required class="w-full bg-[#05080d] border border-gray-800 text-white rounded-2xl p-4 focus:ring-1 focus:ring-[#00a3ff] outline-none">
                    <input type="text" name="pincode" placeholder="Pincode" required class="w-full bg-[#05080d] border border-gray-800 text-white rounded-2xl p-4 focus:ring-1 focus:ring-[#00a3ff] outline-none">
                </div>
                
                <div class="space-y-3">
                    <label class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Address Type</label>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-2 px-6 py-3 rounded-full border border-gray-800 cursor-pointer text-sm text-gray-400 has-[:checked]:border-[#00a3ff] has-[:checked]:bg-[#00a3ff]/10 has-[:checked]:text-white transition">
                            <input type="radio" name="addressType" value="Home" checked class="hidden"> Home
                        </label>
                        <label class="flex items-center gap-2 px-6 py-3 rounded-full border border-gray-800 cursor-pointer text-sm text-gray-400 has-[:checked]:border-[#00a3ff] has-[:checked]:bg-[#00a3ff]/10 has-[:checked]:text-white transition">
                            <input type="radio" name="addressType" value="Office" class="hidden"> Office
                        </label>
                    </div>
                </div>

                <div class="pt-6 flex justify-end items-center gap-8">
                    <button type="button" onclick="toggleModal()" class="text-gray-500 hover:text-white text-sm font-bold">Cancel</button>
                    <button type="submit" id="saveBtn" class="bg-[#00a3ff] hover:bg-[#0082cc] text-white font-bold py-4 px-10 rounded-full shadow-lg shadow-cyan-500/20 transition">
                        Save Address
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Modal and AJAX logic remains identical to your working version
        function toggleModal(mode) {
            const modal = document.getElementById('addressModal');
            const title = document.getElementById('modalTitle');
            const saveBtn = document.getElementById('saveBtn');
            const form = document.getElementById('addressForm');

            if (mode === 'add') {
                title.innerText = "Add New Address";
                saveBtn.innerText = "Save Address";
                form.reset();
                form.action = "/addresses/add";
                modal.classList.add('modal-active');
            } else if (mode === 'edit') {
                title.innerText = "Edit Address";
                saveBtn.innerText = "Save Changes";
                modal.classList.add('modal-active');
            } else {
                modal.classList.remove('modal-active');
            }
        }

        function editAddress(Addr) {
            const addr =JSON.parse(decodeURIComponent(Addr)) 
            
            const form = document.getElementById('addressForm');
            form.querySelector('[name="fullName"]').value = addr.fullName;
            form.querySelector('[name="phone"]').value = addr.phone;
            form.querySelector('[name="streetAddress"]').value = addr.streetAddress;
            form.querySelector('[name="city"]').value = addr.city;
            form.querySelector('[name="state"]').value = addr.state;
            form.querySelector('[name="pincode"]').value = addr.pincode;

            const radios = form.querySelectorAll('[name="addressType"]');
            radios.forEach(r => { if(r.value === addr.addressType) r.checked = true; });

            form.action = `/addresses/edit/${addr._id}`;
            toggleModal('edit');
        }

        document.getElementById('addressForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch(this.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    await Swal.fire({ icon: 'success', title: 'Success!', text: result.message, background: '#0a0f18', color: '#fff', confirmButtonColor: '#00a3ff' });
                    window.location.reload();
                }
            } catch (err) {
                console.error(err);
            }
        });

        async function deleteAddress(id) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: "This address will be removed!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                background: '#0a0f18',
                color: '#fff'
            });

            if (result.isConfirmed) {
                const response = await fetch(`/addresses/delete/${id}`, { method: 'DELETE' });
                const data = await response.json();
                if (data.success) window.location.reload();
            }
        }
    </script>
</body>
</html>