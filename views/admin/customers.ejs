<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customers | NEO-LUXE Admin</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Outfit', 'sans-serif'] },
                    colors: {
                        brand: {
                            darkest: '#05070A',
                            sidebar: '#020408',
                            card: '#0B1120',
                            accent: '#22D3EE',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #05070A; color: #E2E8F0; font-family: 'Outfit', sans-serif; }
        .card-bg { background-color: #0B1120; border: 1px solid #1E293B; }
        .sidebar-bg { background-color: #05070A; border-right: 1px solid #1E293B; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: #05070A; }
        ::-webkit-scrollbar-thumb { background: #1E293B; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #22D3EE; }

        /* Mobile Sidebar Overlay */
        #sidebar-overlay.active { display: block; }
    </style>
</head>
<body class="antialiased overflow-hidden">

    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 z-40 hidden lg:hidden"></div>

    <div class="flex h-screen w-full relative">
        
       <%- include('../partials/admin-sidebar', { path: 'customers' }) %>

        <main class="flex-1 overflow-y-auto p-4 md:p-8">
            <div class="max-w-7xl mx-auto">
                
                <header class="flex items-center gap-4 mb-8">
                    <button onclick="toggleSidebar()" class="lg:hidden bg-slate-900 border border-slate-800 p-2.5 rounded-xl text-white">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold text-white uppercase tracking-tight">Customer Management</h2>
                    </div>
                </header>

                <form id="searchForm" action="/admin/customers" method="GET" class="card-bg p-4 md:p-6 rounded-2xl mb-8 shadow-xl">
                    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 items-end">
                        <div class="lg:col-span-2">
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-3 tracking-widest">Search Customer</label>
                            <div class="relative">
                                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-600 text-xs"></i>
                                <input type="text" name="search" value="<%= search %>" placeholder="Name or email..." 
                                       class="w-full bg-[#05070A] border border-slate-800 rounded-xl py-3 pl-11 pr-4 text-sm text-white focus:outline-none focus:border-cyan-500/50 transition-all">
                            </div>
                        </div>

                        <div>
                            <label class="block text-[10px] uppercase font-bold text-slate-500 mb-3 tracking-widest">Status</label>
                            <select name="status" class="w-full bg-[#05070A] border border-slate-800 rounded-xl py-3 px-4 text-sm text-white focus:outline-none focus:border-cyan-500/50 appearance-none cursor-pointer">
                                <option value="">All Status</option>
                                <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="blocked" <%= status === 'blocked' ? 'selected' : '' %>>Blocked</option>
                            </select>
                        </div>
                        
                        <div class="flex gap-2">
                            <button type="submit" class="flex-1 bg-cyan-400 hover:brightness-110 text-black py-3 rounded-xl text-[10px] font-bold uppercase tracking-wider transition">
                                Search
                            </button>
                            <% if(search || status) { %>
                                <a href="/admin/customers" class="flex-1 bg-slate-800 hover:bg-slate-700 text-white py-3 rounded-xl text-[10px] font-bold uppercase tracking-wider transition text-center">
                                    Clear
                                </a>
                            <% } %>
                        </div>
                    </div>
                </form>

                <section class="card-bg rounded-2xl shadow-2xl overflow-hidden mb-6">
                    <div class="overflow-x-auto scrollbar-hide">
                        <table class="w-full text-left border-collapse min-w-[700px]">
                            <thead class="bg-slate-900/40 text-[10px] uppercase tracking-[0.15em] text-slate-500 border-b border-slate-800/60">
                                <tr>
                                    <th class="px-6 md:px-8 py-5 font-bold">Customer Name</th>
                                    <th class="px-6 py-5 font-bold">Email Address</th>
                                    <th class="px-6 py-5 font-bold text-center">Status</th>
                                    <th class="px-6 md:px-8 py-5 font-bold text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/40">
                                <% if (customers.length > 0) { %>
                                    <% customers.forEach(user => { %>
                                        <tr class="hover:bg-white/[0.02] transition-colors group">
                                            <td class="px-6 md:px-8 py-5">
                                                <div class="flex items-center gap-3">
                                                    <div class="hidden sm:flex w-9 h-9 shrink-0 rounded-full bg-slate-800 items-center justify-center text-[10px] text-cyan-400 font-bold border border-slate-700">
                                                        <%= user.name.split(' ').map(n => n[0]).join('').toUpperCase() %>
                                                    </div>
                                                    <span class="font-semibold text-white text-sm truncate max-w-[150px]"><%= user.name %></span>
                                                </div>
                                            </td>
                                            <td class="px-6 py-5 text-slate-400 text-xs font-light"><%= user.email %></td>
                                            <td class="px-6 py-5 text-center">
                                                <span class="inline-block px-3 py-1 rounded-md text-[9px] font-black uppercase tracking-tighter border <%= user.isBlocked ? 'bg-red-500/10 text-red-500 border-red-500/20' : 'bg-cyan-500/10 text-cyan-400 border-cyan-400/20' %>">
                                                    <%= user.isBlocked ? 'Blocked' : 'Active' %>
                                                </span>
                                            </td>
                                            <td class="px-6 md:px-8 py-5 text-right">
                                                <button onclick="confirmToggle('<%= user._id %>', '<%= user.isBlocked %>')" 
                                                        class="text-[9px] font-black uppercase tracking-widest border border-slate-800 px-4 py-2 rounded-lg transition-all <%= user.isBlocked ? 'hover:text-green-500 hover:border-green-500/40' : 'hover:text-red-500 hover:border-red-500/40' %>">
                                                    <%= user.isBlocked ? 'Unblock' : 'Block' %>
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="px-8 py-16 text-center text-slate-500 text-sm italic font-light">No customers found matching your criteria.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </section>

                <% if (totalPages > 1) { %>
                <div class="flex flex-wrap justify-center items-center gap-2 mb-8">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="/admin/customers?page=<%= i %>&search=<%= search %>&status=<%= status %>" 
                           class="w-9 h-9 md:w-10 md:h-10 flex items-center justify-center rounded-lg border transition-all text-xs font-bold
                           <%= currentPage === i ? 'bg-cyan-400 border-cyan-400 text-black' : 'border-slate-800 text-slate-400 hover:border-cyan-400/50' %>">
                            <%= i %>
                        </a>
                    <% } %>
                </div>
                <% } %>

                <footer class="text-center pb-8">
                    <p class="text-[9px] text-slate-600 uppercase tracking-widest font-medium">© 2026 NEO-LUXE ADMIN. ALL RIGHTS RESERVED.</p>
                </footer>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }

       function confirmToggle(userId, isBlocked) {
    const action = isBlocked === 'true' ? 'Unblock' : 'Block';
    Swal.fire({
        title: 'Are you sure?',
        text: `You are about to ${action.toLowerCase()} this user.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: isBlocked === 'true' ? '#10B981' : '#EF4444',
        cancelButtonColor: '#1E293B',
        confirmButtonText: `Yes, ${action}!`,
        background: '#0B1120',
        color: '#fff'
    }).then((result) => {
        if (result.isConfirmed) {
            // FIXED: Path changed from /toggle/ to /status/ to match your routes
            fetch(`/admin/customers/${userId}/status`, {
                method: 'PATCH', 
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    window.location.reload();
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: 'Failed to update status',
                        icon: 'error',
                        background: '#0B1120',
                        color: '#fff'
                    });
                }
            })
            .catch(err => console.error(err));
        }
    });

}
    </script>
</body>
</html>