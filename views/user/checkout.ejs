<style>
  body { background: #05080d; }

  /* Progress bar */
  .step-line { height: 2px; flex: 1; background: #1f2937; }
  .step-line.done { background: #00d4ff; }

  /* Address cards */
  .addr-card {
    border: 1.5px solid #1f2937;
    border-radius: 14px;
    padding: 14px 16px;
    cursor: pointer;
    transition: all .15s ease;
    background: #080d16;
  }
  .addr-card:hover  { border-color: rgba(0,212,255,0.35); background: #0a1220; }
  .addr-card.selected { border-color: #00d4ff; background: #071525; }
  .addr-card input[type="radio"] { accent-color: #00d4ff; }

  /* Scrollbar for items list */
  .items-scroll::-webkit-scrollbar { width: 4px; }
  .items-scroll::-webkit-scrollbar-track { background: transparent; }
  .items-scroll::-webkit-scrollbar-thumb { background: #1e2640; border-radius: 4px; }
</style>

<div class="min-h-screen bg-[#05080d]">
<div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 pb-24">

  <!-- ── Progress Steps ──────────────────────────────────────────────── -->
  <div class="flex items-center justify-center gap-3 mb-10 text-xs font-semibold select-none">
    <div class="flex items-center gap-2 text-slate-500">
      <div class="w-7 h-7 rounded-full bg-[#0a0f18] border border-slate-700 flex items-center justify-center">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <span>Cart</span>
    </div>
    <div class="step-line done w-16 sm:w-24"></div>
    <div class="flex items-center gap-2 text-cyan-400">
      <div class="w-7 h-7 rounded-full bg-cyan-400/15 border border-cyan-400/50 flex items-center justify-center shadow-[0_0_12px_rgba(0,212,255,0.25)]">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        </svg>
      </div>
      <span>Checkout</span>
    </div>
    <div class="step-line w-16 sm:w-24"></div>
    <div class="flex items-center gap-2 text-slate-600">
      <div class="w-7 h-7 rounded-full bg-[#0a0f18] border border-slate-800 flex items-center justify-center">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <span>Confirmation</span>
    </div>
  </div>

  <!-- ── Alerts ──────────────────────────────────────────────────────── -->
  <% if (typeof blockedItems !== 'undefined' && blockedItems.length) { %>
    <div class="bg-red-500/10 border border-red-500/30 rounded-2xl px-5 py-4 mb-6 space-y-1.5">
      <p class="text-red-400 text-xs font-bold uppercase tracking-widest mb-2">Items Removed</p>
      <% blockedItems.forEach(reason => { %>
        <p class="text-red-300 text-sm flex items-start gap-2">
          <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <%= reason %>
        </p>
      <% }) %>
    </div>
  <% } %>

  <% if (typeof stockErrors !== 'undefined' && stockErrors.length) { %>
    <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl px-5 py-4 mb-6 space-y-1.5">
      <p class="text-amber-400 text-xs font-bold uppercase tracking-widest mb-2">Quantities Adjusted</p>
      <% stockErrors.forEach(e => { %>
        <p class="text-amber-300 text-sm flex items-start gap-2">
          <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <strong class="text-white"><%= e.name %></strong>: adjusted to <%= e.available %> (only <%= e.available %> in stock)
        </p>
      <% }) %>
    </div>
  <% } %>

  <!-- ── Main Grid ───────────────────────────────────────────────────── -->
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 items-start">

    <!-- ── LEFT: Address + Payment (3 cols) ───────────────────────── -->
    <div class="lg:col-span-3 space-y-5">

      <!-- Delivery Address -->
      <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-6">

        <div class="flex items-center justify-between mb-5">
          <h2 class="text-white font-bold text-sm flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Delivery Address
          </h2>
          <a href="/addresses" class="text-[10px] text-cyan-400 hover:text-cyan-300 font-semibold uppercase tracking-wider transition flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add New
          </a>
        </div>

        <% if (!addresses || addresses.length === 0) { %>
          <div class="text-center py-10 border border-dashed border-gray-800 rounded-xl">
            <svg class="w-10 h-10 text-slate-700 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            </svg>
            <p class="text-slate-400 text-sm mb-4">No saved addresses yet.</p>
            <a href="/addresses" class="inline-block bg-cyan-400 text-[#05080d] font-bold text-xs px-5 py-2.5 rounded-xl hover:bg-cyan-300 transition">
              Add an Address
            </a>
          </div>
        <% } else { %>
          <div class="space-y-2.5" id="addressList">
            <% addresses.forEach((addr, i) => {
                 const isDefault = addr.isDefault;
                 const isSelected = isDefault || (i === 0 && !addresses.some(a => a.isDefault));
            %>
              <label class="addr-card flex items-start gap-3 <%= isSelected ? 'selected' : '' %>"
                     id="addrCard-<%= addr._id %>"
                     onclick="selectAddress('<%= addr._id %>')">
                <!-- Radio -->
                <div class="mt-0.5 flex-shrink-0">
                  <input type="radio" name="addressId" value="<%= addr._id %>"
                         id="addr-<%= addr._id %>" <%= isSelected ? 'checked' : '' %>
                         class="w-4 h-4"/>
                </div>
                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-1.5 mb-1">
                    <span class="text-white font-semibold text-sm"><%= addr.fullName %></span>
                    <span class="text-[9px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full border border-slate-700 uppercase tracking-wider">
                      <%= addr.addressType %>
                    </span>
                    <% if (addr.isDefault) { %>
                      <span class="text-[9px] bg-cyan-400/10 text-cyan-400 px-2 py-0.5 rounded-full border border-cyan-400/25 uppercase tracking-wider">Default</span>
                    <% } %>
                  </div>
                  <p class="text-slate-400 text-xs leading-relaxed">
                    <%= addr.streetAddress %>, <%= addr.city %>, <%= addr.state %> — <%= addr.pincode %>
                  </p>
                  <p class="text-slate-500 text-[11px] mt-1 flex items-center gap-1">
                    <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    <%= addr.phone %>
                  </p>
                </div>
              </label>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Payment Method -->
      <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-6">
        <h2 class="text-white font-bold text-sm mb-4 flex items-center gap-2">
          <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
          </svg>
          Payment Method
        </h2>

        <div class="space-y-2.5">
          <!-- COD -->
          <label class="addr-card selected flex items-center gap-3" id="pmCard-cod" onclick="selectPayment('cod')">
            <input type="radio" name="paymentMethod" value="cod" id="pm-cod" checked class="w-4 h-4 flex-shrink-0"/>
            <div class="w-9 h-9 bg-cyan-400/10 border border-cyan-400/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm">Cash on Delivery</p>
              <p class="text-slate-500 text-xs">Pay when your order arrives</p>
            </div>
          </label>

          <!-- Online (disabled) -->
          <label class="addr-card flex items-center gap-3 opacity-35 cursor-not-allowed" title="Coming soon">
            <input type="radio" name="paymentMethod" value="online" disabled class="w-4 h-4 flex-shrink-0"/>
            <div class="w-9 h-9 bg-slate-800 border border-slate-700 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm">Online Payment <span class="text-slate-500 font-normal text-xs">(Coming soon)</span></p>
              <p class="text-slate-500 text-xs">UPI · Cards · Net Banking</p>
            </div>
          </label>
        </div>
      </div>

    </div>

    <!-- ── RIGHT: Order Summary (2 cols) ──────────────────────────── -->
    <div class="lg:col-span-2">
      <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-5 sticky top-6">

        <h2 class="text-white font-bold text-sm mb-4 flex items-center gap-2">
          <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          Order Summary
        </h2>

        <!-- Items list -->
        <div class="space-y-3 mb-4 max-h-52 overflow-y-auto items-scroll pr-0.5">
          <% checkoutItems.forEach(item => {
               const discPct = (item.regularPrice > item.basePrice && item.regularPrice > 0)
                 ? Math.round((item.regularPrice - item.basePrice) / item.regularPrice * 100) : 0;
          %>
            <div class="flex gap-3 items-start">
              <!-- Thumbnail -->
              <div class="w-12 h-12 bg-[#111827] rounded-lg overflow-hidden border border-gray-800/80 flex-shrink-0 relative">
                <% if (item.imageUrl) { %>
                  <img src="<%= item.imageUrl %>" alt="<%= item.productName %>" class="w-full h-full object-cover"/>
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-slate-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="1.5"/></svg>
                  </div>
                <% } %>
                <% if (discPct > 0) { %>
                  <span class="absolute -top-0.5 -right-0.5 bg-red-500 text-white text-[7px] font-black px-1 rounded leading-tight">-<%= discPct %>%</span>
                <% } %>
              </div>
              <!-- Info -->
              <div class="flex-1 min-w-0">
                <p class="text-white text-xs font-semibold truncate leading-snug"><%= item.productName %></p>
                <p class="text-slate-500 text-[10px] mt-0.5"><%= item.color %> · Qty <%= item.quantity %></p>
                <% if (discPct > 0) { %>
                  <p class="text-[10px] mt-0.5 text-green-400 font-medium">
                    Save ₹<%= ((item.regularPrice - item.basePrice) * item.quantity).toLocaleString('en-IN') %>
                  </p>
                <% } %>
              </div>
              <!-- Price -->
              <p class="text-white text-xs font-bold flex-shrink-0 mt-0.5">
                ₹<%= item.itemTotal.toLocaleString('en-IN') %>
              </p>
            </div>
          <% }) %>
        </div>

        <!-- Divider -->
        <div class="border-t border-gray-800/60 pt-4 space-y-2 mb-4">
          <div class="flex justify-between text-xs">
            <span class="text-slate-400">Subtotal</span>
            <span class="text-white font-medium">₹<%= totals.subtotal.toLocaleString('en-IN') %></span>
          </div>
          <%
            const totalRegular = checkoutItems.reduce((s, i) => s + i.regularPrice * i.quantity, 0);
            const totalSaving  = totalRegular - totals.subtotal;
          %>
          <% if (totalSaving > 0) { %>
            <div class="flex justify-between text-xs">
              <span class="text-green-400">Discount</span>
              <span class="text-green-400 font-semibold">−₹<%= totalSaving.toLocaleString('en-IN') %></span>
            </div>
          <% } %>
          <div class="flex justify-between text-xs">
            <span class="text-slate-400">Shipping</span>
            <span class="<%= totals.shipping === 0 ? 'text-cyan-400 font-semibold' : 'text-white font-medium' %>">
              <%= totals.shipping === 0 ? 'Free' : '₹' + totals.shipping %>
            </span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-slate-400">Tax (18% GST)</span>
            <span class="text-white font-medium">₹<%= totals.tax.toLocaleString('en-IN') %></span>
          </div>
        </div>

        <!-- Total -->
        <div class="border-t border-gray-800/60 pt-3 flex items-center justify-between mb-5">
          <div>
            <p class="text-white font-bold text-sm">Total</p>
            <p class="text-slate-500 text-[10px]">Incl. all taxes</p>
          </div>
          <p class="text-cyan-400 font-bold text-xl">₹<%= totals.total.toLocaleString('en-IN') %></p>
        </div>

        <!-- Place Order button -->
        <button id="placeOrderBtn"
                onclick="placeOrder()"
                <%= (!addresses || addresses.length === 0) ? 'disabled' : '' %>
                class="w-full py-3 rounded-xl flex items-center justify-center gap-2 font-bold text-sm transition-all duration-200
                       <%= (!addresses || addresses.length === 0)
                           ? 'bg-slate-800 text-slate-500 cursor-not-allowed border border-gray-800'
                           : 'bg-cyan-400 text-[#05080d] hover:bg-cyan-300 shadow-[0_4px_20px_rgba(0,212,255,0.15)]' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          Place Order
        </button>

        <!-- Trust badges -->
        <div class="mt-4 flex items-center justify-center gap-3 text-slate-600 text-[10px]">
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
            </svg>
            Secure SSL
          </span>
          <span class="w-px h-3 bg-gray-800"></span>
          <span>2-Year Warranty</span>
        </div>

      </div>
    </div>

  </div>
</div>
</div>

<script>
  let selectedAddressId = '<%= addresses && addresses.length ? (addresses.find(a => a.isDefault) || addresses[0])._id : "" %>';
  let selectedPayment   = 'cod';

  function selectAddress(id) {
    selectedAddressId = id;
    document.querySelectorAll('.addr-card[id^="addrCard-"]').forEach(c => c.classList.remove('selected'));
    const card = document.getElementById('addrCard-' + id);
    if (card) card.classList.add('selected');
    document.getElementById('addr-' + id).checked = true;
  }

  function selectPayment(method) {
    selectedPayment = method;
    ['cod'].forEach(m => {
      const card  = document.getElementById('pmCard-' + m);
      const radio = document.getElementById('pm-' + m);
      if (card)  card.classList.toggle('selected', m === method);
      if (radio) radio.checked = (m === method);
    });
  }

  async function placeOrder() {
    if (!selectedAddressId) {
      Swal.fire({
        title: 'No Address Selected',
        text: 'Please select a delivery address to continue.',
        icon: 'warning', confirmButtonColor: '#06b6d4',
        background: '#0a0f18', color: '#e2e8f0',
      });
      return;
    }

    const btn = document.getElementById('placeOrderBtn');
    btn.disabled = true;
    btn.innerHTML = `
      <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
      </svg>
      Placing Order…`;

    try {
      const res  = await fetch('/checkout/place-order', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ addressId: selectedAddressId, paymentMethod: selectedPayment }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect;
      } else {
        const params = new URLSearchParams({
          orderId: data.orderId || '', amount: data.amount || '', paymentMethod: selectedPayment,
        });
        window.location.href = '/payment-failed?' + params.toString();
      }
    } catch {
      window.location.href = '/payment-failed?paymentMethod=' + selectedPayment;
    }
  }
</script>
