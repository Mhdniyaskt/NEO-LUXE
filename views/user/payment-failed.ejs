<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Failed | Neo-Luxe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    body { font-family: "Inter", sans-serif; }
    @keyframes pulse-ring {
      0%   { transform: scale(0.9); opacity: .8; }
      50%  { transform: scale(1.05); opacity: .4; }
      100% { transform: scale(0.9); opacity: .8; }
    }
    .pulse-ring { animation: pulse-ring 2s ease-in-out infinite; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up { animation: fadeUp .5s ease both; }
  </style>
</head>
<body class="bg-[#05080d] text-white min-h-screen flex flex-col">

  <%- include('../partials/user-header') %>

  <div class="flex-grow flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md bg-[#0a0f18] border border-gray-800/80 rounded-3xl p-8 text-center relative overflow-hidden">

      <!-- subtle red glow bg -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(239,68,68,0.07),transparent_65%)] pointer-events-none"></div>

      <!-- Pulsing error icon -->
      <div class="relative w-20 h-20 mx-auto mb-6">
        <div class="pulse-ring absolute inset-0 rounded-full bg-red-500/15 border border-red-500/20"></div>
        <div class="absolute inset-0 rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center">
          <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
      </div>

      <h1 class="text-2xl font-bold text-white mb-2 tracking-tight">Payment Failed</h1>
      <p class="text-slate-400 text-sm leading-relaxed mb-7 max-w-xs mx-auto">
        Your payment could not be completed. Please try again or use a different payment method.
      </p>

      <!-- Details table -->
      <div class="bg-[#060b14] border border-gray-800/60 rounded-2xl divide-y divide-gray-800/60 mb-6 text-left">
        <div class="flex items-center justify-between px-5 py-3.5">
          <span class="text-slate-500 text-xs uppercase tracking-widest font-semibold">Payment Method</span>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
            <span class="text-white text-sm font-medium">Razorpay</span>
          </div>
        </div>
        <div class="flex items-center justify-between px-5 py-3.5">
          <span class="text-slate-500 text-xs uppercase tracking-widest font-semibold">Status</span>
          <span class="text-red-400 font-bold text-sm">Payment Not Completed</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-3">
        <a href="/checkout"
           class="w-full flex items-center justify-center gap-2 bg-cyan-400 hover:bg-cyan-300 active:bg-cyan-500 text-[#05080d] font-bold text-sm px-5 py-3.5 rounded-xl transition-all duration-200 shadow-[0_4px_20px_rgba(0,212,255,0.2)]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Try Again
        </a>
        <a href="/cart"
           class="w-full flex items-center justify-center gap-2 bg-[#111827] border border-gray-700 hover:border-gray-600 hover:bg-[#1a2235] text-slate-300 hover:text-white font-semibold text-sm px-5 py-3.5 rounded-xl transition-all duration-200">
          Back to Cart
        </a>
      </div>

      <!-- Info note -->
      <p class="text-slate-600 text-[11px] mt-5 flex items-start justify-center gap-1.5 leading-relaxed">
        <svg class="w-3.5 h-3.5 flex-shrink-0 mt-0.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Your cart is safe. No stock was deducted and no order was created.
      </p>

    </div>
  </div>

  <footer class="mt-10 text-center">
    <p class="text-slate-700 text-xs">&copy; 2026 Luxe Time Inc. All rights reserved.</p>
    <div class="flex justify-center gap-6 mt-2 text-[10px] text-slate-700 uppercase tracking-widest">
      <a href="#" class="hover:text-slate-500 transition">Privacy Policy</a>
      <a href="#" class="hover:text-slate-500 transition">Terms of Service</a>
    </div>
  </footer>

</body>
</html>
