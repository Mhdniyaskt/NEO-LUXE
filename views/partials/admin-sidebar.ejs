        <a href="/admin/coupons" onclick="closeSidebarMobile()"
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'coupons' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
            <i class="fas fa-ticket w-5 text-center text-sm flex-shrink-0 <%= path === 'coupons' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Coupons</span>
            <% if (path === 'coupons') { %><span class="ml-auto w-1.5 h-1.5 rounded-full bg-cyan-400"></span><% } %>
        </a>

        <a href="/admin/sales-report" onclick="closeSidebarMobile()"
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'sales-report' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
            <i class="fas fa-chart-pie w-5 text-center text-sm flex-shrink-0 <%= path === 'sales-report' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Sales Reports</span>
            <% if (path === 'sales-report') { %><span class="ml-auto w-1.5 h-1.5 rounded-full bg-cyan-400"></span><% } %>
        </a>

        <a href="/admin/referrals" onclick="closeSidebarMobile()"
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'referrals' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
            <i class="fas fa-share-nodes w-5 text-center text-sm flex-shrink-0 <%= path === 'referrals' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Referrals</span>
            <% if (path === 'referrals') { %><span class="ml-auto w-1.5 h-1.5 rounded-full bg-cyan-400"></span><% } %>
