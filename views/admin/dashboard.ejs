<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neo-Luxe | Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #05070A; color: #E2E8F0; font-family: 'Inter', sans-serif; }
        .card-bg { background-color: #0B1120; border: 1px solid #1E293B; }
        .sidebar-bg { background-color: #05070A; border-right: 1px solid #1E293B; }
        
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: #05070A; }
        ::-webkit-scrollbar-thumb { background: #1E293B; border-radius: 10px; }

        /* Mobile Sidebar Toggle Logic */
        #sidebar.active { transform: translateX(0); }
    </style>
</head>
<body class="antialiased overflow-hidden">

    <div class="flex h-screen w-full relative">
        
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 sidebar-bg flex flex-col p-6 transform -translate-x-full transition-transform duration-300 ease-in-out lg:translate-x-0 lg:static lg:inset-0 shrink-0">
            <div class="flex justify-between items-center mb-10">
                <div>
                    <h1 class="text-xl font-bold tracking-widest text-white uppercase">Neo-Luxe</h1>
                    <p class="text-[10px] text-slate-500 uppercase tracking-tighter">Premium Watch Admin</p>
                </div>
                <button onclick="toggleSidebar()" class="lg:hidden text-slate-400">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <nav class="flex-1 space-y-1 overflow-y-auto">
                <a href="/admin/dashboard" class="flex items-center space-x-3 p-3 rounded-lg transition bg-cyan-500/10 text-cyan-400 border-r-2 border-cyan-500">
                    <i class="fas fa-th-large w-5"></i> 
                    <span class="text-sm font-medium">Dashboard</span>
                </a>
                <a href="/admin/customers" class="flex items-center space-x-3 p-3 rounded-lg transition text-slate-400 hover:bg-slate-800/50 hover:text-white">
                    <i class="fas fa-users w-5"></i> 
                    <span class="text-sm font-medium">Customers</span>
                </a>
                <!-- <a href="#" class="flex items-center space-x-3 p-3 rounded-lg transition text-slate-400 hover:bg-slate-800/50 hover:text-white">
                    <i class="fas fa-clock w-5"></i> 
                    <span class="text-sm font-medium">Watches</span>
                </a> -->
            </nav>

          <div class="mt-auto pt-6 border-t border-slate-800">
    <form action="/admin/logout" method="POST">
        <button type="submit" class="w-full flex items-center space-x-3 text-slate-500 hover:text-red-400 transition p-3">
            <i class="fas fa-sign-out-alt w-5"></i> 
            <span class="text-sm font-medium">Logout</span>
        </button>
    </form>
</div>
        </aside>

        <main class="flex-1 overflow-y-auto p-4 md:p-8">
            <div class="max-w-7xl mx-auto">
                
                <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
                    <div class="flex items-center gap-4">
                        <button onclick="toggleSidebar()" class="lg:hidden text-white bg-slate-800 p-2 rounded-lg">
                            <i class="fas fa-bars"></i>
                        </button>
                        <div>
                            <h2 class="text-xl md:text-2xl font-bold text-white uppercase tracking-tight">Dashboard</h2>
                            <p class="text-slate-500 text-xs md:text-sm">Overview of premium inventory.</p>
                        </div>
                    </div>
                    <div class="flex bg-slate-900 rounded-full p-1 text-[10px] font-bold uppercase border border-slate-800 w-full md:w-auto justify-center">
                        <button class="bg-cyan-500 text-black px-4 py-2 rounded-full flex-1 md:flex-none">Today</button>
                        <button class="px-4 py-2 text-slate-400 flex-1 md:flex-none">Weekly</button>
                        <button class="px-4 py-2 text-slate-400 flex-1 md:flex-none">Monthly</button>
                    </div>
                </header>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
                    <div class="card-bg p-5 rounded-xl">
                        <div class="flex justify-between items-start mb-4">
                            <span class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Sales</span>
                            <i class="fas fa-wallet text-cyan-500 text-xs"></i>
                        </div>
                        <div class="text-xl font-bold text-white">₹12,45k</div>
                        <div class="text-[10px] text-cyan-500 mt-2 font-bold">+12%</div>
                    </div>
                    <div class="card-bg p-5 rounded-xl">
                        <div class="flex justify-between items-start mb-4">
                            <span class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Orders</span>
                            <i class="fas fa-shopping-cart text-cyan-500 text-xs"></i>
                        </div>
                        <div class="text-xl font-bold text-white">342</div>
                        <div class="text-[10px] text-cyan-500 mt-2 font-bold">+5%</div>
                    </div>
                    </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                    <div class="lg:col-span-2 card-bg p-6 rounded-2xl">
                        <div class="flex justify-between mb-6">
                            <h3 class="font-bold text-sm uppercase">Revenue Trend</h3>
                            <span class="text-cyan-400 font-bold text-lg">₹45,000</span>
                        </div>
                        <div class="h-48 md:h-64">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>
                    
                    <div class="card-bg p-6 rounded-2xl">
                        <h3 class="font-bold text-sm uppercase mb-4">Sales by Colors</h3>
                        <div class="h-48 relative flex justify-center">
                            <canvas id="colorChart"></canvas>
                            <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                                <span class="text-xl font-bold text-white">1,240</span>
                                <span class="text-[9px] text-slate-500 uppercase">Units</span>
                            </div>
                        </div>
                        <div class="mt-6 space-y-2 text-[10px] uppercase font-bold text-slate-400">
                            <div class="flex justify-between"><span>Black</span> <span>40%</span></div>
                            <div class="flex justify-between"><span>Silver</span> <span>25%</span></div>
                        </div>
                    </div>
                </div>

                <section class="card-bg rounded-2xl overflow-hidden mb-8">
                    <div class="p-6 flex justify-between items-center border-b border-slate-800">
                        <h3 class="font-bold text-sm uppercase">Recent Orders</h3>
                        <button class="text-cyan-500 text-[10px] font-bold uppercase hover:underline">View All</button>
                    </div>
                    <div class="overflow-x-auto w-full">
                        <table class="w-full text-left text-xs min-w-[600px]">
                            <thead class="text-slate-500 text-[10px] uppercase border-b border-slate-800 bg-slate-900/30">
                                <tr>
                                    <th class="px-6 py-4">Order ID</th>
                                    <th class="px-6 py-4">Customer</th>
                                    <th class="px-6 py-4">Watch Model</th>
                                    <th class="px-6 py-4">Amount</th>
                                    <th class="px-6 py-4">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800">
                                <tr class="hover:bg-slate-800/30 transition">
                                    <td class="px-6 py-4 text-slate-400">#ORD-7321</td>
                                    <td class="px-6 py-4 text-white font-medium">Arjun Kapoor</td>
                                    <td class="px-6 py-4 text-slate-400">Rolex Submariner</td>
                                    <td class="px-6 py-4 font-bold text-white">₹9,50,000</td>
                                    <td class="px-6 py-4"><span class="bg-cyan-900/30 text-cyan-400 px-3 py-1 rounded text-[9px] font-bold border border-cyan-500/20">PAID</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <footer class="text-center pb-8">
                    <p class="text-[9px] text-slate-600 uppercase tracking-widest">© 2024 NEO-LUXE ADMIN. ALL RIGHTS RESERVED.</p>
                </footer>
            </div>
        </main>
    </div>

    <script>
        // Sidebar Toggle for Mobile
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('-translate-x-full');
        }

        // --- Charts (Updated with Responsive logic) ---
        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        const gradient = ctxRev.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(34, 211, 238, 0.2)');
        gradient.addColorStop(1, 'rgba(34, 211, 238, 0)');

        new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    data: [15, 22, 28, 32, 12, 28, 48],
                    borderColor: '#22D3EE',
                    borderWidth: 3,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { display: false },
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10 } } }
                }
            }
        });

        const ctxCol = document.getElementById('colorChart').getContext('2d');
        new Chart(ctxCol, {
            type: 'doughnut',
            data: {
                datasets: [{
                    data: [40, 25, 20, 15],
                    backgroundColor: ['#22D3EE', '#3B82F6', '#1E293B', '#0EA5E9'],
                    borderWidth: 0,
                    cutout: '80%'
                }]
            },
            options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });
    </script>
</body>
</html>