<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Neo-Luxe | My Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Inter", sans-serif;
      }
      .active-nav-item {
        background: linear-gradient(
          90deg,
          rgba(0, 163, 255, 0.1) 0%,
          rgba(0, 163, 255, 0.02) 100%
        );
        border-right: 2px solid #00a3ff;
        color: #00a3ff;
      }
    </style>
  </head>
  <body class="bg-[#05080d] text-white min-h-screen flex flex-col">
    <main class="max-w-7xl mx-auto w-full px-6 py-8 flex-grow">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <%- include('../partials/profileSidebar') %>

        <div class="lg:col-span-9 space-y-8">
          <div
            class="bg-[#0a0f18] rounded-3xl border border-gray-800 p-8 flex flex-col md:flex-row items-center gap-8 relative overflow-hidden"
          >
  <div class="relative group">
    <img id="profile-preview"
         src="<%= (user.profilePhoto && user.profilePhoto.url) ? user.profilePhoto.url : '/images/default-user.png' %>"
         class="w-32 h-32 rounded-full border-2 border-[#00a3ff] object-cover transition-opacity duration-300">
    
    <div id="upload-loader" class="hidden absolute inset-0 items-center justify-center bg-black/60 rounded-full">
        <div class="w-6 h-6 border-2 border-[#00a3ff] border-t-transparent animate-spin rounded-full"></div>
    </div>

    <input type="file" id="profile-input" class="hidden" accept="image/*">

    <div class="absolute -bottom-1 -right-2 flex gap-1">
        <button type="button" id="upload-btn" class="bg-[#00a3ff] p-2 rounded-full border-4 border-[#0a0f18] hover:scale-110 transition shadow-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" stroke-width="2"></path>
                <path d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" stroke-width="2"></path>
            </svg>
        </button>

        <button type="button" id="remove-btn" 
                class="bg-red-500 p-2 rounded-full border-4 border-[#0a0f18] hover:scale-110 transition shadow-lg <%= (!user.profilePhoto || !user.profilePhoto.url) ? 'hidden' : '' %>">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
        </button>
    </div>
</div>
           <div>
  <h2 class="text-3xl font-bold mb-1"><%= user.name %></h2>

</div>
          </div>

          <div class="bg-[#0a0f18] rounded-3xl border border-gray-800 p-8">
            <div class="flex items-center gap-4 mb-8">
              <div class="bg-cyan-500/10 p-2 rounded-lg text-cyan-500">
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"
                    stroke-width="2"
                  ></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold">Personal Information</h3>
            </div>

            <form class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="space-y-2">
    <label class="text-[10px] uppercase tracking-widest text-gray-500 font-bold">Full Name</label>
    <div class="relative">
      <input
        type="text"
        value="<%= user.name %>"
        readonly
        class="w-full bg-[#111827] border border-gray-800 rounded-xl py-3 px-4 text-sm outline-none cursor-default text-gray-300"
      />
      <svg
        class="w-4 h-4 absolute right-4 top-3.5 text-gray-600"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          stroke-width="2"
        ></path>
      </svg>
    </div>
  </div>

  <div class="space-y-2">
    <label class="text-[10px] uppercase tracking-widest text-gray-500 font-bold">Email Address</label>
    <div class="relative">
      <input
        type="email"
        value="<%= user.email %>"
        readonly
        class="w-full bg-[#111827] border border-gray-800 rounded-xl py-3 px-4 text-sm outline-none cursor-default text-gray-300"
      />
      <svg
        class="w-4 h-4 absolute right-4 top-3.5 text-gray-600"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          stroke-width="2"
        ></path>
      </svg>
    </div>
  </div>

  <div class="space-y-2 md:col-span-2 max-w-sm">
    <label class="text-[10px] uppercase tracking-widest text-gray-500 font-bold">Phone Number</label>
    <div class="relative">
      <input
        type="text"
        value="<%= user.phone ? user.phone : 'Not provided' %>"
        readonly
        class="w-full bg-[#111827] border border-gray-800 rounded-xl py-3 px-4 text-sm outline-none cursor-default text-gray-300"
      />
      <svg
        class="w-4 h-4 absolute right-4 top-3.5 text-gray-600"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          stroke-width="2"
        ></path>
      </svg>
    </div>
  </div>

  <div class="md:col-span-2 flex flex-wrap gap-4 pt-6">
    <a href="/editprofile">
      <button
        type="button"
        class="bg-transparent border border-gray-700 hover:bg-gray-800 px-8 py-3 rounded-full text-xs font-bold uppercase tracking-widest transition flex items-center gap-2"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
            stroke-width="2"
          ></path>
        </svg>
        Edit Profile
      </button>
    </a>
    <a href="/profile/change-email">
      <button
        type="button"
        class="bg-cyan-500 text-white px-8 py-3 rounded-full text-xs font-bold uppercase tracking-widest transition hover:bg-cyan-600 shadow-lg shadow-cyan-500/20"
      >
        Change Email
      </button>
    </a>
    <a href="/profile/change-password">
      <button
        type="button"
        class="bg-cyan-500 text-white px-8 py-3 rounded-full text-xs font-bold uppercase tracking-widest transition hover:bg-cyan-600 shadow-lg shadow-cyan-500/20 flex items-center gap-2"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            stroke-width="2"
          ></path>
        </svg>
        Change Password
      </button>
    </a>
  </div>
</form>
          </div>
        </div>
      </div>
    </main>
  <script>
    const uploadBtn = document.getElementById("upload-btn");
    const removeBtn = document.getElementById("remove-btn");
    const input = document.getElementById("profile-input");
    const preview = document.getElementById("profile-preview");
    const loader = document.getElementById("upload-loader");
    // Find sidebar image to sync changes
    const sidebarImage = document.querySelector('aside img');

    // Open file selector
    uploadBtn.addEventListener("click", () => input.click());

    // Handle Image Upload
    input.addEventListener("change", async () => {
        if (!input.files[0]) return;

        const formData = new FormData();
        formData.append("profilePhoto", input.files[0]);

        setLoading(true);

        try {
            const response = await fetch("/profile/upload-photo", { 
                method: "POST", 
                body: formData 
            });
            const result = await response.json();

            if (result.success) {
                // Update Main Preview
                preview.src = result.imageUrl;
                // Update Sidebar Preview if it exists
                if (sidebarImage) sidebarImage.src = result.imageUrl;
                
                removeBtn.classList.remove('hidden');
            } else {
                alert(result.message || "Upload failed");
            }
        } catch (err) {
            console.error("Upload error:", err);
            alert("An error occurred during upload.");
        } finally {
            setLoading(false);
            input.value = ""; // Clear input so change event triggers next time
        }
    });

    // Handle Image Removal
    removeBtn.addEventListener("click", async () => {
        if (!confirm("Are you sure you want to remove your profile picture?")) return;

        setLoading(true);

        try {
            const response = await fetch("/profile/remove-photo", { method: "DELETE" });
            const result = await response.json();

            if (result.success) {
                const defaultAvatar = '/images/default-user.png';
                preview.src = defaultAvatar;
                if (sidebarImage) sidebarImage.src = defaultAvatar;
                
                removeBtn.classList.add('hidden');
            } else {
                alert("Failed to remove image");
            }
        } catch (err) {
            console.error("Remove error:", err);
            alert("An error occurred.");
        } finally {
            setLoading(false);
        }
    });

    // Helper to handle UI state
    function setLoading(isLoading) {
        if (isLoading) {
            preview.classList.add("opacity-50");
            loader.classList.remove("hidden");
            loader.classList.add("flex");
        } else {
            preview.classList.remove("opacity-50");
            loader.classList.add("hidden");
            loader.classList.remove("flex");
        }
        uploadBtn.disabled = isLoading;
        removeBtn.disabled = isLoading;
    }
</script>
  </body>
</html>
