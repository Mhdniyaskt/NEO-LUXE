            <i class="fas fa-boxes-stacked w-5 text-center text-sm flex-shrink-0 <%= path === 'stock' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Stock</span>
