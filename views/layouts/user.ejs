<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Neo-Luxe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    body { font-family: 'Inter', sans-serif; background: #05080d; color: #fff; }
    .active-nav-item {
      background: linear-gradient(90deg, rgba(0,163,255,0.1) 0%, rgba(0,163,255,0.02) 100%);
      border-right: 2px solid #00a3ff;
      color: #00a3ff;
    }
  </style>
</head>
<body class="bg-[#05080d] text-white min-h-screen flex flex-col" data-logged-in="<%= locals.isLoggedIn ? 'true' : 'false' %>">

  <%- include('../partials/user-header') %>

  <%- body %>

  <%- include('../partials/user-footer') %>

  <!-- ── Global cart toast ──────────────────────────────────────────── -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <div id="cartToast"
       class="fixed bottom-6 right-6 z-[999] flex items-center gap-3 px-5 py-3.5
              bg-[#0f1526] border rounded-2xl shadow-2xl text-sm
              transition-all duration-300 translate-y-4 opacity-0 pointer-events-none"
       style="min-width:260px">
    <span id="cartToastIcon" class="text-lg flex-shrink-0"></span>
    <span id="cartToastMsg" class="text-slate-200 font-medium"></span>
  </div>

  <!-- ── Shared add-to-cart helper (available on every user page) ───── -->
  <script>
    // ── Wishlist toggle (available on every user page) ────────────────
    // Seed initial wishlisted variant IDs from server on page load
    const _wishlistedIds = new Set();

    (async () => {
      const loggedIn = document.body.dataset.loggedIn === 'true';
      if (!loggedIn) return;
      try {
        const res  = await fetch('/user/wishlist/ids');
        const data = await res.json();
        (data.ids || []).forEach(id => _wishlistedIds.add(id));
        // Apply filled-heart state to any wishlist buttons already on the page
        document.querySelectorAll('[data-wishlist-btn]').forEach(btn => {
          const vid = btn.dataset.variantId;
          if (_wishlistedIds.has(vid)) _setWishlistActive(btn, true);
        });
      } catch { /* non-fatal */ }
    })();

    function _setWishlistActive(btn, active) {
      const svg = btn.querySelector('svg');
      if (!svg) return;
      if (active) {
        svg.setAttribute('fill', '#f43f5e');
        svg.setAttribute('stroke', '#f43f5e');
        btn.title = 'Remove from wishlist';
      } else {
        svg.setAttribute('fill', 'none');
        svg.setAttribute('stroke', 'currentColor');
        btn.title = 'Add to wishlist';
      }
    }

    async function toggleWishlist(btn, productId, variantId) {
      const loggedIn = document.body.dataset.loggedIn === 'true';
      if (!loggedIn) {
        Swal.fire({
          icon: 'info', title: 'Login Required',
          text: 'Please login to save items to your wishlist.',
          showCancelButton: true, confirmButtonText: 'Login',
          cancelButtonText: 'Continue Browsing',
          confirmButtonColor: '#06b6d4', cancelButtonColor: '#1e2640',
          background: '#0f1526', color: '#e2e8f0',
        }).then(r => { if (r.isConfirmed) window.location.href = '/login'; });
        return;
      }

      btn.disabled = true;
      try {
        const res  = await fetch('/user/wishlist/toggle', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ productId, variantId }),
        });
        const data = await res.json();

        if (data.success) {
          if (data.wishlisted) {
            _wishlistedIds.add(variantId);
          } else {
            _wishlistedIds.delete(variantId);
          }
          _setWishlistActive(btn, data.wishlisted);

          // Update header badge
          document.querySelectorAll('[data-wishlist-count]').forEach(el => {
            const n = Math.max(0, parseInt(el.textContent || '0') + (data.wishlisted ? 1 : -1));
            el.textContent = n;
            el.classList.toggle('hidden', n === 0);
          });

          _showCartToast(data.message, true);
        } else {
          _showCartToast(data.message, false);
        }
      } catch {
        _showCartToast('Something went wrong. Please try again.', false);
      } finally {
        btn.disabled = false;
      }
    }
    // Show bottom-right toast
    function _showCartToast(msg, ok) {
      const toast   = document.getElementById('cartToast');
      const iconEl  = document.getElementById('cartToastIcon');
      const msgEl   = document.getElementById('cartToastMsg');

      iconEl.textContent = ok ? '✓' : '✕';
      iconEl.className   = ok ? 'text-green-400 text-lg flex-shrink-0'
                               : 'text-red-400 text-lg flex-shrink-0';
      msgEl.textContent  = msg;

      // Border colour
      toast.classList.remove('border-green-500/30', 'border-red-500/30', 'border-[#1e2640]');
      toast.classList.add(ok ? 'border-green-500/30' : 'border-red-500/30');

      // Animate in
      toast.classList.remove('translate-y-4', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      clearTimeout(window._cartToastTimer);
      window._cartToastTimer = setTimeout(() => {
        toast.classList.add('translate-y-4', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3000);
    }

    /**
     * addToCart(btn, productId, variantId, quantity = 1)
     *  - btn        : the button element (used for loading state)
     *  - productId  : product _id string
     *  - variantId  : variant _id string
     *  - quantity   : units to add (default 1; product detail page passes its stepper value)
     */
    async function addToCart(btn, productId, variantId, quantity = 1) {
      // ── 1. Client-side login guard ──────────────────────────────────
      const loggedIn = document.body.dataset.loggedIn === 'true';
      if (!loggedIn) {
        Swal.fire({
          icon:              'info',
          title:             'Login Required',
          text:              'Please login to add items to your cart.',
          showCancelButton:  true,
          confirmButtonText: 'Login',
          cancelButtonText:  'Continue Browsing',
          confirmButtonColor:'#06b6d4',
          cancelButtonColor: '#1e2640',
          background:        '#0f1526',
          color:             '#e2e8f0',
        }).then(r => { if (r.isConfirmed) window.location.href = '/login'; });
        return;
      }

      // ── 2. Loading state ────────────────────────────────────────────
      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
      </svg>`;

      try {
        const res  = await fetch('/cart/add', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ productId, variantId, quantity }),
        });

        // ── 3. Not logged in (server-side check) ──────────────────────
        if (res.status === 401) {
          Swal.fire({
            icon:              'info',
            title:             'Session Expired',
            text:              'Your session has ended. Please login to continue.',
            showCancelButton:  true,
            confirmButtonText: 'Login',
            cancelButtonText:  'Cancel',
            confirmButtonColor:'#06b6d4',
            cancelButtonColor: '#1e2640',
            background:        '#0f1526',
            color:             '#e2e8f0',
          }).then(r => { if (r.isConfirmed) window.location.href = '/login'; });
          btn.disabled  = false;
          btn.innerHTML = originalHTML;
          return;
        }

        const data = await res.json();

        // ── 4. Blocked item — disable button and show inline message ──
        const blockedMessages = [
          'product is unavailable',
          'category is unlisted',
          'variant not found or unavailable',
          'variant is',
        ];
        const isBlocked = !data.success &&
          blockedMessages.some(m => data.message?.toLowerCase().includes(m));

        if (isBlocked) {
          // Permanently disable the button with a visual indicator
          btn.disabled   = true;
          btn.innerHTML  = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636"/>
          </svg>`;
          btn.title      = data.message;
          btn.classList.remove(
            'bg-cyan-400','hover:bg-cyan-300','text-[#0a0e1a]',
            'hover:text-cyan-400','hover:border-cyan-400','hover:bg-cyan-400/5'
          );
          btn.classList.add('bg-red-500/10','text-red-400','border-red-500/30','cursor-not-allowed');

          _showCartToast(data.message + ' — this item is no longer available.', false);

          // If on the product detail page, show an inline banner too
          const detailMain = document.querySelector('main.min-h-screen');
          if (detailMain && !document.getElementById('unavailable-banner')) {
            const banner = document.createElement('div');
            banner.id = 'unavailable-banner';
            banner.className = 'fixed top-20 left-1/2 -translate-x-1/2 z-50 w-full max-w-lg px-4';
            banner.innerHTML = `
              <div class="bg-red-500/10 border border-red-500/30 rounded-2xl px-5 py-4
                          flex items-start gap-3 shadow-2xl backdrop-blur-md">
                <svg class="w-5 h-5 text-red-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd"
                        d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                        clip-rule="evenodd"/>
                </svg>
                <div class="flex-1">
                  <p class="text-red-300 font-semibold text-sm">Item Unavailable</p>
                  <p class="text-slate-400 text-xs mt-0.5">${data.message}</p>
                </div>
                <a href="/shop"
                   class="text-xs text-cyan-400 font-semibold hover:underline flex-shrink-0 mt-0.5">
                  Browse Shop →
                </a>
              </div>`;
            document.body.appendChild(banner);
          }
          return;
        }

        // ── 5. Show result toast ──────────────────────────────────────
        _showCartToast(data.message, data.success);

        // ── 6. Update cart badge + dispatch event on success ──────────
        if (data.success) {
          if (data.cartCount !== undefined) {
            document.querySelectorAll('[data-cart-count]').forEach(el => {
              el.textContent = data.cartCount;
              el.classList.toggle('hidden', data.cartCount === 0);
            });
          }

          // Dispatch cartAdded — synchronous listeners (e.g. product-details page)
          // can set a custom button state. We check afterwards whether a listener
          // already handled the button before deciding to restore it.
          btn._cartHandled = false;
          btn.dispatchEvent(new CustomEvent('cartAdded', {
            bubbles: true,
            detail: { cartCount: data.cartCount, newQty: data.newQty, alreadyInCart: data.alreadyInCart },
          }));

          // Only restore to original if no listener claimed the button
          if (!btn._cartHandled) {
            btn.disabled  = false;
            btn.innerHTML = originalHTML;
          }
        } else {
          // Failure — always restore button
          btn.disabled  = false;
          btn.innerHTML = originalHTML;
        }

      } catch {
        _showCartToast('Something went wrong. Please try again.', false);
        btn.disabled  = false;
        btn.innerHTML = originalHTML;
      }
    }
  </script>

  <!-- ✅ Back button fix -->
  <script>
    window.addEventListener("pageshow", function (event) {
      if (event.persisted) {
        window.location.reload();
      }
    });
  </script>

</body>
</html>