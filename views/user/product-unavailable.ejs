<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> — Unavailable | Neo-Luxe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    body { background: #0a0e1a; font-family: 'DM Sans', sans-serif; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
    .fade-up { animation: fadeUp .45s ease both; }
  </style>
</head>
<body class="text-slate-200 min-h-screen flex flex-col">

  <main class="flex-1 flex items-center justify-center px-4 py-20">
    <div class="max-w-lg w-full text-center fade-up">

      <!-- Icon -->
      <div class="w-24 h-24 mx-auto mb-8 rounded-3xl bg-[#0f1526] border border-red-500/20
                  flex items-center justify-center shadow-lg shadow-red-500/5">
        <svg class="w-12 h-12 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
        </svg>
      </div>

      <!-- Product name -->
      <p class="text-[11px] text-slate-500 uppercase tracking-[0.25em] font-semibold mb-3">
        Product Unavailable
      </p>
      <h1 style="font-family:'Playfair Display',serif"
          class="text-3xl font-bold text-white mb-4 leading-snug">
        <%= product.name %>
      </h1>

      <!-- Reason banner -->
      <div class="bg-red-500/10 border border-red-500/25 rounded-2xl px-6 py-4 mb-8 text-left">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-red-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd"
                  d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                  clip-rule="evenodd"/>
          </svg>
          <div>
            <p class="text-red-300 font-semibold text-sm mb-0.5">Why am I seeing this?</p>
            <p class="text-slate-400 text-sm leading-relaxed"><%= reason %></p>
          </div>
        </div>
      </div>

      <!-- Product thumbnail if available -->
      <%
        const thumbUrl = (() => {
          try {
            // product.variants is not populated here, skip
            return null;
          } catch(e) { return null; }
        })();
      %>

      <!-- Actions -->
      <div class="flex justify-center">
        <a href="/shop"
           class="flex items-center justify-center gap-2 bg-cyan-400 text-[#0a0e1a]
                  font-bold text-sm px-8 py-3.5 rounded-xl hover:bg-cyan-300 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          Browse Other Watches
        </a>
      </div>

      <!-- Subtle help text -->
      <p class="text-slate-600 text-xs mt-8">
        If you believe this is a mistake, please contact our support team.
      </p>

    </div>
  </main>

  <footer class="py-8 border-t border-white/5 text-center">
    <p class="text-slate-700 text-xs">&copy; 2026 Neo-Luxe Premium Horology. All rights reserved.</p>
  </footer>

</body>
</html>
