<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> | Premium Timepieces</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    body { background:#0a0e1a; margin: 0; padding: 0; }
    .zoom-wrap { overflow:hidden; cursor:zoom-in; position:relative; }
    .zoom-wrap img { transition:transform .3s ease; transform-origin:var(--ox,50%) var(--oy,50%); pointer-events:none; user-select:none; }
    .zoom-wrap.zoomed { cursor:zoom-out; }
    .zoom-wrap.zoomed img { transform:scale(2.2); }
    .tab-btn { border-bottom:2px solid transparent; transition:.18s; }
    .tab-btn.active { color:#00d4ff; border-color:#00d4ff; }
    .swatch { width:28px; height:28px; border-radius:50%; border:2px solid transparent; cursor:pointer; transition:.15s; flex-shrink:0; }
    .swatch.active { border-color:#00d4ff; box-shadow:0 0 0 2px #0a0e1a, 0 0 0 4px #00d4ff; }
    .thumb { opacity:.55; border:2px solid transparent; border-radius:10px; cursor:pointer; transition:.18s; }
    .thumb.active, .thumb:hover { opacity:1; border-color:#00d4ff; }
    .spec-row:nth-child(odd)  { background:#161d30; }
    .spec-row:nth-child(even) { background:#0f1526; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
    .fade-up { animation:fadeUp .32s ease both; }

    
  </style>
</head>

<body class="text-slate-200" style="font-family:'DM Sans', sans-serif;">

  <header class="w-full border-b border-[#1e2640] py-4 bg-[#0a0e1a]">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
      <div class="text-xl font-bold tracking-tighter text-white">CHRONOS</div>
      <div class="flex gap-6 items-center">
        <a href="/shop" class="text-sm hover:text-cyan-400 transition">Shop</a>
        <div class="relative">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            <span data-cart-count class="absolute -top-2 -right-2 bg-cyan-400 text-[#0a0e1a] text-[10px] font-bold px-1.5 rounded-full">0</span>
        </div>
      </div>
    </div>
  </header>

  <main class="min-h-screen pb-20 mt-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

      <nav class="text-xs text-slate-500 py-3 uppercase tracking-widest">
        <a href="/" class="hover:text-slate-300 transition">Home</a> /
        <a href="/shop" class="hover:text-slate-300 transition">Shop</a> /
        <span class="text-slate-300"> <%= product.name %></span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 py-4 fade-up">

        <div>
          <div id="zoomBox" class="zoom-wrap bg-[#0f1526] border border-[#1e2640] rounded-2xl aspect-square flex items-center justify-center mb-4 relative" onclick="handleZoom(event,this)">
            <% if (defaultVariant.stock === 0) { %>
              <span class="absolute top-3 left-3 bg-red-500/90 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase z-10 tracking-wider">Out of Stock</span>
            <% } else { %>
              <span class="absolute top-3 left-3 bg-cyan-400 text-[#0a0e1a] text-[10px] font-bold px-3 py-1 rounded-full uppercase z-10 tracking-wider">New Arrival</span>
            <% } %>

            <% if (defaultVariant.images && defaultVariant.images.length) { %>
              <img id="mainImg" src="<%= defaultVariant.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-contain p-6" />
            <% } else { %>
              <div class="text-slate-600 text-sm">No image available</div>
            <% } %>

            <span id="zoomHint" class="absolute bottom-3 right-3 text-[10px] text-slate-500 flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              Click to zoom
            </span>
          </div>

          <div class="flex gap-3" id="thumbRow">
            <% if (defaultVariant.images) { %>
              <% defaultVariant.images.slice(0,4).forEach((img, i) => { %>
                <div class="thumb w-20 h-20 bg-[#0f1526] border border-[#1e2640] rounded-xl overflow-hidden flex-shrink-0 <%= i===0?'active':'' %>" onclick="switchImg(this,'<%= img %>')">
                  <img src="<%= img %>" class="w-full h-full object-cover" loading="lazy" />
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <div class="flex flex-col gap-5">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h1 style="font-family:'Playfair Display',serif; font-size:1.85rem; font-weight:700; color:#fff; line-height:1.2">
                <%= product.name %>
              </h1>
              <p class="text-slate-400 text-sm mt-1.5"><%= product.description || 'Elegant automatic timepiece for the modern professional.' %></p>
            </div>
            <button class="text-slate-500 hover:text-cyan-400 transition mt-1" title="Share">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
            </button>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <div class="flex">
              <% for (let i=1;i<=5;i++) { %>
                <svg class="w-4 h-4 <%= i<=Math.round(product.rating||4)?'text-yellow-400':'text-slate-700' %>" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <% } %>
            </div>
            <span class="text-slate-400 text-xs">(<%= product.reviewCount||124 %> Reviews)</span>
            <% if (defaultVariant.stock === 0) { %>
              <span class="text-[10px] bg-red-500/20 text-red-400 border border-red-500/30 px-2 py-0.5 rounded-full font-semibold">Out of Stock</span>
            <% } else if (defaultVariant.stock <= 5) { %>
              <span class="text-[10px] bg-amber-500/20 text-amber-400 border border-amber-500/30 px-2 py-0.5 rounded-full font-semibold">Only <%= defaultVariant.stock %> left</span>
            <% } else { %>
              <span class="text-[10px] bg-green-500/20 text-green-400 border border-green-500/30 px-2 py-0.5 rounded-full font-semibold">In Stock</span>
            <% } %>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-3xl font-bold text-white">₹<%= defaultVariant.finalPrice.toLocaleString('en-IN') %></span>
            <% if (defaultVariant.appliedOffer > 0) { %>
              <span class="text-slate-500 line-through text-lg">₹<%= defaultVariant.basePrice.toLocaleString('en-IN') %></span>
              <span class="bg-red-500/20 text-red-400 text-xs font-bold px-2 py-1 rounded-md">-<%= defaultVariant.appliedOffer %>% OFF</span>
            <% } %>
          </div>

          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-2">Color: <span class="text-white"><%= defaultVariant.color||'Silver Elite' %></span></p>
     <div class="flex gap-2">
  <% variants.forEach((v, i) => { 
    const swatchColor = v.colorHex || (i === 0 ? '#e0e0e0' : i === 1 ? '#d4a017' : '#1e3a5f');
    const isActive = v._id.toString() === defaultVariant._id.toString();
  %>
    <a href="/shop/<%= product._id %>?variantId=<%= v._id %>" 
       class="swatch <%= isActive ? 'active' : '' %>"
       title="<%= v.color || 'Variant ' + (i + 1) %>">
       
       <span class="block w-full h-full rounded-full" 
             data-swatch="<%= swatchColor %>"
             style="background-color: var(--bg-fallback, #1e2640);"
             onclick="this.style.backgroundColor='<%= swatchColor %>'"
             onmouseenter="this.style.backgroundColor='<%= swatchColor %>'"
             root-color="<%= swatchColor %>">
       </span>
    </a>
  <% }) %>
</div>
          </div>

          <div class="flex items-center gap-3 flex-wrap">
            <div class="flex items-center bg-[#161d30] border border-[#1e2640] rounded-xl overflow-hidden">
              <button onclick="adjustQty(-1)" class="px-4 py-3 text-slate-300 hover:text-white hover:bg-[#1e2640] transition">−</button>
              <input id="qtyInput" type="number" value="1" min="1" max="<%= Math.min(defaultVariant.stock||10,10) %>" class="w-12 text-center bg-transparent text-white text-sm focus:outline-none" />
              <button onclick="adjustQty(1)" class="px-4 py-3 text-slate-300 hover:text-white hover:bg-[#1e2640] transition">+</button>
            </div>

            <% if (defaultVariant.stock === 0) { %>
              <button disabled class="flex-1 py-3 rounded-xl bg-slate-700/60 text-slate-500 text-sm font-semibold cursor-not-allowed">Sold Out</button>
            <% } else { %>
              <form id="addCartForm" action="/cart/add" method="POST" class="flex-1">
                <input type="hidden" name="productId" value="<%= product._id %>" />
                <input type="hidden" name="variantId" value="<%= defaultVariant._id %>" />
                <input type="hidden" name="quantity" id="formQty" value="1" />
                <button type="submit" class="w-full py-3 rounded-xl bg-cyan-400 text-[#0a0e1a] font-semibold text-sm hover:bg-cyan-300 transition">Add to Cart</button>
              </form>
              <form action="/checkout/buy-now" method="POST">
                <input type="hidden" name="productId" value="<%= product._id %>" />
                <input type="hidden" name="variantId" value="<%= defaultVariant._id %>" />
                <button class="px-5 py-3 rounded-xl bg-[#1e2640] border border-[#252e47] text-slate-200 text-sm font-semibold hover:bg-[#252e47] transition">⚡ Buy Now</button>
              </form>
            <% } %>
          </div>

          <div class="bg-[#0f1526] border border-[#1e2640] rounded-xl p-4">
            <p class="text-xs font-semibold text-cyan-400 uppercase tracking-widest mb-3 flex items-center gap-2">Product Highlights</p>
            <div class="grid grid-cols-2 gap-y-3 gap-x-4 text-xs">
              <div><p class="text-slate-500 mb-0.5">Dial</p><p class="text-white font-medium"><%= defaultVariant.dial||'Sunburst Silver' %></p></div>
              <div><p class="text-slate-500 mb-0.5">Strap</p><p class="text-white font-medium"><%= defaultVariant.strapMaterial||'316L Stainless Steel' %></p></div>
              <div><p class="text-slate-500 mb-0.5">Water Resistance</p><p class="text-white font-medium"><%= product.waterResistance||'50m (5 ATM)' %></p></div>
              <div><p class="text-slate-500 mb-0.5">Warranty</p><p class="text-white font-medium"><%= product.warranty||'5 Years' %></p></div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-14 grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <div class="flex border-b border-[#1e2640] mb-6 gap-6">
            <button onclick="switchTab('specs',this)" class="tab-btn active pb-3 text-sm font-medium text-cyan-400">Specifications</button>
            <button onclick="switchTab('desc',this)" class="tab-btn pb-3 text-sm font-medium text-slate-500 hover:text-slate-300">Description</button>
            <button onclick="switchTab('reviews',this)" class="tab-btn pb-3 text-sm font-medium text-slate-500 hover:text-slate-300">Reviews (<%= product.reviewCount||124 %>)</button>
          </div>

          <div id="tab-specs">
            <h2 style="font-family:'Playfair Display',serif" class="text-xl font-bold text-white mb-4">Technical Specifications</h2>
            <div class="rounded-xl overflow-hidden border border-[#1e2640]">
              <% [
                ['Case Diameter', defaultVariant.caseDiameter || '42 mm'],
                ['Case Material', defaultVariant.caseMaterial || '316L Stainless Steel'],
                ['Strap Color', defaultVariant.strapColor || 'Brushed Silver'],
                ['Glass Type', product.glassType || 'Sapphire Crystal'],
                ['Weight', defaultVariant.weight || '145 g'],
                ['Country of Origin', product.countryOfOrigin || 'Switzerland'],
              ].forEach(([label, val]) => { %>
                <div class="spec-row flex px-5 py-3">
                  <span class="text-slate-400 text-sm w-48 flex-shrink-0"><%= label %></span>
                  <span class="text-white text-sm"><%= val %></span>
                </div>
              <% }) %>
            </div>
          </div>

          <div id="tab-desc" class="hidden">
            <h2 style="font-family:'Playfair Display',serif" class="text-xl font-bold text-white mb-4">Description</h2>
            <p class="text-slate-400 text-sm leading-relaxed"><%= product.longDescription || product.description %></p>
          </div>

          <div id="tab-reviews" class="hidden">
            <h2 style="font-family:'Playfair Display',serif" class="text-xl font-bold text-white mb-4">Customer Reviews</h2>
            <p class="text-slate-500 text-sm">No reviews yet. Be the first to review!</p>
          </div>
        </div>

        <div class="bg-[#0f1526] border border-[#1e2640] rounded-2xl p-6 text-center sticky top-10 h-fit">
          <h3 style="font-family:'Playfair Display',serif" class="text-lg font-bold text-white mb-2">Need help choosing?</h3>
          <p class="text-slate-400 text-xs mb-5">Our watch experts are available to guide you.</p>
          <a href="/support/chat" class="w-full py-3 rounded-xl bg-cyan-400 text-[#0a0e1a] font-semibold text-sm flex items-center justify-center hover:bg-cyan-300 transition">Chat with Expert</a>
        </div>
      </div>

    </div>
  </main>

  <footer class="py-10 border-t border-[#1e2640] text-center text-slate-500 text-xs">
    <p>&copy; 2026 Chronos Luxe. All rights reserved.</p>
  </footer>

  <div id="toast" class="fixed top-5 right-5 z-50 hidden">
    <div class="bg-[#0f1526] border border-[#1e2640] rounded-xl px-4 py-3 text-sm flex items-center gap-3 shadow-2xl">
      <span id="toastIcon"></span>
      <span id="toastMsg" class="text-slate-200"></span>
    </div>
  </div>

  <script>

    document.querySelectorAll('[data-swatch]').forEach(el => {
    el.style.backgroundColor = el.getAttribute('data-swatch');
  });
    function handleZoom(e, box) {
      const img = box.querySelector('img');
      if (!img) return;
      const rect = box.getBoundingClientRect();
      box.style.setProperty('--ox', ((e.clientX - rect.left) / rect.width * 100).toFixed(1) + '%');
      box.style.setProperty('--oy', ((e.clientY - rect.top) / rect.height * 100).toFixed(1) + '%');
      box.classList.toggle('zoomed');
      document.getElementById('zoomHint').textContent = box.classList.contains('zoomed') ? 'Click to zoom out' : 'Click to zoom';
    }

    function switchImg(el, src) {
      document.getElementById('mainImg').src = src;
      const box = document.getElementById('zoomBox');
      box.classList.remove('zoomed');
      document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
      el.classList.add('active');
    }

    function adjustQty(d) {
      const inp = document.getElementById('qtyInput');
      const fq = document.getElementById('formQty');
      let v = parseInt(inp.value) + d;
      v = Math.max(1, Math.min(parseInt(inp.max)||10, v));
      inp.value = v;
      if (fq) fq.value = v;
    }

    function switchTab(id, btn) {
      ['specs','desc','reviews'].forEach(t => document.getElementById('tab-'+t).classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active','text-cyan-400');
        b.classList.add('text-slate-500');
      });
      document.getElementById('tab-'+id).classList.remove('hidden');
      btn.classList.add('active','text-cyan-400');
      btn.classList.remove('text-slate-500');
    }

    const addCartForm = document.getElementById('addCartForm');
    if (addCartForm) {
      addCartForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(addCartForm);
        try {
          const res = await fetch('/cart/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(fd.entries())),
          });
          const data = await res.json();
          showToast(data.message, data.success);
          const badge = document.querySelector('[data-cart-count]');
          if (badge && data.cartCount !== undefined) badge.textContent = data.cartCount;
        } catch { showToast('Something went wrong', false); }
      });
    }

    function showToast(msg, ok=true) {
      const t = document.getElementById('toast');
      document.getElementById('toastMsg').textContent = msg;
      document.getElementById('toastIcon').textContent = ok ? '✓' : '✕';
      document.getElementById('toastIcon').className = ok ? 'text-green-400' : 'text-red-400';
      t.classList.remove('hidden');
      setTimeout(() => t.classList.add('hidden'), 2800);
    }
  </script>
</body>
</html>