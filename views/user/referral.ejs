<style>
  .active-nav-item {
    background: linear-gradient(90deg, rgba(0,163,255,0.1) 0%, rgba(0,163,255,0.02) 100%);
    border-right: 2px solid #00a3ff;
    color: #00a3ff;
  }
</style>

<div class="bg-[#05080d] min-h-screen px-6 py-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <%- include('../partials/profile-sidebar') %>

      <div class="lg:col-span-9 space-y-6">

        <!-- Header -->
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight">Refer & Earn</h1>
          <p class="text-slate-500 text-sm mt-1">Invite friends and earn exclusive rewards on your next luxury timepiece.</p>
        </div>

        <!-- Reward Banner -->
        <div class="bg-gradient-to-r from-cyan-500/10 to-transparent border border-cyan-500/20 rounded-2xl p-7 relative overflow-hidden">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_80%_50%,rgba(0,212,255,0.05),transparent_60%)] pointer-events-none"></div>
          <div class="relative">
            <p class="text-[10px] text-cyan-400 uppercase tracking-widest font-bold mb-2 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Referral Reward
            </p>
            <h2 class="text-3xl font-bold text-white mb-2">Earn ₹200 for every referral</h2>
            <p class="text-slate-400 text-sm max-w-lg leading-relaxed">
              Share your referral code with friends. When they sign up using your code, both of you get ₹200 credited to your wallet instantly.
            </p>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-5">
            <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-2 flex items-center gap-1">
              <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Total Referrals
            </p>
            <p class="text-2xl font-bold text-white"><%= totalReferrals %></p>
          </div>
          <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-5">
            <p class="text-[9px] text-slate-500 uppercase tracking-widest font-bold mb-2 flex items-center gap-1">
              <svg class="w-3 h-3 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Successful
            </p>
            <p class="text-2xl font-bold text-white"><%= successfulCount %></p>
          </div>
          <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-5">
            <p class="text-[9px] text-cyan-400 uppercase tracking-widest font-bold mb-2 flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 1v8m0 0v1"/>
              </svg>
              Rewards Earned
            </p>
            <p class="text-2xl font-bold text-cyan-400">₹<%= totalRewards.toLocaleString('en-IN') %></p>
          </div>
        </div>

        <!-- Referral Code -->
        <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl p-6">
          <h3 class="text-white font-bold text-sm mb-4">Your Referral Code</h3>
          <div class="flex gap-3">
            <div class="flex-1 bg-[#111827] border border-gray-700 rounded-xl py-3 px-5 font-mono text-cyan-400 text-lg font-bold tracking-widest select-all">
              <%= referralCode %>
            </div>
            <button onclick="copyCode()" id="copyBtn"
                    class="bg-cyan-400 hover:bg-cyan-300 text-[#05080d] font-bold text-sm px-6 rounded-xl transition flex items-center gap-2 flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
              </svg>
              Copy Code
            </button>
          </div>
          <p class="text-slate-600 text-xs mt-3">Share this code with friends. They enter it during signup to activate the reward.</p>
        </div>

        <!-- Referral History -->
        <div class="bg-[#0a0f18] border border-gray-800/70 rounded-2xl overflow-hidden">
          <div class="px-6 py-5 border-b border-gray-800/60">
            <h3 class="text-white font-bold text-sm">Referral History</h3>
          </div>
          <% if (referrals.length === 0) { %>
            <div class="py-16 text-center">
              <p class="text-slate-500 text-sm">No referrals yet. Share your code to start earning!</p>
            </div>
          <% } else { %>
            <div class="divide-y divide-gray-800/40">
              <% referrals.forEach(r => { %>
                <div class="px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-[10px] font-bold text-cyan-400">
                      <%= r.referred?.name ? r.referred.name.split(' ').map(n=>n[0]).join('').toUpperCase().slice(0,2) : '??' %>
                    </div>
                    <div>
                      <p class="text-white text-sm font-medium"><%= r.referred?.name || 'Unknown' %></p>
                      <p class="text-slate-500 text-[10px]">Joined <%= fmt.formatDateShort(r.createdAt) %></p>
                    </div>
                  </div>
                  <div class="text-right">
                    <span class="px-2.5 py-1 rounded text-[9px] font-black uppercase tracking-wider border
                      <%= r.status === 'completed' ? 'bg-green-500/10 text-green-400 border-green-500/20' : 'bg-amber-500/10 text-amber-400 border-amber-500/20' %>">
                      <%= r.status %>
                    </span>
                    <p class="text-green-400 text-xs font-bold mt-1">+₹<%= r.reward %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  function copyCode() {
    const code = '<%= referralCode %>';
    navigator.clipboard.writeText(code).then(() => {
      const btn = document.getElementById('copyBtn');
      btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => {
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg> Copy Code';
      }, 2000);
    });
  }
</script>
