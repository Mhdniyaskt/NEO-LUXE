<style>
  .active-nav-item {
    background: linear-gradient(90deg, rgba(0,163,255,0.1) 0%, rgba(0,163,255,0.02) 100%);
    border-right: 2px solid #00a3ff;
    color: #00a3ff;
  }
  .status-badge {
    display: inline-block; font-size: 10px; font-weight: 700;
    padding: 3px 10px; border-radius: 999px;
    text-transform: capitalize; letter-spacing: .05em;
  }
  .status-pending    { background:#f59e0b22; color:#f59e0b; border:1px solid #f59e0b44; }
  .status-confirmed  { background:#22c55e22; color:#22c55e; border:1px solid #22c55e44; }
  .status-processing { background:#3b82f622; color:#3b82f6; border:1px solid #3b82f644; }
  .status-shipped    { background:#8b5cf622; color:#8b5cf6; border:1px solid #8b5cf644; }
  .status-delivered  { background:#10b98122; color:#10b981; border:1px solid #10b98144; }
  .status-cancelled  { background:#ef444422; color:#ef4444; border:1px solid #ef444444; }
  .status-returned   { background:#6b728022; color:#6b7280; border:1px solid #6b728044; }
</style>

<div class="bg-[#05080d] min-h-screen px-6 py-8">
  <div class="max-w-7xl mx-auto">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-300 transition-colors">Home</a>
      <span class="text-slate-700">/</span>
      <a href="/profile" class="hover:text-slate-300 transition-colors">My Account</a>
      <span class="text-slate-700">/</span>
      <span class="text-cyan-400 font-medium">My Orders</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Sidebar -->
      <%- include('../partials/profile-sidebar') %>

      <!-- Main Content -->
      <div class="lg:col-span-9">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <h1 class="text-2xl font-bold text-white">Order History</h1>
          <div class="relative w-full sm:w-72">
            <input type="text" id="order-search" placeholder="Search by order ID or product…"
              class="w-full bg-[#0a0f18] border border-gray-800 rounded-xl py-2.5 pl-10 pr-4 text-sm text-slate-300 placeholder-slate-600 outline-none focus:border-cyan-500/50 transition"/>
            <svg class="w-4 h-4 text-slate-600 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
            </svg>
          </div>
        </div>

        <% if (!orders || orders.length === 0) { %>
          <div class="flex flex-col items-center justify-center py-32 text-center bg-[#0a0f18] rounded-3xl border border-gray-800">
            <div class="w-20 h-20 bg-[#111827] border border-gray-800 rounded-3xl flex items-center justify-center mb-6">
              <svg class="w-10 h-10 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
            <p class="text-white text-xl font-semibold mb-2">No orders yet</p>
            <p class="text-slate-500 text-sm mb-8">Your order history will appear here once you make a purchase.</p>
            <a href="/shop" class="bg-cyan-400 text-[#0a0e1a] font-bold text-sm px-8 py-3 rounded-xl hover:bg-cyan-300 transition">Start Shopping</a>
          </div>
        <% } else { %>
          <div id="orders-list" class="space-y-4">
            <% orders.forEach(order => { %>
              <div class="order-card bg-[#0a0f18] border border-gray-800 rounded-2xl p-5 hover:border-cyan-400/20 transition-all duration-300"
                   data-order-id="<%= order._id %>"
                   data-short-id="<%= (order.orderId || order._id.toString().slice(-8).toUpperCase()).toLowerCase() %>"
                   data-products="<%= order.items.length ? order.items.map(i => i.productName.toLowerCase()).join(' ') : '' %>">

                <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                  <div>
                    <p class="text-[10px] text-slate-500 uppercase tracking-widest mb-0.5">Order ID</p>
                    <p class="text-white font-mono text-xs font-semibold tracking-wide">
                      #<%= order.orderId || order._id.toString().slice(-8).toUpperCase() %>
                    </p>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="status-badge status-<%= order.status %>"><%= order.status %></span>
                    <p class="text-slate-500 text-[10px]">
                      <%= fmt.formatDateShort(order.createdAt) %>
                    </p>
                  </div>
                </div>

                <div class="flex gap-3 mb-4 flex-wrap items-center">
                  <% order.items.slice(0, 3).forEach(item => { %>
                    <div class="w-12 h-12 bg-[#111827] rounded-xl overflow-hidden border border-gray-800 flex-shrink-0">
                      <% if (item.imageUrl) { %>
                        <img src="<%= item.imageUrl %>" alt="<%= item.productName %>" class="w-full h-full object-cover"/>
                      <% } else { %>
                        <div class="w-full h-full flex items-center justify-center">
                          <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="1.5"/></svg>
                        </div>
                      <% } %>
                    </div>
                  <% }) %>
                  <% if (order.items.length > 3) { %>
                    <div class="w-12 h-12 bg-[#111827] rounded-xl border border-gray-800 flex items-center justify-center text-slate-500 text-xs font-bold">
                      +<%= order.items.length - 3 %>
                    </div>
                  <% } %>
                  <% if (order.items.length > 0) { %>
                  <div class="ml-1">
                    <p class="text-white text-sm font-semibold line-clamp-1">
                      <%= order.items[0].productName %><%= order.items.length > 1 ? ` +${order.items.length - 1} more` : '' %>
                    </p>
                    <p class="text-slate-500 text-xs mt-0.5">
                      Purchased on <%= fmt.formatDateShort(order.createdAt) %>
                    </p>
                  </div>
                  <% } %>
                </div>

                <div class="flex items-center justify-between pt-3 border-t border-gray-800/60">
                  <div>
                    <p class="text-[10px] text-slate-500 uppercase tracking-widest mb-0.5">
                      <%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : order.paymentMethod === 'wallet' ? 'Paid via Wallet' : 'Paid via Online' %>
                    </p>
                    <p class="text-cyan-400 font-bold text-lg">₹<%= order.total.toLocaleString('en-IN') %></p>
                  </div>
                  <a href="/orders/<%= order._id %>/details"
                     class="flex items-center gap-2 bg-cyan-400 hover:bg-cyan-300 text-[#0a0e1a] font-bold text-xs px-5 py-2.5 rounded-full transition-all duration-200">
                    View Details
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
          <div id="no-results" class="hidden text-center py-16 text-slate-500 text-sm">No orders match your search.</div>

          <!-- ── Pagination ──────────────────────────────────────────── -->
          <% if (totalPages > 1) { %>
            <div class="flex flex-wrap items-center justify-between gap-4 mt-6 pt-5 border-t border-gray-800/50">
              <!-- Info -->
              <p class="text-xs text-slate-500">
                Showing
                <span class="text-white font-semibold"><%= (currentPage - 1) * 4 + 1 %>–<%= Math.min(currentPage * 4, total) %></span>
                of <span class="text-white font-semibold"><%= total %></span> orders
              </p>

              <!-- Page buttons -->
              <div class="flex items-center gap-1.5">
                <!-- Prev -->
                <% if (currentPage > 1) { %>
                  <a href="/orders?page=<%= currentPage - 1 %>"
                     class="w-8 h-8 flex items-center justify-center rounded-lg border border-gray-700
                            text-slate-400 hover:text-white hover:border-gray-600 transition text-xs">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                  </a>
                <% } else { %>
                  <span class="w-8 h-8 flex items-center justify-center rounded-lg border border-gray-800 text-slate-700 text-xs cursor-not-allowed">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                  </span>
                <% } %>

                <!-- Page numbers (window of ±2) -->
                <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                  <a href="/orders?page=<%= i %>"
                     class="w-8 h-8 flex items-center justify-center rounded-lg border text-xs font-bold transition
                            <%= i === currentPage
                              ? 'bg-cyan-400 border-cyan-400 text-[#05080d]'
                              : 'border-gray-700 text-slate-400 hover:border-gray-600 hover:text-white' %>">
                    <%= i %>
                  </a>
                <% } %>

                <!-- Next -->
                <% if (currentPage < totalPages) { %>
                  <a href="/orders?page=<%= currentPage + 1 %>"
                     class="w-8 h-8 flex items-center justify-center rounded-lg border border-gray-700
                            text-slate-400 hover:text-white hover:border-gray-600 transition text-xs">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                <% } else { %>
                  <span class="w-8 h-8 flex items-center justify-center rounded-lg border border-gray-800 text-slate-700 text-xs cursor-not-allowed">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </span>
                <% } %>
              </div>
            </div>
          <% } %>

        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  const searchInput = document.getElementById('order-search');
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      const cards = document.querySelectorAll('.order-card');
      let visible = 0;
      cards.forEach(card => {
        const id      = card.dataset.orderId.toLowerCase();
        const shortId = card.dataset.shortId || '';
        const products = card.dataset.products || '';
        const match = !q || id.includes(q) || shortId.includes(q.replace('#','')) || products.includes(q);
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      const noResults = document.getElementById('no-results');
      if (noResults) noResults.classList.toggle('hidden', visible > 0);
    });
  }
</script>
