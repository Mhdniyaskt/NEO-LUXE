<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NEO-LUXE | Redefine Time</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Outfit','sans-serif'] },
          colors: { brand: { blue:'#00A3FF', dark:'#050507', card:'#0F1014' } }
        }
      }
    }
  </script>
  <style>
    .hero-glow { background: radial-gradient(circle, rgba(0,163,255,.15) 0%, transparent 70%); }
    .text-glow  { text-shadow: 0 0 24px rgba(0,163,255,.55); }
    @keyframes fadeUp { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }
    .fade-up { animation: fadeUp .5s ease both; }
    .card-hover { transition: transform .25s, border-color .25s, box-shadow .25s; }
    .card-hover:hover { transform: translateY(-5px); border-color:#00A3FF !important; box-shadow:0 0 20px rgba(0,163,255,.12); }
  </style>
</head>

<body class="bg-brand-dark text-white font-sans antialiased overflow-x-hidden">

  <!-- ══════════════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════════════ -->
  <header class="relative pt-32 pb-16 lg:pt-40 lg:pb-24 px-8 lg:px-20 max-w-7xl mx-auto
                 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

    <div class="z-10 space-y-6 fade-up">
      <span class="bg-gray-900 border border-gray-700 text-brand-blue text-[10px]
                   tracking-widest px-3 py-1 rounded uppercase font-semibold">
        Future of Horology
      </span>
      <h1 class="text-5xl lg:text-7xl font-bold leading-tight">
        Redefine <br>Time with <br>
        <span class="text-brand-blue text-glow">Precision.</span>
      </h1>
      <p class="text-gray-400 max-w-md font-light leading-relaxed">
        Experience the pinnacle of engineering with our neo-luxury collection —
        designed for the futuristic minimalist who values absolute chronometric integrity.
      </p>
      <div class="flex gap-4 pt-4 flex-wrap">
        <a href="/shop"
           class="bg-brand-blue hover:bg-blue-500 text-black font-semibold px-8 py-3 rounded
                  text-sm transition shadow-[0_0_15px_rgba(0,163,255,.4)] flex items-center gap-2">
          EXPLORE COLLECTION <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
      <% if (heroProduct) { %>
        <p class="text-xs text-gray-600 uppercase tracking-widest pt-2">
          Latest drop — <a href="/shop/<%= heroProduct._id %>" class="text-brand-blue hover:underline"><%= heroProduct.name %></a>
        </p>
      <% } %>
    </div>

    <!-- Hero image — first product image or SVG placeholder -->
    <div class="relative z-10 flex justify-center hero-glow rounded-full fade-up" style="animation-delay:.15s">
      <div class="absolute inset-0 bg-brand-blue blur-[100px] opacity-20 rounded-full scale-75"></div>
      <% if (heroImage) { %>
        <a href="<%= heroProduct ? '/shop/' + heroProduct._id : '/shop' %>">
          <img src="<%= heroImage %>"
               alt="<%= heroProduct ? heroProduct.name : 'Neo-Luxe Watch' %>"
               class="relative w-72 lg:w-[420px] drop-shadow-2xl hover:scale-105 transition duration-500
                      object-contain rounded-2xl">
        </a>
      <% } else { %>
        <div class="relative w-72 lg:w-[420px] aspect-square bg-[#0f1014] rounded-2xl border border-gray-800
                    flex items-center justify-center">
          <svg class="w-24 h-24 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" stroke-width="1.5"/>
            <path stroke-linecap="round" stroke-width="1.5" d="M12 7v5l3 3"/>
            <rect x="10" y="2" width="4" height="3" rx="1" stroke-width="1.5"/>
            <rect x="10" y="19" width="4" height="3" rx="1" stroke-width="1.5"/>
          </svg>
          <p class="absolute bottom-6 text-xs text-gray-600 uppercase tracking-widest">No products yet</p>
        </div>
      <% } %>
    </div>
  </header>

  <!-- ══════════════════════════════════════════════════════════════
       BRAND STRIP
  ══════════════════════════════════════════════════════════════ -->
  <section class="py-8 border-y border-gray-900 bg-black/50">
    <div class="flex flex-wrap justify-center gap-12 opacity-30 hover:opacity-60 transition duration-500">
      <span class="text-xl font-bold font-mono tracking-tighter">AETHER</span>
      <span class="text-xl font-serif font-bold tracking-widest">ZENITH</span>
      <span class="text-xl font-sans font-black italic">KINETIC</span>
      <span class="text-xl font-mono border-2 border-white px-1">VERTEX</span>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════
       BROWSE BY CATEGORY
  ══════════════════════════════════════════════════════════════ -->
  <section class="py-20 px-8 lg:px-20 max-w-7xl mx-auto">
    <div class="flex items-end justify-between mb-10">
      <h2 class="text-2xl font-bold">Browse by Category</h2>
      <a href="/shop" class="text-brand-blue text-xs font-bold uppercase tracking-wider hover:underline">
        All Collections <i class="fa-solid fa-arrow-right ml-1"></i>
      </a>
    </div>

    <% if (categories && categories.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% categories.forEach((cat, i) => { %>
          <a href="/shop?category=<%= cat._id %>"
             class="card-hover bg-brand-card p-8 rounded-2xl border border-transparent
                    relative overflow-hidden group block fade-up"
             style="animation-delay:<%= i * 0.07 %>s">
            <div class="h-44 flex items-center justify-center mb-6 overflow-hidden rounded-xl bg-black/30">
              <% if (cat.image) { %>
                <img src="<%= cat.image %>" alt="<%= cat.name %>"
                     class="h-full w-full object-cover group-hover:scale-110 transition duration-500 opacity-80">
              <% } else { %>
                <div class="flex flex-col items-center gap-2 text-gray-700">
                  <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" stroke-width="1.5"/>
                    <path stroke-linecap="round" stroke-width="1.5" d="M12 7v5l3 3"/>
                  </svg>
                  <span class="text-[10px] uppercase tracking-widest">No image</span>
                </div>
              <% } %>
            </div>
            <h3 class="text-lg font-bold mb-1"><%= cat.name %></h3>
            <% if (cat.description) { %>
              <p class="text-xs text-gray-500 mb-4 line-clamp-2"><%= cat.description %></p>
            <% } else { %>
              <p class="text-xs text-gray-500 mb-4">Explore the collection</p>
            <% } %>
            <span class="text-brand-blue text-xs font-bold tracking-wider uppercase
                         group-hover:text-white transition">
              Discover <i class="fa-solid fa-arrow-right ml-1"></i>
            </span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-20 border border-dashed border-gray-800 rounded-2xl">
        <p class="text-gray-600 text-sm">No categories available yet.</p>
      </div>
    <% } %>
  </section>

  <!-- ══════════════════════════════════════════════════════════════
       BEST SELLERS
  ══════════════════════════════════════════════════════════════ -->
  <section class="py-10 px-8 lg:px-20 max-w-7xl mx-auto">
    <div class="flex justify-between items-end mb-10">
      <div>
        <h2 class="text-2xl font-bold">Best Sellers</h2>
        <p class="text-xs text-gray-500 mt-1">Most coveted pieces in our collection.</p>
      </div>
      <a href="/shop" class="text-brand-blue text-xs font-bold uppercase tracking-wider hover:underline">
        VIEW ALL <i class="fa-solid fa-border-all ml-1"></i>
      </a>
    </div>

    <% if (bestSellers && bestSellers.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% bestSellers.forEach((p, i) => { %>
          <a href="/shop/<%= p._id %>"
             class="card-hover bg-brand-card rounded-2xl border border-gray-900 overflow-hidden
                    block group fade-up"
             style="animation-delay:<%= i * 0.06 %>s">

            <!-- Image -->
            <div class="relative bg-gradient-to-b from-gray-800 to-brand-card h-44
                        flex items-center justify-center overflow-hidden">
              <% if (p.variant.image) { %>
                <img src="<%= p.variant.image %>" alt="<%= p.name %>"
                     class="h-full w-full object-cover group-hover:scale-110 transition duration-500">
              <% } else { %>
                <div class="flex items-center justify-center text-gray-700 h-full w-full">
                  <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" stroke-width="1.5"/>
                    <path stroke-linecap="round" stroke-width="1.5" d="M12 7v5l3 3"/>
                  </svg>
                </div>
              <% } %>
              <!-- Discount badge — only when active offer exists -->
              <% if (p.variant.discPct > 0) { %>
                <div class="absolute top-3 right-3 bg-red-500 text-white text-[10px]
                            font-black px-2 py-0.5 rounded-md shadow-lg">
                  −<%= p.variant.discPct %>%
                </div>
              <% } %>
            </div>

            <!-- Info -->
            <div class="p-4">
              <span class="text-[9px] text-brand-blue uppercase tracking-widest font-bold">
                <%= p.category ? p.category.name : p.brand %>
              </span>
              <h4 class="font-bold mt-1 text-sm truncate group-hover:text-brand-blue transition">
                <%= p.name %>
              </h4>
              <p class="text-[10px] text-gray-500 mb-3 truncate">
                <%= p.brand %>
                <% if (p.specifications?.movementType) { %> · <%= p.specifications.movementType %><% } %>
              </p>
              <div class="flex justify-between items-center">
                <div>
                  <span class="font-bold text-base">₹<%= (p.variant.finalPrice || p.variant.salePrice).toLocaleString('en-IN') %></span>
                  <% if (p.variant.discPct > 0) { %>
                    <span class="text-gray-600 text-xs line-through ml-1.5">
                      ₹<%= p.variant.salePrice.toLocaleString('en-IN') %>
                    </span>
                  <% } %>
                </div>
                <button type="button"
                        onclick="event.preventDefault(); addToCart(this, '<%= p._id %>', '<%= p.variant._id %>')"
                        class="w-8 h-8 rounded-lg bg-gray-800 flex items-center justify-center
                               text-xs hover:bg-brand-blue hover:text-black transition flex-shrink-0">
                  <i class="fa-solid fa-cart-plus"></i>
                </button>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-20 border border-dashed border-gray-800 rounded-2xl">
        <p class="text-gray-600 text-sm">No products available yet.</p>
        <a href="/admin/products/add" class="text-brand-blue text-xs mt-3 inline-block hover:underline">
          Add your first product →
        </a>
      </div>
    <% } %>
  </section>

  <script>
    (function () {
      window.addEventListener('pageshow', function (e) {
        if (e.persisted || (window.performance && window.performance.navigation.type === 2)) {
          window.location.reload();
        }
      });
      if (window.location.hash === '#_=_' || window.location.search.includes('code=')) {
        window.history.replaceState(null, null, window.location.pathname);
      }
    })();
  </script>
</body>
