<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neo-Luxe | Edit Product</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { background-color: #05070A; color: #94a3b8; }
        .card-bg { background-color: #0b1120; border: 1px solid #1e293b; }
        .input-field { background-color: #1e293b; border: 1px solid #334155; border-radius: 0.75rem; padding: 0.75rem 1rem; color: white; font-size: 0.875rem; width: 100%; }
        .input-field:focus { outline: none; border-color: #06b6d4; box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.1); }
        .label-style { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; color: #64748b; margin-bottom: 0.5rem; display: block; }
        .custom-glow { box-shadow: 0 0 15px rgba(6, 182, 212, 0.4); }
        .custom-scroll::-webkit-scrollbar { width: 5px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
        /* Prevent scroll wheel from changing number inputs */
        input[type=number] { -moz-appearance: textfield; }
        input[type=number]::-webkit-outer-spin-button,
        input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        /* Cropper Modal Styles *//* Ensure the modal covers the full screen and centers content */
/* Fix for Cropper.js overflow */
.cropper-container {
    max-height: 90vh; 
    display: flex;
    flex-direction: column;
}

#cropperImage {
    display: block;
    max-width: 100%;
    /* Changed to min-height for better responsiveness */
    min-height: 300px; 
    max-height: 60vh; 
    object-fit: contain;
}

#cropperModal {
    display: none;
    position: fixed;
    z-index: 10000; 
    inset: 0;
    background: rgba(2, 6, 23, 0.95); /* Matches your slate-950 theme */
    backdrop-filter: blur(8px);
    align-items: center;
    justify-content: center;
    padding: 20px;
}
    </style>
</head>
<body class="font-sans antialiased overflow-hidden">

<div id="cropperModal">
    <div class="cropper-container">
        <div class="p-4 border-b border-slate-800">
            <h3 class="text-white font-bold">Crop Your Image</h3>
        </div>

        <div class="p-4 bg-black flex-grow flex items-center justify-center overflow-hidden">
            <img id="cropperImage" src="" alt="To crop" style="max-width: 100%; display: block;">
        </div>

        <div class="p-4 border-t border-slate-800 flex justify-end gap-3 bg-[#0b1120] rounded-b-xl">
            <button type="button" onclick="closeCropper()" 
                class="px-5 py-2 text-sm font-semibold text-slate-400 hover:text-white transition">
                Cancel
            </button>
            <button type="button" id="cropButton" 
                class="bg-cyan-500 hover:bg-cyan-400 text-slate-900 px-6 py-2 rounded-lg font-bold text-sm transition shadow-lg">
                Crop & Save
            </button>
        </div>
    </div>
</div>

<div class="flex h-screen w-full">
    <%- include('../partials/admin-sidebar', { path: 'watches' }) %>

    <main class="flex-1 flex flex-col min-w-0 bg-[#05070A]">
        <header class="p-8 pb-4 flex justify-between items-center">
            <div>
                <a href="/admin/products" class="text-[10px] uppercase tracking-widest text-slate-500 hover:text-cyan-400 flex items-center mb-2 transition">
                    <i class="fas fa-arrow-left mr-2"></i> Back to Inventory
                </a>
                <h2 class="text-3xl font-bold text-white tracking-tight">Edit Product</h2>
                <p class="text-sm text-slate-500 mt-1">Refining <span class="text-cyan-400 font-medium"><%= product.name %></span></p>
            </div>
        </header>

        <section class="flex-1 overflow-y-auto custom-scroll px-8 pb-10">
            <form id="editProductForm" onsubmit="handleEditSubmit(event, '<%= product._id %>')">
                <div class="grid grid-cols-12 gap-8">
                    <div class="col-span-12 lg:col-span-8 space-y-8">
                        <div class="card-bg rounded-2xl p-8">
                            <h3 class="text-lg font-bold text-white mb-6 border-b border-slate-800 pb-4">Basic Information</h3>
                            <div class="space-y-6">
                                <div>
                                    <label class="label-style">Product Name *</label>
                                    <input type="text" name="name" id="productName" value="<%= product.name %>" required class="input-field"
                                           oninput="checkNameAvailability(this.value)">
                                    <p id="nameStatus" class="mt-1.5 text-[11px] font-semibold hidden"></p>
                                </div>
                                <div class="grid grid-cols-2 gap-6">
                                    <div>
                                        <label class="label-style">Brand *</label>
                                        <input type="text" name="brand" value="<%= product.brand %>" required class="input-field">
                                    </div>
                                    <div>
                                        <label class="label-style">Category *</label>
                                        <select name="category" required class="input-field">
                                            <% categories.forEach(cat => { %>
                                                <option value="<%= cat._id %>" <%= product.category._id.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                                <div>
                                    <label class="label-style">Description *</label>
                                    <textarea name="description" rows="4" required class="input-field"><%= product.description %></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-6">
                            <% variants.forEach((variant, index) => { %>
                            <div class="card-bg rounded-2xl p-8 relative" data-variant-index="<%= index %>">
                                <h4 class="text-cyan-500 font-bold text-xs uppercase tracking-widest mb-6">Variant #<%= index + 1 %></h4>
                                <input type="hidden" name="variants[<%=index%>][_id]" value="<%= variant._id %>">
                                
                                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                                    <div>
                                        <label class="label-style">Color</label>
                                        <input type="text" name="variants[<%=index%>][color]" value="<%= variant.color %>" class="input-field">
                                    </div>
                                   <div>
    <label class="label-style">Regular Price (MRP)</label>
    <input type="number" name="variants[<%=index%>][regularPrice]" value="<%= variant.regularPrice %>" class="input-field" required>
</div>
                                    <div>
                                        <label class="label-style">Sale Price</label>
                                        <input type="number" name="variants[<%=index%>][basePrice]" value="<%= variant.basePrice %>" class="input-field">
                                    </div>
                                    <div>
                                        <label class="label-style">Stock</label>
                                        <input type="number" name="variants[<%=index%>][stock]" value="<%= variant.stock %>" class="input-field">
                                    </div>
                                </div>

                                <div>
                                    <div class="flex items-center justify-between mb-2">
                                        <label class="label-style text-cyan-500 mb-0">Gallery Management</label>
                                        <span id="existing_count_<%= index %>"
                                              class="text-[11px] font-semibold <%= variant.images.length >= 3 ? 'text-green-400' : 'text-amber-400' %>">
                                            <%= variant.images.length %> / 3 images
                                        </span>
                                    </div>
                                    <div class="flex flex-wrap gap-3 mb-4" id="existing_container_<%=index%>">
                                        <% variant.images.forEach((img) => { %>
                                            <div class="relative group">
                                                <input type="hidden" name="existingImages_<%=index%>" value="<%= img.url %>">
                                                <img src="<%= img.url %>" class="w-20 h-20 rounded-xl object-cover border border-slate-700">
                                                <button type="button"
                                                        onclick="deleteExistingImage(this, '<%= product._id %>', '<%= variant._id %>', '<%= img.url %>', <%= index %>)"
                                                        class="absolute -top-2 -right-2 bg-rose-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-[10px] opacity-0 group-hover:opacity-100 transition shadow-lg">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        <% }) %>
                                    </div>
                                    
                                    <label class="label-style">Add New Images (Click to Crop)</label>
                                    <input type="file" multiple accept="image/*" class="input-field text-xs mb-2" onchange="initCropProcess(this, '<%=index%>')">
                                    
                                    <div id="new_preview_<%=index%>" class="flex gap-2 flex-wrap mt-2"></div>
                                </div>
                            </div>
                            <% }) %>
                            <div id="variantsContainer" class="space-y-6 mt-6">
                                <%# New variants added via JS will appear here %>
                            </div>

                            <div class="mt-6">
                                <button type="button" onclick="addNewVariant()" 
                                    class="w-full py-4 border-2 border-dashed border-slate-700 rounded-2xl text-slate-500 hover:text-cyan-400 hover:border-cyan-400/50 transition flex items-center justify-center gap-2 group">
                                    <i class="fas fa-plus-circle group-hover:scale-110 transition"></i>
                                    <span class="font-bold text-xs uppercase tracking-widest">Add Another Variant</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-12 lg:col-span-4 space-y-8">
                        <div class="card-bg rounded-2xl p-8 sticky top-4">
                            <h3 class="text-lg font-bold text-white mb-6 border-b border-slate-800 pb-4">Specifications</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="label-style">Case Size</label>
                                    <input type="text" name="caseSize" value="<%= product.specifications.caseSize %>" class="input-field">
                                </div>
                                <div>
                                    <label class="label-style">Strap Type</label>
                                    <input type="text" name="strapType" value="<%= product.specifications.strapType %>" class="input-field">
                                </div>
                                <div>
                                    <label class="label-style">Movement</label>
                                    <input type="text" name="movementType" value="<%= product.specifications.movementType %>" class="input-field">
                                </div>
                              <div class="flex items-center gap-2">
    <input type="checkbox" name="isActive" id="isActive" value="true" <%= product.isActive ? 'checked' : '' %> class="w-4 h-4 accent-cyan-500">
    <label for="isActive" class="text-sm">Active / Listed in Store</label>
</div>
                            </div>
                            <button type="submit" class="w-full mt-8 bg-cyan-500 text-slate-900 py-4 rounded-xl font-black text-xs uppercase tracking-widest custom-glow hover:bg-cyan-400">
                                Update Product
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </section>
    </main>
</div>

<script>
    // 1. Core State
   let variantCount = parseInt("<%= variants.length %>") || 0;
    let cropper;
    const variantImagesData = {}; // Stores cropped blobs keyed by variant index/ID

    // ── Name availability check (excludes current product) ───────────────────
    const CURRENT_PRODUCT_ID = '<%= product._id %>';
    let nameCheckTimer;
    async function checkNameAvailability(value) {
        const statusEl = document.getElementById('nameStatus');
        const trimmed  = value.trim();

        clearTimeout(nameCheckTimer);

        if (!trimmed) {
            statusEl.classList.add('hidden');
            return;
        }

        nameCheckTimer = setTimeout(async () => {
            try {
                const res  = await fetch(`/admin/products/check-name?name=${encodeURIComponent(trimmed)}&excludeId=${CURRENT_PRODUCT_ID}`);
                const data = await res.json();

                statusEl.classList.remove('hidden', 'text-red-400', 'text-green-400');
                if (data.exists) {
                    statusEl.textContent = '✕ A product with this name already exists.';
                    statusEl.classList.add('text-red-400');
                } else {
                    statusEl.textContent = '✓ Name is available.';
                    statusEl.classList.add('text-green-400');
                }
            } catch {
                statusEl.classList.add('hidden');
            }
        }, 400);
    }

    // 2. Add New Variant Function
    function addNewVariant() {
        const container = document.getElementById('variantsContainer');
        // Use a timestamp for the index to ensure it's always unique, even if others are removed
        const index = Date.now(); 

       const variantHtml = `
    <div class="card-bg rounded-2xl p-8 relative border-t-2 border-cyan-500 animate-fade-in mt-6" id="variant_card_${index}">
        <div class="flex justify-between items-center mb-6">
            <h4 class="text-cyan-500 font-bold text-xs uppercase tracking-widest">New Variant</h4>
            <button type="button" onclick="document.getElementById('variant_card_${index}').remove()" class="text-rose-500 hover:text-rose-400 text-xs font-bold uppercase tracking-tighter">
                <i class="fas fa-trash mr-1"></i> Remove Variant
            </button>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div>
                <label class="label-style">Color</label>
                <input type="text" name="variants[${index}][color]" placeholder="e.g. Midnight Blue" class="input-field" required>
            </div>
            <div>
                <label class="label-style">Regular Price</label>
                <input type="number" name="variants[${index}][regularPrice]" class="input-field" required>
            </div>
            <div>
                <label class="label-style">Sale Price</label>
                <input type="number" name="variants[${index}][basePrice]" class="input-field" required>
            </div>
            <div>
                <label class="label-style">Stock</label>
                <input type="number" name="variants[${index}][stock]" value="0" class="input-field" required>
            </div>
        </div>

        <div>
            <label class="label-style text-cyan-500">Gallery Management</label>
            <label class="label-style">Add Images (Minimum 3 required)</label>
            <input type="file" multiple accept="image/*" class="input-field text-xs mb-2" 
                onchange="initCropProcess(this, '${index}')">
            <p id="img_count_${index}" class="text-[11px] mt-1 text-slate-500">0 / 3 images added</p>
            <div id="new_preview_${index}" class="flex gap-2 flex-wrap mt-2"></div>
        </div>
    </div>
`;

        container.insertAdjacentHTML('beforeend', variantHtml);
    }

    // 3. Image Selection & Cropping Logic
    function initCropProcess(input, variantIndex) {
        if (!input.files || input.files.length === 0) return;
        
        if (!variantImagesData[variantIndex]) variantImagesData[variantIndex] = [];
        
        const files = Array.from(input.files);
        let fileIdx = 0;

        const processNext = () => {
            if (fileIdx >= files.length) {
                input.value = ""; 
                return;
            }
            openCropper(files[fileIdx], variantIndex, () => {
                fileIdx++;
                processNext();
            });
        };
        processNext();
    }

    function openCropper(file, variantIndex, callback) {
        const reader = new FileReader();
        reader.onload = (e) => {
            const modal = document.getElementById('cropperModal');
            const image = document.getElementById('cropperImage');
            
            image.src = e.target.result;
            
            // SHOW MODAL FIRST
            modal.style.display = 'flex';

            if (cropper) cropper.destroy();

            // Initialize Cropper AFTER modal is visible
            cropper = new Cropper(image, {
                aspectRatio: 1,
                viewMode: 1,
                guides: true,
                background: false,
                autoCropArea: 1,
                responsive: true
            });

            document.getElementById('cropButton').onclick = () => {
                const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
                canvas.toBlob((blob) => {
                    const imgId = Date.now(); 
                    variantImagesData[variantIndex].push({ id: imgId, blob: blob });
                    
                    renderPreview(variantIndex, imgId, canvas.toDataURL('image/jpeg'));
                    closeCropper();
                    callback();
                }, 'image/jpeg', 0.9);
            };
        };
        reader.readAsDataURL(file);
    }

    function closeCropper() {
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
        document.getElementById('cropperModal').style.display = 'none';
    }

    function renderPreview(variantIndex, imgId, dataUrl) {
        const container = document.getElementById(`new_preview_${variantIndex}`);
        const div = document.createElement('div');
        div.className = "relative group animate-fade-in";
        div.id = `img_container_${imgId}`;
        div.innerHTML = `
            <img src="${dataUrl}" class="w-16 h-16 rounded-lg object-cover border border-cyan-500 shadow-lg">
            <button type="button" onclick="removeNewImage('${variantIndex}', ${imgId})" 
                class="absolute -top-2 -right-2 bg-rose-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-[8px] hover:bg-rose-600 transition">
                <i class="fas fa-times"></i>
            </button>
        `;
        container.appendChild(div);
        updateImgCount(variantIndex);
        updateExistingCount(variantIndex); // refresh combined total on existing variant counter
    }

    function removeNewImage(variantIndex, imgId) {
        variantImagesData[variantIndex] = variantImagesData[variantIndex].filter(img => img.id !== imgId);
        const el = document.getElementById(`img_container_${imgId}`);
        if (el) el.remove();
        updateImgCount(variantIndex);
        updateExistingCount(variantIndex); // refresh combined total on existing variant counter
    }

    function updateImgCount(variantIndex) {
        const counter = document.getElementById(`img_count_${variantIndex}`);
        if (!counter) return;
        const count = (variantImagesData[variantIndex] || []).length;
        counter.textContent = `${count} / 3 images added`;
        counter.className = count >= 3
            ? 'text-[11px] mt-1 text-green-400'
            : 'text-[11px] mt-1 text-amber-400';
    }

    // 4. Submission Logic
    async function handleEditSubmit(e, productId) {
        e.preventDefault();

        const form = e.target;

        // ── Helper ────────────────────────────────────────────────────
        function err(msg) {
            Swal.fire({ title: 'Validation Error', text: msg, icon: 'warning',
                background: '#0b1120', color: '#94a3b8', confirmButtonColor: '#06b6d4' });
        }

        // ── 1. Product name ───────────────────────────────────────────
        const nameInput   = document.getElementById('productName');
        const trimmedName = nameInput.value.trim();
        if (!trimmedName)                    return err('Product name is required.');
        if (trimmedName.length < 3)          return err('Product name must be at least 3 characters.');
        if (trimmedName.length > 100)        return err('Product name must be under 100 characters.');

        // ── 2. Brand ──────────────────────────────────────────────────
        const brand = form.querySelector('[name="brand"]').value.trim();
        if (!brand)             return err('Brand is required.');
        if (brand.length < 2)   return err('Brand must be at least 2 characters.');

        // ── 3. Description ────────────────────────────────────────────
        const description = form.querySelector('[name="description"]').value.trim();
        if (!description)              return err('Description is required.');
        if (description.length < 10)   return err('Description must be at least 10 characters.');

        // ── 4. Specifications ─────────────────────────────────────────
        const caseSize    = form.querySelector('[name="caseSize"]').value.trim();
        const strapType   = form.querySelector('[name="strapType"]').value.trim();
        const movementType = form.querySelector('[name="movementType"]').value.trim();
        if (!caseSize)     return err('Case size is required.');
        if (!strapType)    return err('Strap type is required.');
        if (!movementType) return err('Movement type is required.');

        // ── 5. Duplicate name check (server) ──────────────────────────
        try {
            const checkRes  = await fetch(`/admin/products/check-name?name=${encodeURIComponent(trimmedName)}&excludeId=${productId}`);
            const checkData = await checkRes.json();
            if (checkData.exists) {
                return Swal.fire({ title: 'Duplicate Name',
                    text: `Another product named "${trimmedName}" already exists.`,
                    icon: 'error', background: '#0b1120', color: '#94a3b8', confirmButtonColor: '#06b6d4' });
            }
        } catch {
            return err('Could not verify product name. Please try again.');
        }

        // ── 6. Existing variant field validation ──────────────────────
        const existingVariantCards = document.querySelectorAll('[data-variant-index]');
        const seenColors = [];
        for (const card of existingVariantCards) {
            const idx          = card.dataset.variantIndex;
            const color        = card.querySelector(`[name="variants[${idx}][color]"]`)?.value.trim() || '';
            const regularPrice = Number(card.querySelector(`[name="variants[${idx}][regularPrice]"]`)?.value);
            const basePrice    = Number(card.querySelector(`[name="variants[${idx}][basePrice]"]`)?.value);
            const stock        = Number(card.querySelector(`[name="variants[${idx}][stock]"]`)?.value);
            const label        = color || `Variant ${parseInt(idx) + 1}`;

            if (!color)                                  return err(`${label}: Color is required.`);
            if (seenColors.includes(color.toLowerCase())) return err(`Duplicate color "${color}". Each variant must have a unique color.`);
            seenColors.push(color.toLowerCase());

            if (isNaN(regularPrice) || regularPrice <= 0) return err(`${label}: Regular price must be greater than 0.`);
            if (isNaN(basePrice)    || basePrice <= 0)    return err(`${label}: Sale price must be greater than 0.`);
            if (basePrice > regularPrice)                 return err(`${label}: Sale price cannot exceed regular price.`);
            if (isNaN(stock) || stock < 0)                return err(`${label}: Stock cannot be negative.`);

            // Image count
            const container = document.getElementById(`existing_container_${idx}`);
            const existing  = container ? container.querySelectorAll('input[type="hidden"]').length : 0;
            const newImgs   = (variantImagesData[idx] || []).length;
            if (existing + newImgs < 3)
                return Swal.fire({ title: 'Images Required',
                    html: `<b>${label}</b> must have at least 3 images (currently ${existing + newImgs}).`,
                    icon: 'warning', background: '#0b1120', color: '#94a3b8', confirmButtonColor: '#06b6d4' });
        }

        // ── 7. New variant field validation ───────────────────────────
        const newVariantCards = document.querySelectorAll('#variantsContainer [id^="variant_card_"]');
        for (const card of newVariantCards) {
            const idMatch = card.id.match(/variant_card_(\d+)/);
            if (!idMatch) continue;
            const idx          = idMatch[1];
            const color        = card.querySelector(`[name="variants[${idx}][color]"]`)?.value.trim() || '';
            const regularPrice = Number(card.querySelector(`[name="variants[${idx}][regularPrice]"]`)?.value);
            const basePrice    = Number(card.querySelector(`[name="variants[${idx}][basePrice]"]`)?.value);
            const stock        = Number(card.querySelector(`[name="variants[${idx}][stock]"]`)?.value);
            const label        = color || `New Variant`;

            if (!color)                                  return err(`New variant: Color is required.`);
            if (seenColors.includes(color.toLowerCase())) return err(`Duplicate color "${color}". Each variant must have a unique color.`);
            seenColors.push(color.toLowerCase());

            if (isNaN(regularPrice) || regularPrice <= 0) return err(`${label}: Regular price must be greater than 0.`);
            if (isNaN(basePrice)    || basePrice <= 0)    return err(`${label}: Sale price must be greater than 0.`);
            if (basePrice > regularPrice)                 return err(`${label}: Sale price cannot exceed regular price.`);
            if (isNaN(stock) || stock < 0)                return err(`${label}: Stock cannot be negative.`);

            const count = (variantImagesData[idx] || []).length;
            if (count < 3)
                return Swal.fire({ title: 'Images Required',
                    text: `${label} needs at least 3 images (currently ${count}).`,
                    icon: 'warning', background: '#0b1120', color: '#94a3b8', confirmButtonColor: '#06b6d4' });
        }

        // ── 8. Build FormData and submit ──────────────────────────────
        const formData = new FormData(form);

        Object.keys(variantImagesData).forEach(variantIdx => {
            variantImagesData[variantIdx].forEach((imgObj, i) => {
                formData.append(`variantImages_${variantIdx}`, imgObj.blob, `variant_${variantIdx}_${i}.jpg`);
            });
        });

        // Ensure isActive is always sent correctly based on checkbox state
        formData.delete('isActive');
        formData.append('isActive', document.getElementById('isActive').checked ? 'true' : 'false');

        try {
            const response = await fetch(`/admin/products/edit/${productId}`, {
                method: 'PUT',
                body: formData
            });

            const result = await response.json();
            if (result.success) {
                Swal.fire({ title: 'Updated!', text: 'Inventory refined successfully', icon: 'success',
                    background: '#0b1120', color: '#fff', confirmButtonColor: '#06b6d4'
                }).then(() => window.location.href = '/admin/products');
            } else {
                Swal.fire('Error', result.message, 'error');
            }
        } catch {
            Swal.fire('Error', 'Submission failed', 'error');
        }
    }

    // Prevent scroll wheel from changing number input values
    document.addEventListener('wheel', (e) => {
        if (document.activeElement?.type === 'number') {
            document.activeElement.blur();
        }
    }, { passive: true });

    // ── Delete existing image ─────────────────────────────────────────────────
    async function deleteExistingImage(btn, productId, variantId, imageUrl, variantIndex) {
        const confirmed = await Swal.fire({
            title:              'Remove image?',
            text:               'This will permanently delete the image.',
            icon:               'warning',
            showCancelButton:   true,
            confirmButtonText:  'Yes, remove',
            cancelButtonText:   'Cancel',
            confirmButtonColor: '#ef4444',
            cancelButtonColor:  '#334155',
            background:         '#0b1120',
            color:              '#94a3b8',
        });
        if (!confirmed.isConfirmed) return;

        try {
            const res  = await fetch(`/admin/products/${productId}/variants/${variantId}/images`, {
                method:  'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ imageUrl }),
            });
            const data = await res.json();

            if (data.success) {
                // Remove the image wrapper from the DOM
                const container = document.getElementById(`existing_container_${variantIndex}`);
                btn.closest('.relative.group').remove();
                // Remove the hidden input carrying this URL
                if (container) {
                    container.querySelectorAll('input[type="hidden"]').forEach(inp => {
                        if (inp.value === imageUrl) inp.remove();
                    });
                }
                // Update the live counter
                updateExistingCount(variantIndex);

                Swal.fire({
                    toast: true, position: 'top-end', icon: 'success',
                    title: 'Image removed', showConfirmButton: false, timer: 1800,
                    background: '#0b1120', color: '#94a3b8',
                });
            } else {
                Swal.fire('Error', data.message || 'Could not remove image', 'error');
            }
        } catch {
            Swal.fire('Error', 'Something went wrong', 'error');
        }
    }

    // ── Live counter for existing variant images ──────────────────────────────
    function updateExistingCount(variantIndex) {
        const counter   = document.getElementById(`existing_count_${variantIndex}`);
        if (!counter) return;
        const container = document.getElementById(`existing_container_${variantIndex}`);
        const existing  = container ? container.querySelectorAll('input[type="hidden"]').length : 0;
        const newImgs   = (variantImagesData[variantIndex] || []).length;
        const total     = existing + newImgs;
        counter.textContent = `${total} / 3 images`;
        counter.className   = total >= 3 ? 'text-[11px] font-semibold text-green-400'
                                         : 'text-[11px] font-semibold text-amber-400';
    }
</script>
</body>
</html>