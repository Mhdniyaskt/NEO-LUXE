        <a href="/admin/orders" onclick="closeSidebarMobile()"
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'orders' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
