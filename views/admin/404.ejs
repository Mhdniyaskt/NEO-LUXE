<div class="flex h-screen w-full">
  <%- include('../partials/admin-sidebar', { path: '' }) %>

  <main class="flex-1 flex items-center justify-center p-4 md:p-8">
    <div class="text-center max-w-md mx-auto">
      <!-- Icon -->
      <div class="mb-6 flex justify-center">
        <div class="w-20 h-20 bg-slate-800/50 border border-slate-700 rounded-2xl flex items-center justify-center">
          <svg class="w-10 h-10 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>

      <!-- 404 text -->
      <h1 class="text-6xl font-black text-transparent bg-clip-text bg-gradient-to-b from-cyan-400 to-cyan-600 leading-none mb-3">
        404
      </h1>

      <h2 class="text-lg font-bold text-white mb-2 uppercase tracking-wider">Admin Page Not Found</h2>

      <p class="text-slate-500 text-sm mb-8">
        The admin page you're looking for doesn't exist or has been moved.
      </p>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/admin/dashboard"
           class="inline-flex items-center gap-2 bg-cyan-400 hover:bg-cyan-300 text-[#05080d] font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl transition-all shadow-lg shadow-cyan-400/20">
          <i class="fas fa-th-large"></i>
          Go to Dashboard
        </a>
        <button onclick="history.back()"
           class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl transition-all">
          <i class="fas fa-arrow-left"></i>
          Go Back
        </button>
      </div>
    </div>
  </main>
</div>
