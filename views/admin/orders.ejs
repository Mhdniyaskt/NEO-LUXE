<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Orders | Neo-Luxe Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body { background-color:#05070A; color:#E2E8F0; font-family:'Inter',sans-serif; }
    .card-bg { background-color:#0B1120; border:1px solid #1E293B; }
    ::-webkit-scrollbar { width:5px; height:5px; }
    ::-webkit-scrollbar-track { background:#05070A; }
    ::-webkit-scrollbar-thumb { background:#1E293B; border-radius:10px; }
    ::-webkit-scrollbar-thumb:hover { background:#22D3EE; }
  </style>
</head>
<body class="antialiased overflow-hidden">

<div class="flex h-screen w-full">

  <%- include('../partials/admin-sidebar', { path: 'orders' }) %>

  <main class="flex-1 overflow-y-auto bg-[#05070A]">
    <div class="max-w-7xl mx-auto p-6 md:p-8">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-5">
        <a href="/admin/dashboard" class="hover:text-slate-300 transition-colors">
          <i class="fas fa-home"></i>
        </a>
        <span class="text-slate-700">/</span>
        <span class="text-slate-300">Orders</span>
      </nav>

      <!-- Page header -->
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight">Orders</h1>
          <p class="text-slate-500 text-sm mt-1">Manage and track customer watch orders.</p>
        </div>
        <button onclick="toggleSidebar()" class="lg:hidden bg-slate-900 border border-slate-800 p-2.5 rounded-xl text-white">
          <i class="fas fa-bars"></i>
        </button>
      </div>

      <!-- Filter card -->
      <div class="card-bg rounded-2xl p-5 mb-6">
        <div class="flex items-center gap-2 mb-4">
          <i class="fas fa-filter text-cyan-400 text-xs"></i>
          <span class="text-xs font-bold text-slate-300 uppercase tracking-widest">Filter Orders</span>
        </div>
        <form action="/admin/orders" method="GET">

          <!-- Row 1: all filter inputs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-4">

            <!-- Search -->
            <div>
              <label class="block text-[10px] uppercase font-bold text-slate-500 mb-2 tracking-widest">Search</label>
              <div class="relative">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-600 text-xs"></i>
                <input type="text" name="search" value="<%= search %>" placeholder="Order ID or customer…"
                  class="w-full bg-[#05070A] border border-slate-800 rounded-xl py-2.5 pl-9 pr-3 text-sm text-white focus:outline-none focus:border-cyan-500/50 transition"/>
              </div>
            </div>

            <!-- Order Status -->
            <div>
              <label class="block text-[10px] uppercase font-bold text-slate-500 mb-2 tracking-widest">Order Status</label>
              <div class="relative">
                <select name="status" class="w-full bg-[#05070A] border border-slate-800 rounded-xl py-2.5 px-3 text-sm text-slate-300 focus:outline-none focus:border-cyan-500/50 appearance-none">
                  <option value="">All Statuses</option>
                  <% ['pending','confirmed','processing','shipped','delivered','cancelled','returned'].forEach(s => { %>
                    <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
                  <% }) %>
                </select>
                <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-600 text-[10px] pointer-events-none"></i>
              </div>
            </div>

            <!-- Payment Status -->
            <div>
              <label class="block text-[10px] uppercase font-bold text-slate-500 mb-2 tracking-widest">Payment Status</label>
              <div class="relative">
                <select name="paymentStatus" class="w-full bg-[#05070A] border border-slate-800 rounded-xl py-2.5 px-3 text-sm text-slate-300 focus:outline-none focus:border-cyan-500/50 appearance-none">
                  <option value="">All</option>
                  <% ['pending','paid','failed','refunded'].forEach(p => { %>
                    <option value="<%= p %>" <%= paymentStatus === p ? 'selected' : '' %>><%= p.charAt(0).toUpperCase() + p.slice(1) %></option>
                  <% }) %>
                </select>
                <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-600 text-[10px] pointer-events-none"></i>
              </div>
            </div>

            <!-- Sort -->
            <div>
              <label class="block text-[10px] uppercase font-bold text-slate-500 mb-2 tracking-widest">Sort By</label>
              <div class="relative">
                <select name="sort" class="w-full bg-[#05070A] border border-slate-800 rounded-xl py-2.5 px-3 text-sm text-slate-300 focus:outline-none focus:border-cyan-500/50 appearance-none">
                  <option value="newest" <%= sort === 'newest' || !sort ? 'selected' : '' %>>Newest First</option>
                  <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                  <option value="amount_high" <%= sort === 'amount_high' ? 'selected' : '' %>>Amount: High → Low</option>
                  <option value="amount_low" <%= sort === 'amount_low' ? 'selected' : '' %>>Amount: Low → High</option>
                </select>
                <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-600 text-[10px] pointer-events-none"></i>
              </div>
            </div>

            <!-- Date -->
            <div>
              <label class="block text-[10px] uppercase font-bold text-slate-500 mb-2 tracking-widest">Date</label>
              <input type="date" name="date" value="<%= date %>"
                class="w-full bg-[#05070A] border border-slate-800 rounded-xl py-2.5 px-3 text-sm text-slate-300 focus:outline-none focus:border-cyan-500/50"/>
            </div>

          </div>

          <!-- Row 2: action buttons — always inside the card -->
          <div class="flex items-center justify-end gap-2 pt-1">
            <a href="/admin/orders"
               class="flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-400 hover:text-white text-xs font-bold px-4 py-2.5 rounded-xl transition">
              <i class="fas fa-times text-[10px]"></i> Clear
            </a>
            <button type="submit"
                    class="flex items-center gap-1.5 bg-cyan-400 hover:bg-cyan-300 text-[#05070A] font-bold text-xs px-5 py-2.5 rounded-xl transition">
              <i class="fas fa-search text-[10px]"></i> Search
            </button>
          </div>

        </form>
      </div>

      <!-- Orders table -->
      <div class="card-bg rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm" style="min-width:960px">
            <thead class="bg-slate-900/40 text-[10px] uppercase tracking-widest text-slate-500 border-b border-slate-800">
              <tr>
                <th class="px-4 py-4 font-bold w-28">Order ID</th>
                <th class="px-4 py-4 font-bold w-48">Customer</th>
                <th class="px-4 py-4 font-bold">Watch(es)</th>
                <th class="px-4 py-4 font-bold w-24 text-right">Amount</th>
                <th class="px-4 py-4 font-bold w-20 text-center">Payment</th>
                <th class="px-4 py-4 font-bold w-24 text-center">Pay Status</th>
                <th class="px-4 py-4 font-bold w-36 text-center">Order Status</th>
                <th class="px-4 py-4 font-bold w-24">Date</th>
                <th class="px-4 py-4 font-bold w-28 text-center">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/50">
              <% if (orders && orders.length > 0) { %>
                <% orders.forEach(order => {
                  const shortId = '#' + order._id.toString().slice(-8).toUpperCase();
                  const customerName = order.user ? order.user.name : 'Deleted User';
                  const initials = customerName.split(' ').map(n=>n[0]).join('').toUpperCase().slice(0,2);
                  const activeItems = order.items ? order.items.filter(i => i.status !== 'cancelled') : [];
                  const firstItem = activeItems.length ? activeItems[0].productName : (order.items && order.items.length ? order.items[0].productName : '—');
                  const totalItems = order.items ? order.items.length : 0;
                  const moreItems = totalItems > 1 ? `+${totalItems - 1} more` : '';
                  const statusColors = {
                    pending:    'bg-amber-500/10 text-amber-400 border-amber-500/20',
                    confirmed:  'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
                    processing: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
                    shipped:    'bg-purple-500/10 text-purple-400 border-purple-500/20',
                    delivered:  'bg-green-500/10 text-green-400 border-green-500/20',
                    cancelled:  'bg-red-500/10 text-red-400 border-red-500/20',
                    returned:   'bg-orange-500/10 text-orange-400 border-orange-500/20',
                  };
                  const payColors = {
                    pending:  'bg-amber-500/10 text-amber-400 border-amber-500/20',
                    paid:     'bg-green-500/10 text-green-400 border-green-500/20',
                    failed:   'bg-red-500/10 text-red-400 border-red-500/20',
                    refunded: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
                    cancelled:'bg-slate-500/10 text-slate-400 border-slate-500/20',
                  };
                %>
                <tr class="hover:bg-slate-800/20 transition-colors">

                  <!-- Order ID -->
                  <td class="px-4 py-4">
                    <span class="text-cyan-400 font-mono font-bold text-xs"><%= shortId %></span>
                  </td>

                  <!-- Customer -->
                  <td class="px-4 py-4">
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-[9px] font-bold text-cyan-400 flex-shrink-0">
                        <%= initials %>
                      </div>
                      <div class="min-w-0">
                        <p class="text-white text-xs font-medium truncate max-w-[120px]"><%= customerName %></p>
                        <p class="text-slate-500 text-[10px] truncate max-w-[120px]"><%= order.user ? order.user.email : '—' %></p>
                      </div>
                    </div>
                  </td>

                  <!-- Watch(es) -->
                  <td class="px-4 py-4">
                    <p class="text-slate-300 text-xs truncate max-w-[160px]"><%= firstItem %></p>
                    <% if (moreItems) { %><p class="text-slate-600 text-[10px]"><%= moreItems %></p><% } %>
                  </td>

                  <!-- Amount -->
                  <td class="px-4 py-4 text-right">
                    <span class="text-white font-bold text-sm">₹<%= order.total.toLocaleString('en-IN') %></span>
                  </td>

                  <!-- Payment method -->
                  <td class="px-4 py-4 text-center">
                    <div class="flex items-center justify-center gap-1 text-slate-400 text-xs">
                      <i class="<%= order.paymentMethod === 'cod' ? 'fas fa-money-bill-wave' : 'fas fa-credit-card' %> text-[10px]"></i>
                      <span><%= order.paymentMethod === 'cod' ? 'COD' : 'Card' %></span>
                    </div>
                  </td>

                  <!-- Pay Status -->
                  <td class="px-4 py-4 text-center">
                    <span class="inline-block px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider border <%= payColors[order.paymentStatus] || 'bg-slate-800 text-slate-400 border-slate-700' %>">
                      <%= order.paymentStatus %>
                    </span>
                  </td>

                  <!-- Order Status — locked badge for terminal states, dropdown otherwise -->
                  <td class="px-4 py-4 text-center">
                    <% if (['cancelled','returned','delivered'].includes(order.status)) { %>
                      <span class="inline-block px-2 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-wider border cursor-not-allowed <%= statusColors[order.status] %>">
                        <i class="fas fa-lock text-[8px] mr-1 opacity-60"></i><%= order.status %>
                      </span>
                    <% } else { %>
                      <select onchange="quickUpdateStatus('<%= order._id %>', this)"
                              data-original="<%= order.status %>"
                              class="w-full max-w-[130px] border text-[9px] font-black uppercase tracking-wider cursor-pointer focus:outline-none rounded-lg px-2 py-1.5 bg-transparent appearance-none text-center <%= statusColors[order.status] || 'bg-slate-800 text-slate-400 border-slate-700' %>">
                        <% ['pending','confirmed','processing','shipped','delivered'].forEach(s => { %>
                          <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>
                                  class="bg-[#0B1120] text-slate-300 normal-case font-normal text-xs">
                            <%= s.charAt(0).toUpperCase() + s.slice(1) %>
                          </option>
                        <% }) %>
                      </select>
                    <% } %>
                  </td>

                  <!-- Date -->
                  <td class="px-4 py-4 text-slate-500 text-xs whitespace-nowrap">
                    <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
                  </td>

                  <!-- Action -->
                  <td class="px-4 py-4 text-center">
                    <a href="/admin/orders/<%= order._id %>"
                       class="inline-flex items-center gap-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-cyan-500/40 text-slate-300 hover:text-cyan-400 text-[10px] font-bold uppercase tracking-wider px-3 py-1.5 rounded-lg transition-all whitespace-nowrap">
                      <i class="fas fa-eye text-[9px]"></i> View
                    </a>
                  </td>
                </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="9" class="px-6 py-20 text-center">
                    <i class="fas fa-shopping-bag text-4xl text-slate-800 mb-4 block"></i>
                    <p class="text-slate-500 text-sm">No orders found.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3">
          <p class="text-[11px] text-slate-500">
            Showing <span class="text-white font-semibold"><%= orders.length %></span> of
            <span class="text-white font-semibold"><%= total %></span> orders
          </p>
          <% if (totalPages > 1) { %>
            <div class="flex items-center gap-1">
              <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage-1 %>&search=<%= encodeURIComponent(search) %>&status=<%= status %>&paymentStatus=<%= paymentStatus %>&date=<%= date %>&sort=<%= sort %>"
                   class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-800 text-slate-400 hover:text-white hover:border-slate-600 transition text-xs">
                  <i class="fas fa-chevron-left"></i>
                </a>
              <% } %>
              <% for (let i = Math.max(1, currentPage-2); i <= Math.min(totalPages, currentPage+2); i++) { %>
                <a href="?page=<%= i %>&search=<%= encodeURIComponent(search) %>&status=<%= status %>&paymentStatus=<%= paymentStatus %>&date=<%= date %>&sort=<%= sort %>"
                   class="w-8 h-8 flex items-center justify-center rounded-lg border text-xs font-bold transition
                          <%= i === currentPage ? 'bg-cyan-400 border-cyan-400 text-[#05070A]' : 'border-slate-800 text-slate-400 hover:border-slate-600 hover:text-white' %>">
                  <%= i %>
                </a>
              <% } %>
              <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage+1 %>&search=<%= encodeURIComponent(search) %>&status=<%= status %>&paymentStatus=<%= paymentStatus %>&date=<%= date %>&sort=<%= sort %>"
                   class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-800 text-slate-400 hover:text-white hover:border-slate-600 transition text-xs">
                  <i class="fas fa-chevron-right"></i>
                </a>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>

      <footer class="text-center py-8">
        <p class="text-[9px] text-slate-700 uppercase tracking-widest">© 2026 Neo-Luxe Admin Panel</p>
      </footer>

    </div>
  </main>
</div>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('-translate-x-full');
  }

  async function quickUpdateStatus(orderId, select) {
    const newStatus = select.value;
    const original  = select.dataset.original;

    try {
      const res  = await fetch(`/admin/orders/${orderId}/status`, {
        method:  'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ status: newStatus }),
      });
      const data = await res.json();

      if (data.success) {
        const colors = {
          pending:    'bg-amber-500/10 text-amber-400 border-amber-500/20',
          confirmed:  'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
          processing: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
          shipped:    'bg-purple-500/10 text-purple-400 border-purple-500/20',
          delivered:  'bg-green-500/10 text-green-400 border-green-500/20',
          cancelled:  'bg-red-500/10 text-red-400 border-red-500/20',
          returned:   'bg-orange-500/10 text-orange-400 border-orange-500/20',
        };
        select.className = `w-full max-w-[130px] border text-[9px] font-black uppercase tracking-wider cursor-pointer focus:outline-none rounded-lg px-2 py-1.5 bg-transparent appearance-none text-center ${colors[newStatus] || 'bg-slate-800 text-slate-400 border-slate-700'}`;
        select.dataset.original = newStatus;

        const toast = document.createElement('div');
        toast.className = 'fixed top-4 right-4 z-50 bg-[#0B1120] border border-green-500/30 text-green-400 text-xs font-bold px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2';
        toast.innerHTML = '<i class="fas fa-check-circle"></i> Status updated to ' + newStatus;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2500);
      } else {
        select.value = original;
        Swal.fire({ icon:'error', title:'Error', text: data.message || 'Failed to update status', background:'#0B1120', color:'#E2E8F0', confirmButtonColor:'#22D3EE' });
      }
    } catch {
      select.value = original;
      Swal.fire({ icon:'error', title:'Error', text:'Something went wrong', background:'#0B1120', color:'#E2E8F0', confirmButtonColor:'#22D3EE' });
    }
  }
</script>
</body>
</html>
