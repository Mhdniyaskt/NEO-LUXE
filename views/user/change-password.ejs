<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password - NEO-LUXE</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-[#020617] text-white font-sans min-h-screen flex flex-col">

    <main class="flex-grow flex flex-col items-center justify-center px-4 py-10">
        <div class="w-full max-w-2xl">
            <div class="flex justify-between items-end mb-8">
                <div>
                    <h1 class="text-4xl font-bold mb-2">Change Password</h1>
                    <p class="text-gray-400 text-sm">Update your account password</p>
                </div>
                <a href="/profile" class="border border-gray-700 hover:bg-gray-800 text-[10px] py-2 px-4 rounded-full flex items-center gap-2 transition uppercase tracking-widest text-cyan-400">
                    <i class="fas fa-arrow-left text-[9px]"></i> Back to Profile
                </a>
            </div>

            <div class="bg-[#0f172a]/80 backdrop-blur-sm rounded-2xl p-10 border border-gray-800 shadow-2xl">
                <h2 class="text-lg font-medium mb-10 border-b border-gray-800 pb-4">Password Information</h2>
                
                <div id="errorMessage" class="hidden mb-6 p-4 rounded-lg bg-red-500/10 border border-red-500/50 text-red-500 text-sm flex items-center gap-3">
                    <i class="fas fa-exclamation-circle"></i>
                    <span id="errorText"></span>
                </div>

                <form id="changePasswordForm" class="space-y-6">
                    <div class="relative">
                        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] mb-3">Current Password</label>
                        <div class="relative">
                            <input type="password" name="currentPassword"  class="w-full bg-[#020617] border border-gray-800 rounded-lg p-3.5 focus:outline-none focus:border-cyan-500 transition pr-12">
                            <i class="far fa-eye absolute right-4 top-4 text-gray-600 cursor-pointer hover:text-cyan-500 toggle-pwd"></i>
                        </div>
                        <div class="text-right mt-2">
                            <button type="button" onclick="requestOTP()" class="text-[10px] text-gray-500 hover:text-cyan-400 transition uppercase tracking-tighter">Forgot Password?</button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] mb-3">New Password</label>
                        <div class="relative">
                            <input type="password" name="newPassword"  class="w-full bg-[#020617] border border-gray-800 rounded-lg p-3.5 focus:outline-none focus:border-cyan-500 transition pr-12">
                            <i class="far fa-eye absolute right-4 top-4 text-gray-600 cursor-pointer hover:text-cyan-500 toggle-pwd"></i>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] mb-3">Confirm New Password</label>
                        <div class="relative">
                            <input type="password" name="confirmPassword" class="w-full bg-[#020617] border border-gray-800 rounded-lg p-3.5 focus:outline-none focus:border-cyan-500 transition pr-12">
                            <i class="far fa-eye absolute right-4 top-4 text-gray-600 cursor-pointer hover:text-cyan-500 toggle-pwd"></i>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 pt-8">
                        <button type="submit" id="submitBtn" class="bg-cyan-400 hover:bg-cyan-300 text-black font-extrabold py-3 px-10 rounded-full shadow-[0_0_20px_rgba(34,211,238,0.25)] transition-all transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed">
                            Update Password
                        </button>
                        <a href="/profile" class="bg-gray-800 hover:bg-gray-700 text-gray-300 font-bold py-3 px-10 rounded-full transition text-center">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script>
        // --- UI HELPERS ---
        function showError(message) {
            const errorDiv = document.getElementById('errorMessage');
            const errorText = document.getElementById('errorText');
            errorText.innerText = message;
            errorDiv.classList.remove('hidden');
            errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function hideError() {
            document.getElementById('errorMessage').classList.add('hidden');
        }

        // Toggle Password Visibility
        document.querySelectorAll('.toggle-pwd').forEach(icon => {
            icon.addEventListener('click', function() {
                const input = this.parentElement.querySelector('input');
                if (input.type === 'password') {
                    input.type = 'text';
                    this.classList.replace('fa-eye', 'fa-eye-slash');
                } else {
                    input.type = 'password';
                    this.classList.replace('fa-eye-slash', 'fa-eye');
                }
            });
        });

        // --- FORM SUBMISSION ---
        document.getElementById('changePasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            hideError(); 
            
            const submitBtn = document.getElementById('submitBtn');
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            // We are skipping all client-side validation (regex/matching) 
            // and sending everything directly to the server.

            submitBtn.disabled = true;
            submitBtn.innerText = "UPDATING...";

            try {
                const response = await fetch('/profile/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    submitBtn.innerText = "SUCCESS!";
                    submitBtn.classList.replace('bg-cyan-400', 'bg-green-500');
                    setTimeout(() => {
                        window.location.href = '/profile';
                    }, 1000);
                } else {
                    // SERVER SIDE ERROR DISPLAYED HERE
                    showError(result.message || "An error occurred");
                    submitBtn.disabled = false;
                    submitBtn.innerText = "UPDATE PASSWORD";
                }
            } catch (err) {
                showError("Connection lost. Please check your internet and try again.");
                submitBtn.disabled = false;
                submitBtn.innerText = "UPDATE PASSWORD";
            }
        });

        // --- OTP REQUEST ---
        async function requestOTP() {
    const forgotBtn = document.querySelector('button[onclick="requestOTP()"]');
    const originalText = forgotBtn.innerText;
    hideError();

    forgotBtn.innerText = "SENDING...";
    forgotBtn.style.pointerEvents = "none";

    // Get the email from the server-side template variable
    // This assumes 'user' is passed to your EJS/Template
    const userEmail = "<%= user.email %>"; 
   

    try {
        const response = await fetch('/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            // Send the email so the backend validation passes
            body: JSON.stringify({ email: userEmail }) 
        });

        const data = await response.json();

        if (data.success) {
            // Usually redirects to /verify-otp or similar
            window.location.href = data.redirect;
        } else {
            showError(data.message || "Could not send OTP");
            forgotBtn.innerText = originalText;
            forgotBtn.style.pointerEvents = "auto";
        }
    } catch (err) {
        showError("Server error. Please try again.");
        forgotBtn.innerText = originalText;
        forgotBtn.style.pointerEvents = "auto";
    }
}
    </script>
</body>
</html>