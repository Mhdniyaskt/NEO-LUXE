<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coupon Engine | Neo-Luxe Admin</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #020617; }
        ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #334155; }
        .modal-active { overflow: hidden; }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        /* Glassmorphism utility */
        .glass { background: rgba(255, 255, 255, 0.02); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
    </style>
</head>
<body class="bg-[#020617] text-slate-300 flex">

   <!-- Partial: Sidebar -->
<%- include('../partials/admin-sidebar', { path: 'coupons' }) %>

<!-- Main Content Area -->
<!-- 'min-w-0' is added to prevent table overflow from breaking the flex container -->
<main class="flex-1 min-w-0 p-4 md:p-10 min-h-screen">
    
    <!-- Header Section -->
    <section class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 gap-6">
        <div>
            <nav class="flex mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-slate-500">
                <a href="#" class="hover:text-cyan-400 transition-colors">Admin</a>
                <span class="mx-3 text-slate-800">/</span>
                <span class="text-cyan-500">Promotions</span>
            </nav>
            <h1 class="text-4xl font-extrabold tracking-tight text-white mb-3">
                Coupon <span class="text-cyan-500">Engine</span>
            </h1>
            <p class="text-slate-400 max-w-xl text-sm leading-relaxed">
                Manage your store's promotional engine. Create, edit, and monitor discount performance with precision.
            </p>
        </div>

        <button onclick="toggleModal('addCouponModal')" class="flex items-center justify-center gap-3 px-8 py-4 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black rounded-2xl transition-all duration-300 shadow-[0_0_25px_rgba(6,182,212,0.3)] hover:shadow-[0_0_35px_rgba(6,182,212,0.5)] transform hover:-translate-y-1 active:scale-95 uppercase text-[11px] tracking-widest">
            <i class="fas fa-plus"></i>
            Create Coupon
        </button>
    </section>

    <!-- Data Table Card -->
    <div class="glass rounded-[2rem] overflow-hidden shadow-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-separate border-spacing-0">
                <thead>
                    <tr class="bg-white/[0.03]">
                        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 border-b border-white/5">Coupon Information</th>
                        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 border-b border-white/5">Offer Details</th>
                        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 border-b border-white/5">Requirement</th>
                        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 border-b border-white/5">Expiry</th>
                        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 border-b border-white/5 text-center">Status</th>
                        <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 border-b border-white/5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.05]">
                    <% coupons.forEach(coupon => { %>
                    <tr class="group transition-all duration-500 hover:bg-cyan-400/[0.02] <%= coupon.status === 'expired' ? 'opacity-60' : '' %>">
                        <td class="px-8 py-7">
                            <div class="flex flex-col gap-1">
                                <span class="text-sm font-bold text-white group-hover:text-cyan-400 transition-colors uppercase"><%= coupon.title %></span>
                                <span class="font-mono text-[10px] font-bold text-cyan-500 bg-cyan-500/10 border border-cyan-500/20 px-2 py-0.5 rounded w-fit uppercase tracking-tighter"><%= coupon.code %></span>
                            </div>
                        </td>
                        <td class="px-8 py-7">
                            <div class="flex flex-col">
                                <span class="text-lg font-black text-white"><%= coupon.discount %>% <span class="text-[10px] text-slate-500 uppercase">OFF</span></span>
                                <span class="text-[11px] text-slate-400">Max Cap: <span class="text-slate-200">₹<%= coupon.maxCap %></span></span>
                            </div>
                        </td>
                        <td class="px-8 py-7">
                            <div class="flex flex-col gap-1 text-[11px]">
                                <span class="text-slate-500 uppercase font-bold tracking-tighter">Min Spend: <span class="text-slate-200 ml-1">₹<%= coupon.minSpend %></span></span>
                                <span class="text-slate-500 uppercase font-bold tracking-tighter">Usage: <span class="text-slate-200 ml-1"><%= coupon.usedCount %> / <%= coupon.usageLimit %></span></span>
                            </div>
                        </td>
                        <td class="px-8 py-7">
                            <div class="flex flex-col gap-1">
                                <span class="text-xs text-slate-300 font-medium"><%= new Date(coupon.expiryDate).toLocaleDateString('en-IN') %></span>
                                <% if(coupon.status !== 'expired') { %>
                                    <span class="text-[9px] font-black px-2 py-0.5 rounded bg-slate-800 text-slate-400 w-fit uppercase tracking-widest"><%= coupon.daysLeft %> Days Left</span>
                                <% } %>
                            </div>
                        </td>
                        <td class="px-8 py-7 text-center">
                            <% if(coupon.status === 'active') { %>
                                <span data-status-badge class="px-3 py-1 bg-cyan-500/10 text-cyan-400 text-[9px] font-black uppercase rounded-full border border-cyan-500/20">Active</span>
                            <% } else if(coupon.status === 'inactive') { %>
                                <span data-status-badge class="px-3 py-1 bg-slate-800 text-slate-500 text-[9px] font-black uppercase rounded-full border border-white/5">Inactive</span>
                            <% } else { %>
                                <span data-status-badge class="px-3 py-1 bg-rose-500/10 text-rose-500 text-[9px] font-black uppercase rounded-full border border-rose-500/20">Expired</span>
                            <% } %>
                        </td>
                       <td class="px-8 py-7 text-right">
    <div class="flex justify-end items-center gap-4">
        <!-- Status Toggle Switch -->
        <div class="inline-flex items-center">
            <% if (coupon.status === 'expired') { %>
                <!-- Disabled Toggle for Expired -->
                <div class="relative w-11 h-6 bg-slate-800 rounded-full cursor-not-allowed opacity-40">
                    <div class="absolute left-1 top-1 bg-slate-600 w-4 h-4 rounded-full"></div>
                </div>
            <% } else { %>
                <!-- Active/Inactive Toggle -->
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" 
                           class="sr-only peer" 
                           <%= coupon.status === 'active' ? 'checked' : '' %>
                           onchange="toggleCouponStatus('<%= coupon._id %>', '<%= coupon.status %>', this)">
                    <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer 
                                peer-checked:after:translate-x-full peer-checked:after:border-white 
                                after:content-[''] after:absolute after:top-[2px] after:left-[2px] 
                                after:bg-white after:border-gray-300 after:border after:rounded-full 
                                after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-500">
                    </div>
                </label>
            <% } %>
        </div>

        <!-- Edit Button -->
        <button onclick="openEditModal('<%= JSON.stringify(coupon) %>')" 
            class="p-2.5 bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white rounded-xl transition-all transform hover:scale-110">
            <i class="far fa-edit text-xs"></i>
        </button>

        <!-- Delete Button -->
        <button onclick="deleteCoupon('<%= coupon._id %>')" 
            class="p-2.5 bg-white/5 hover:bg-rose-500/20 text-slate-400 hover:text-rose-500 rounded-xl transition-all transform hover:scale-110">
            <i class="far fa-trash-alt text-xs"></i>
        </button>
    </div>
</td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <footer class="mt-16 text-center">
        <p class="text-[9px] font-black uppercase tracking-[0.5em] text-slate-700">Neo-Luxe Dashboard &bull; 2026</p>
    </footer>
</main>

<!-- ADD COUPON MODAL -->
<div id="addCouponModal" class="fixed inset-0 z-[100] hidden overflow-y-auto">
    <div class="fixed inset-0 bg-black/90 backdrop-blur-xl"></div>
    <div class="flex min-h-screen items-center justify-center p-6">
        <div class="relative w-full max-w-2xl rounded-[2.5rem] bg-[#030712] border border-white/10 p-10 shadow-3xl overflow-y-auto max-h-[95vh] scrollbar-hide">
            <div class="flex justify-between items-center mb-10">
                <h2 class="text-3xl font-black text-white italic tracking-tighter uppercase">New <span class="text-cyan-500">Reward</span></h2>
                <button onclick="toggleModal('addCouponModal')" class="h-10 w-10 flex items-center justify-center rounded-full bg-white/5 text-slate-500 hover:text-white transition-colors"><i class="fas fa-times"></i></button>
            </div>
            
            <form id="addCouponForm" action="/admin/coupons" method="POST" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Title (Display Name)</label>
                        <input type="text" name="title" required placeholder="e.g., Summer Blowout" class="w-full bg-slate-900/50 border border-white/5 rounded-2xl px-5 py-4 focus:ring-2 focus:ring-cyan-500/50 focus:outline-none transition-all text-white">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Coupon Code</label>
                        <div class="flex gap-2">
                            <input type="text" id="add_code" name="code" required class="flex-1 bg-slate-900/50 border border-white/5 rounded-2xl px-5 py-4 font-mono text-cyan-400 uppercase focus:outline-none text-sm tracking-widest">
                            <button type="button" onclick="generateCode('add_code')" class="bg-cyan-500/10 text-cyan-500 px-4 rounded-2xl text-[10px] font-black hover:bg-cyan-500 hover:text-slate-950 transition-all border border-cyan-500/20 uppercase">Gen</button>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-white/5">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1 text-cyan-500">Discount %</label>
                        <input type="number" name="discount" min="1" max="90" required placeholder="1-90" class="w-full bg-slate-900/50 border border-white/5 rounded-2xl px-5 py-4 focus:outline-none text-white">
                        <p class="text-[9px] text-slate-600 font-bold uppercase italic">Validation: 1 to 90%</p>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Max Cap (₹)</label>
                        <input type="number" name="maxCap" required placeholder="0" class="w-full bg-slate-900/50 border border-white/5 rounded-2xl px-5 py-4 focus:outline-none text-white">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Expiry Date</label>
                        <input type="date" id="add_expiryDate" name="expiryDate" required
                               class="w-full bg-slate-900/50 border border-white/5 rounded-2xl px-5 py-4 focus:outline-none text-white text-sm"
                               onchange="validateDateInput(this)">
                        <p class="text-[9px] text-slate-600 font-bold uppercase italic">Must be a future date</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-white/5">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Min Spend (₹)</label>
                        <input type="number" name="minSpend" required placeholder="500" class="w-full bg-slate-900/50 border border-white/5 rounded-2xl px-5 py-4 focus:outline-none text-white">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Usage Limit</label>
                        <input type="number" name="usageLimit" required placeholder="100" class="w-full bg-slate-900/50 border border-white/5 rounded-2xl px-5 py-4 focus:outline-none text-white">
                    </div>
                </div>

                <div class="flex justify-end gap-4 mt-10">
                    <button type="button" onclick="toggleModal('addCouponModal')" class="px-8 py-4 text-slate-500 font-bold hover:text-white transition-colors uppercase text-[10px] tracking-widest">Cancel</button>
                    <button type="submit" class="px-10 py-4 bg-white text-slate-950 font-black rounded-2xl shadow-xl hover:bg-cyan-500 transition-all transform hover:-translate-y-1 uppercase text-xs">Create Coupon</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT COUPON MODAL -->
<!-- EDIT COUPON MODAL -->
<div id="editCouponModal" class="fixed inset-0 z-[100] hidden overflow-y-auto">
    <div class="fixed inset-0 bg-black/90 backdrop-blur-xl"></div>
    <div class="flex min-h-screen items-center justify-center p-6">
        <div class="relative w-full max-w-3xl rounded-[2.5rem] bg-[#030712] border border-white/10 p-10 shadow-3xl overflow-y-auto max-h-[95vh] scrollbar-hide">
            
            <div class="flex justify-between items-center mb-10">
                <h2 class="text-3xl font-black text-white italic tracking-tighter uppercase underline decoration-cyan-500 underline-offset-8">Edit <span class="text-cyan-500">Coupon</span></h2>
                <button onclick="toggleModal('editCouponModal')" class="text-slate-500 hover:text-white transition-colors"><i class="fas fa-times text-xl"></i></button>
            </div>

            <!-- Expired coupon notice — shown only when editing an expired coupon -->
            <div id="edit_expired_notice" class="hidden mb-6 flex items-start gap-3 p-4 bg-amber-500/10 border border-amber-500/20 rounded-2xl">
                <i class="fas fa-exclamation-triangle text-amber-400 mt-0.5 flex-shrink-0"></i>
                <p class="text-amber-300 text-xs leading-relaxed">
                    This coupon is <span class="font-black uppercase">expired</span>. To reactivate it, set a future expiry date and save.
                </p>
            </div>

            <form id="editCouponForm" method="POST" class="space-y-6">
                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Title</label>
                        <input type="text" name="title" id="edit_title" class="w-full bg-slate-900/50 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Code</label>
                        <input type="text" id="edit_code" class="w-full bg-slate-800/50 border border-white/5 rounded-2xl px-5 py-4 text-slate-400 font-mono uppercase cursor-not-allowed" readonly>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-6 pt-4 border-t border-white/5">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Discount %</label>
                        <input type="number" name="discount" id="edit_discount" class="w-full bg-slate-900/50 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Max Cap (₹)</label>
                        <input type="number" name="maxCap" id="edit_maxCap" class="w-full bg-slate-900/50 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Expiry</label>
                        <input type="date" name="expiryDate" id="edit_expiryDate"
                               class="w-full bg-slate-900/50 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none"
                               onchange="validateDateInput(this)">
                        <p id="edit_expiry_hint" class="text-[9px] font-bold uppercase italic text-slate-600">Must be a future date (from tomorrow)</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-6 pt-4 border-t border-white/5">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Min Spend (₹)</label>
                        <input type="number" name="minSpend" id="edit_minSpend" class="w-full bg-slate-900/50 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Usage Limit</label>
                        <input type="number" name="usageLimit" id="edit_usageLimit" class="w-full bg-slate-900/50 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none">
                    </div>
                </div>

                <div class="flex items-center justify-end mt-10 pt-6 border-t border-white/10">
                    <div class="flex gap-4">
                        <button type="button" onclick="toggleModal('editCouponModal')" class="px-8 py-4 text-slate-500 font-bold uppercase text-[10px] tracking-widest">Cancel</button>
                        <button type="submit" class="px-10 py-4 bg-cyan-500 text-slate-950 font-black rounded-2xl shadow-lg hover:shadow-cyan-500/40 transition-all uppercase text-xs">Update Coupon</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    // ── Date helpers ──────────────────────────────────────────────────────────
    // Returns "YYYY-MM-DD" for tomorrow in LOCAL time (avoids UTC-offset bugs)
    function getTomorrowStr() {
        const d = new Date();
        d.setDate(d.getDate() + 1);
        const y  = d.getFullYear();
        const m  = String(d.getMonth() + 1).padStart(2, '0');
        const dy = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${dy}`;
    }

    // String comparison works because both sides are YYYY-MM-DD
    function isFutureDate(dateStr) {
        return !!dateStr && dateStr >= getTomorrowStr();
    }

    // ── Set min="tomorrow" on both date inputs at page load ───────────────────
    document.addEventListener('DOMContentLoaded', () => {
        const tomorrow = getTomorrowStr();
        document.getElementById('add_expiryDate').min  = tomorrow;
        document.getElementById('edit_expiryDate').min = tomorrow;
    });

    // ── Inline change handler — clears invalid value immediately ─────────────
    function validateDateInput(input) {
        if (!input.value || isFutureDate(input.value)) {
            // Valid — reset any error styling
            input.classList.remove('border-rose-500');
            input.classList.add('border-white/10');
            return;
        }
        // Invalid — clear value and show error
        input.value = '';
        input.classList.remove('border-white/10');
        input.classList.add('border-rose-500');
        Swal.fire({
            icon: 'warning', title: 'Invalid Date',
            text: 'Expiry date must be from tomorrow onwards.',
            background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4',
            customClass: { popup: 'rounded-[2rem] border border-white/10' }
        });
    }

    // ── Central field validator — returns error string or null ────────────────
    function validateCouponFields({ title, discount, maxCap, minSpend, usageLimit, expiryDate }) {
        if (!title || !title.trim())              return 'Title is required.';
        if (title.trim().length < 3)              return 'Title must be at least 3 characters.';

        const disc = Number(discount);
        if (isNaN(disc) || disc < 1 || disc > 90) return 'Discount must be between 1% and 90%.';

        const cap = Number(maxCap);
        if (isNaN(cap) || cap < 0)                return 'Max cap cannot be negative.';

        const spend = Number(minSpend);
        if (isNaN(spend) || spend < 0)            return 'Minimum spend cannot be negative.';

        const limit = Number(usageLimit);
        if (isNaN(limit) || limit < 1)            return 'Usage limit must be at least 1.';

        if (!expiryDate)                          return 'Expiry date is required.';
        if (!isFutureDate(expiryDate))            return 'Expiry date must be from tomorrow onwards.';

        return null;
    }

    function showValidationError(msg) {
        Swal.fire({
            icon: 'warning', title: 'Validation Error', text: msg,
            background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4',
            customClass: { popup: 'rounded-[2rem] border border-white/10' }
        });
    }

    // ── ADD COUPON — intercept native form submit, validate, POST as JSON ─────
    document.getElementById('addCouponForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const fd = new FormData(this);
        const fields = {
            title:      fd.get('title'),
            code:       fd.get('code'),
            discount:   fd.get('discount'),
            maxCap:     fd.get('maxCap'),
            minSpend:   fd.get('minSpend'),
            usageLimit: fd.get('usageLimit'),
            expiryDate: fd.get('expiryDate'),
        };

        const err = validateCouponFields(fields);
        if (err) { showValidationError(err); return; }

        if (!fields.code || !fields.code.trim()) {
            showValidationError('Coupon code is required.'); return;
        }

        const btn = this.querySelector('[type="submit"]');
        btn.disabled = true; btn.textContent = 'Creating…';

        try {
            const res    = await fetch('/admin/coupons', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(fields),
            });
            const result = await res.json();

            if (res.ok && result.success) {
                toggleModal('addCouponModal');
                await Swal.fire({
                    icon: 'success', title: 'Created!', text: result.message,
                    background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4',
                    timer: 1800, showConfirmButton: false,
                    customClass: { popup: 'rounded-[2rem] border border-white/10' }
                });
                window.location.reload();
            } else {
                showValidationError(result.message || 'Could not create coupon.');
            }
        } catch {
            showValidationError('Network error. Please try again.');
        } finally {
            btn.disabled = false; btn.textContent = 'Create Coupon';
        }
    });

    // ── TOGGLE STATUS ─────────────────────────────────────────────────────────
    async function toggleCouponStatus(id, currentStatus, checkboxEl) {
        const newStatus = currentStatus === 'active' ? 'inactive' : 'active';
        try {
            const response = await fetch(`/admin/coupons/${id}/toggle`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            });
            const data = await response.json();

            if (response.ok && data.success) {
                const row   = checkboxEl.closest('tr');
                const badge = row.querySelector('[data-status-badge]');
                if (badge) {
                    if (newStatus === 'active') {
                        badge.className  = 'px-3 py-1 bg-cyan-500/10 text-cyan-400 text-[9px] font-black uppercase rounded-full border border-cyan-500/20';
                        badge.textContent = 'Active';
                    } else {
                        badge.className  = 'px-3 py-1 bg-slate-800 text-slate-500 text-[9px] font-black uppercase rounded-full border border-white/5';
                        badge.textContent = 'Inactive';
                    }
                }
                checkboxEl.setAttribute('onchange', `toggleCouponStatus('${id}', '${newStatus}', this)`);
                Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false,
                    timer: 1800, timerProgressBar: true, background: '#030712', color: '#fff'
                }).fire({ icon: 'success', title: `Coupon ${newStatus === 'active' ? 'Activated' : 'Deactivated'}` });
            } else {
                checkboxEl.checked = currentStatus === 'active';
                Swal.fire({ icon: 'error', title: 'Action Failed',
                    text: data.message || 'Could not update status.',
                    background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4',
                    customClass: { popup: 'rounded-[2rem] border border-white/10' } });
            }
        } catch {
            checkboxEl.checked = currentStatus === 'active';
            Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not reach the server.',
                background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4',
                customClass: { popup: 'rounded-[2rem] border border-white/10' } });
        }
    }

    // ── EDIT MODAL — open and populate ────────────────────────────────────────
    function openEditModal(couponDataStr) {
        let coupon;
        try { coupon = JSON.parse(couponDataStr); }
        catch {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Could not load coupon data.',
                background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4' });
            return;
        }

        const form = document.getElementById('editCouponForm');
        form.setAttribute('data-id', coupon._id);

        document.getElementById('edit_title').value      = coupon.title      || '';
        document.getElementById('edit_code').value       = coupon.code       || '';
        document.getElementById('edit_discount').value   = coupon.discount   ?? '';
        document.getElementById('edit_maxCap').value     = coupon.maxCap     ?? '';
        document.getElementById('edit_minSpend').value   = coupon.minSpend   ?? '';
        document.getElementById('edit_usageLimit').value = coupon.usageLimit ?? '';

        const expiryInput  = document.getElementById('edit_expiryDate');
        expiryInput.min    = getTomorrowStr();

        if (coupon.expiryDate) {
            // Build YYYY-MM-DD in LOCAL time to avoid UTC-offset off-by-one
            const d  = new Date(coupon.expiryDate);
            const y  = d.getFullYear();
            const mo = String(d.getMonth() + 1).padStart(2, '0');
            const dy = String(d.getDate()).padStart(2, '0');
            expiryInput.value = `${y}-${mo}-${dy}`;
        }

        const notice = document.getElementById('edit_expired_notice');
        coupon.status === 'expired'
            ? notice.classList.remove('hidden')
            : notice.classList.add('hidden');

        toggleModal('editCouponModal');
    }

    // ── EDIT FORM SUBMIT ──────────────────────────────────────────────────────
    document.getElementById('editCouponForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const couponId = this.getAttribute('data-id');
        if (!couponId) return;

        const fd = new FormData(this);
        const fields = {
            title:      fd.get('title'),
            discount:   fd.get('discount'),
            maxCap:     fd.get('maxCap'),
            minSpend:   fd.get('minSpend'),
            usageLimit: fd.get('usageLimit'),
            expiryDate: fd.get('expiryDate'),
        };

        const err = validateCouponFields(fields);
        if (err) { showValidationError(err); return; }

        const btn = this.querySelector('[type="submit"]');
        btn.disabled = true; btn.textContent = 'Saving…';

        try {
            const response = await fetch(`/admin/coupons/${couponId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(fields),
            });
            const result = await response.json();

            if (response.ok && result.success) {
                toggleModal('editCouponModal');
                await Swal.fire({
                    icon: 'success', title: 'Updated!', text: result.message || 'Coupon updated.',
                    background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4',
                    timer: 1800, showConfirmButton: false,
                    customClass: { popup: 'rounded-[2rem] border border-white/10' }
                });
                window.location.reload();
            } else {
                showValidationError(result.message || 'Could not update the coupon.');
            }
        } catch {
            showValidationError('Network error. Please try again.');
        } finally {
            btn.disabled = false; btn.textContent = 'Update Coupon';
        }
    });

    // ── DELETE COUPON ─────────────────────────────────────────────────────────
    async function deleteCoupon(couponId) {
        const result = await Swal.fire({
            title: 'Are you sure?',
            text: 'This coupon will be permanently removed from the engine.',
            icon: 'warning', showCancelButton: true,
            background: '#030712', color: '#f8fafc',
            confirmButtonColor: '#ef4444', cancelButtonColor: '#1e293b',
            confirmButtonText: 'Yes, delete it!', cancelButtonText: 'Cancel',
            customClass: {
                popup: 'rounded-[2rem] border border-white/10',
                confirmButton: 'rounded-xl px-6 py-3 uppercase text-xs font-black tracking-widest',
                cancelButton:  'rounded-xl px-6 py-3 uppercase text-xs font-black tracking-widest'
            }
        });
        if (!result.isConfirmed) return;

        try {
            const response = await fetch(`/admin/coupons/${couponId}`, { method: 'DELETE' });
            const data = await response.json();
            if (response.ok && data.success) {
                await Swal.fire({
                    title: 'Deleted!', text: 'The coupon has been removed.', icon: 'success',
                    background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4',
                    timer: 1500, showConfirmButton: false,
                    customClass: { popup: 'rounded-[2rem] border border-white/10' }
                });
                window.location.reload();
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'Failed to delete.',
                    background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4' });
            }
        } catch {
            Swal.fire({ icon: 'error', title: 'Error', text: 'A server error occurred.',
                background: '#030712', color: '#f8fafc', confirmButtonColor: '#06b6d4' });
        }
    }

    // ── MODAL TOGGLE ──────────────────────────────────────────────────────────
    function toggleModal(id) {
        const modal = document.getElementById(id);
        if (modal) {
            modal.classList.toggle('hidden');
            document.body.classList.toggle('modal-active');
        }
    }

    // ── CODE GENERATOR ───────────────────────────────────────────────────────
    function generateCode(inputId) {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        let result = '';
        for (let i = 0; i < 8; i++) result += chars.charAt(Math.floor(Math.random() * chars.length));
        document.getElementById(inputId).value = result;
    }

    // ── ESC KEY CLOSES MODALS ─────────────────────────────────────────────────
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            document.querySelectorAll('[id$="Modal"]').forEach(m => m.classList.add('hidden'));
            document.body.classList.remove('modal-active');
        }
    });
</script>
</body>
</html>