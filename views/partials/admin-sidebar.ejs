<aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-[#05070A] border-r border-slate-800/60 flex flex-col p-6 transform -translate-x-full transition-transform duration-300 ease-in-out lg:translate-x-0 lg:static lg:inset-0 shrink-0">
    
    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-xl font-bold tracking-widest text-white uppercase">Neo-Luxe</h1>
            <p class="text-[10px] text-slate-500 uppercase tracking-tighter">Premium Watch Admin</p>
        </div>
        <button onclick="toggleSidebar()" class="lg:hidden text-slate-400 hover:text-white">
            <i class="fas fa-times text-xl"></i>
        </button>
    </div>

    <nav class="flex-1 space-y-1 overflow-y-auto">
        <a href="/admin/dashboard" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'dashboard' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
            <i class="fas fa-th-large w-5 text-center text-sm flex-shrink-0 <%= path === 'dashboard' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Dashboard</span>
            <% if (path === 'dashboard') { %><span class="ml-auto w-1.5 h-1.5 rounded-full bg-cyan-400"></span><% } %>
        </a>

        <a href="/admin/customers" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'customers' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
            <i class="fas fa-users w-5 text-center text-sm flex-shrink-0 <%= path === 'customers' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Customers</span>
            <% if (path === 'customers') { %><span class="ml-auto w-1.5 h-1.5 rounded-full bg-cyan-400"></span><% } %>
        </a>

        <a href="/admin/categories" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'categories' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
            <i class="fas fa-layer-group w-5 text-center text-sm flex-shrink-0 <%= path === 'categories' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Categories</span>
            <% if (path === 'categories') { %><span class="ml-auto w-1.5 h-1.5 rounded-full bg-cyan-400"></span><% } %>
        </a>

        <a href="/admin/products" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'watches' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
            <i class="fas fa-clock w-5 text-center text-sm flex-shrink-0 <%= path === 'watches' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Watches</span>
            <% if (path === 'watches') { %><span class="ml-auto w-1.5 h-1.5 rounded-full bg-cyan-400"></span><% } %>
        </a>

        <a href="/admin/orders" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'orders' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
            <i class="fas fa-shopping-bag w-5 text-center text-sm flex-shrink-0 <%= path === 'orders' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Orders</span>
            <% if (path === 'orders') { %><span class="ml-auto w-1.5 h-1.5 rounded-full bg-cyan-400"></span><% } %>
        </a>

        <a href="/admin/stock" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 group <%= path === 'stock' ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20' : 'text-slate-400 hover:bg-slate-800/50 hover:text-white border border-transparent' %>">
            <i class="fas fa-boxes w-5 text-center text-sm flex-shrink-0 <%= path === 'stock' ? 'text-cyan-400' : 'text-slate-500 group-hover:text-white' %>"></i>
            <span class="text-sm font-medium">Stock</span>
            <% if (path === 'stock') { %><span class="ml-auto w-1.5 h-1.5 rounded-full bg-cyan-400"></span><% } %>
        </a>
    </nav>

    <div class="mt-auto pt-6 border-t border-slate-800/60">
        <form action="/admin/logout" method="POST">
            <button type="submit" class="w-full flex items-center gap-3 text-slate-500 hover:text-red-400 transition-all duration-200 px-3 py-2.5 rounded-xl hover:bg-red-500/5 group border border-transparent">
                <i class="fas fa-sign-out-alt w-5 text-center text-sm flex-shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
                <span class="text-sm font-medium">Logout</span>
            </button>
        </form>
    </div>
</aside>

<!-- Mobile overlay — shared by all pages that include this partial -->
<div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden lg:hidden"></div>

<script>
  // Sidebar toggle — defined once here so every page that includes this partial gets it
  if (typeof window._sidebarToggleBound === 'undefined') {
    window._sidebarToggleBound = true;
    window.toggleSidebar = function() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      sidebar.classList.toggle('-translate-x-full');
      if (overlay) overlay.classList.toggle('hidden');
    };
  }
</script>