<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

<div class="max-w-7xl mx-auto w-full px-6 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <%- include('../partials/profile-sidebar') %>

    <div class="lg:col-span-9 space-y-8">

      <div class="flex justify-between items-end mb-2">
        <div>
          <h1 class="text-4xl font-semibold mb-1">Edit Profile</h1>
          <p class="text-gray-400 text-sm">Update your personal information</p>
        </div>
        <a href="/profile" class="bg-gray-800 hover:bg-gray-700 text-[10px] py-2 px-4 rounded-md flex items-center gap-2 transition uppercase tracking-wider">
          <i class="fas fa-arrow-left text-[9px]"></i> Back to Profile
        </a>
      </div>

      <div class="bg-[#0a0f18] rounded-3xl p-10 border border-gray-800 shadow-2xl">
        <h2 class="text-lg font-medium mb-10 border-b border-gray-800 pb-4">Personal Information</h2>

        <div id="responseMessage" class="hidden p-4 rounded-xl mb-6 text-sm transition-all duration-300"></div>

        <form id="editProfileForm" class="space-y-8">
          <div class="space-y-2">
            <label class="block text-[10px] font-bold text-cyan-500 uppercase tracking-widest">Full Name</label>
            <input type="text" name="name" id="userName" value="<%= user.name %>" required
              class="w-full bg-[#111827] border border-gray-800 rounded-xl py-3.5 px-4 text-sm outline-none focus:border-cyan-500 transition text-gray-300"/>
          </div>

          <div class="space-y-2">
            <label class="block text-[10px] font-bold text-cyan-500 uppercase tracking-widest">Phone Number</label>
            <input type="tel" name="phone" id="userPhone" value="<%= user.phone || '' %>" placeholder="Enter 10 digit number"
              class="w-full bg-[#111827] border border-gray-800 rounded-xl py-3.5 px-4 text-sm outline-none focus:border-cyan-500 transition text-gray-300"/>
          </div>

          <div class="flex flex-wrap items-center gap-6 pt-6">
            <button type="submit" id="submitBtn"
              class="bg-cyan-500 hover:bg-cyan-400 text-black font-bold py-3 px-10 rounded-full shadow-lg shadow-cyan-500/10 transition text-xs uppercase tracking-widest">
              Save Changes
            </button>
            <a href="/profile" class="text-gray-400 hover:text-white text-xs font-bold uppercase tracking-widest transition">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('editProfileForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById('submitBtn');
    const msgDiv    = document.getElementById('responseMessage');
    const name      = document.getElementById('userName').value;
    const phone     = document.getElementById('userPhone').value;

    submitBtn.innerText = 'SAVING...';
    submitBtn.disabled  = true;
    submitBtn.classList.add('opacity-50', 'cursor-not-allowed');

    try {
      const response = await fetch('/editprofile', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ name, phone }),
      });
      const result = await response.json();

      msgDiv.className = 'p-4 rounded-xl mb-6 text-sm transition-all duration-300';
      if (response.ok) {
        msgDiv.innerText = result.message || 'Profile updated successfully!';
        msgDiv.classList.add('bg-green-500/10', 'text-green-500', 'border', 'border-green-500/20');
        msgDiv.classList.remove('hidden');
        setTimeout(() => { window.location.href = '/profile'; }, 1500);
      } else {
        msgDiv.innerText = result.error || 'Failed to update profile.';
        msgDiv.classList.add('bg-red-500/10', 'text-red-500', 'border', 'border-red-500/20');
        msgDiv.classList.remove('hidden');
      }
    } catch (err) {
      msgDiv.innerText   = 'A network error occurred. Please try again.';
      msgDiv.className   = 'p-4 rounded-xl mb-6 text-sm bg-red-500/10 text-red-500 border border-red-500/20';
      msgDiv.classList.remove('hidden');
    } finally {
      submitBtn.innerText = 'SAVE CHANGES';
      submitBtn.disabled  = false;
      submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    }
  });
</script>
