<style>
  body { background-color: #05070A; color: #E2E8F0; font-family: 'Inter', sans-serif; }
  .card-bg { background-color: #0B1120; border: 1px solid #1E293B; }
  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: #05070A; }
  ::-webkit-scrollbar-thumb { background: #1E293B; border-radius: 10px; }
</style>

<div class="flex h-screen w-full">
  <%- include('../partials/admin-sidebar', { path: 'dashboard' }) %>

  <main class="flex-1 overflow-y-auto p-4 md:p-8">
    <div class="max-w-7xl mx-auto">

      <!-- Header -->
      <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-white uppercase tracking-tight">Dashboard</h2>
          <p class="text-slate-500 text-xs md:text-sm">Real-time business overview.</p>
        </div>
        <!-- Chart filter buttons -->
        <div id="chartFilters" class="flex bg-slate-900 rounded-full p-1 text-[10px] font-bold uppercase border border-slate-800">
          <button onclick="loadChart('weekly')" data-filter="weekly" class="px-4 py-2 rounded-full text-slate-400 transition-all">Weekly</button>
          <button onclick="loadChart('monthly')" data-filter="monthly" class="bg-cyan-500 text-black px-4 py-2 rounded-full transition-all">Monthly</button>
          <button onclick="loadChart('yearly')" data-filter="yearly" class="px-4 py-2 rounded-full text-slate-400 transition-all">Yearly</button>
        </div>
      </header>

      <!-- Stats Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
        <div class="card-bg p-5 rounded-xl">
          <div class="flex justify-between items-start mb-3">
            <span class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Revenue</span>
            <i class="fas fa-wallet text-cyan-500 text-xs"></i>
          </div>
          <div class="text-lg font-bold text-white">₹<%= (stats.totalRevenue / 1000).toFixed(1) %>k</div>
        </div>
        <div class="card-bg p-5 rounded-xl">
          <div class="flex justify-between items-start mb-3">
            <span class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Orders</span>
            <i class="fas fa-shopping-cart text-cyan-500 text-xs"></i>
          </div>
          <div class="text-lg font-bold text-white"><%= stats.totalOrders %></div>
        </div>
        <div class="card-bg p-5 rounded-xl">
          <div class="flex justify-between items-start mb-3">
            <span class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Products</span>
            <i class="fas fa-clock text-cyan-500 text-xs"></i>
          </div>
          <div class="text-lg font-bold text-white"><%= stats.totalProducts %></div>
        </div>
        <div class="card-bg p-5 rounded-xl">
          <div class="flex justify-between items-start mb-3">
            <span class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Customers</span>
            <i class="fas fa-users text-cyan-500 text-xs"></i>
          </div>
          <div class="text-lg font-bold text-white"><%= stats.totalCustomers %></div>
        </div>
        <div class="card-bg p-5 rounded-xl">
          <div class="flex justify-between items-start mb-3">
            <span class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Pending</span>
            <i class="fas fa-hourglass-half text-amber-400 text-xs"></i>
          </div>
          <div class="text-lg font-bold text-amber-400"><%= stats.pendingOrders %></div>
        </div>
        <div class="card-bg p-5 rounded-xl">
          <div class="flex justify-between items-start mb-3">
            <span class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Delivered</span>
            <i class="fas fa-check-circle text-green-400 text-xs"></i>
          </div>
          <div class="text-lg font-bold text-green-400"><%= stats.deliveredOrders %></div>
        </div>
      </div>

      <!-- Revenue Chart -->
      <div class="card-bg p-6 rounded-2xl mb-8">
        <div class="flex justify-between items-center mb-4">
          <h3 class="font-bold text-sm uppercase text-white">Revenue Trend</h3>
          <span id="chartTotal" class="text-cyan-400 font-bold text-lg">₹<%= (stats.totalRevenue / 1000).toFixed(1) %>k</span>
        </div>
        <div class="h-64">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>

      <!-- Top 10 Sections -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">

        <!-- Top Products -->
        <div class="card-bg rounded-2xl overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-800">
            <h3 class="font-bold text-xs uppercase tracking-widest text-white">Top 10 Products</h3>
          </div>
          <div class="divide-y divide-slate-800/50 max-h-80 overflow-y-auto">
            <% topProducts.forEach((p, i) => { %>
              <div class="px-6 py-3 flex items-center gap-3">
                <span class="text-[10px] font-black text-slate-600 w-5"><%= i + 1 %></span>
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-white font-semibold truncate"><%= p.productName %></p>
                  <p class="text-[10px] text-slate-500"><%= p.totalQty %> sold</p>
                </div>
                <span class="text-xs text-cyan-400 font-bold flex-shrink-0">₹<%= p.totalRevenue.toLocaleString('en-IN') %></span>
              </div>
            <% }) %>
            <% if (topProducts.length === 0) { %>
              <p class="px-6 py-8 text-center text-slate-600 text-xs">No sales data yet.</p>
            <% } %>
          </div>
        </div>

        <!-- Top Categories -->
        <div class="card-bg rounded-2xl overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-800">
            <h3 class="font-bold text-xs uppercase tracking-widest text-white">Top 10 Categories</h3>
          </div>
          <div class="divide-y divide-slate-800/50 max-h-80 overflow-y-auto">
            <% topCategories.forEach((c, i) => { %>
              <div class="px-6 py-3 flex items-center gap-3">
                <span class="text-[10px] font-black text-slate-600 w-5"><%= i + 1 %></span>
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-white font-semibold truncate"><%= c.categoryName %></p>
                  <p class="text-[10px] text-slate-500"><%= c.totalQty %> items sold</p>
                </div>
                <span class="text-xs text-cyan-400 font-bold flex-shrink-0">₹<%= c.totalRevenue.toLocaleString('en-IN') %></span>
              </div>
            <% }) %>
            <% if (topCategories.length === 0) { %>
              <p class="px-6 py-8 text-center text-slate-600 text-xs">No sales data yet.</p>
            <% } %>
          </div>
        </div>

        <!-- Top Brands -->
        <div class="card-bg rounded-2xl overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-800">
            <h3 class="font-bold text-xs uppercase tracking-widest text-white">Top 10 Brands</h3>
          </div>
          <div class="divide-y divide-slate-800/50 max-h-80 overflow-y-auto">
            <% topBrands.forEach((b, i) => { %>
              <div class="px-6 py-3 flex items-center gap-3">
                <span class="text-[10px] font-black text-slate-600 w-5"><%= i + 1 %></span>
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-white font-semibold truncate"><%= b._id %></p>
                  <p class="text-[10px] text-slate-500"><%= b.totalQty %> items sold</p>
                </div>
                <span class="text-xs text-cyan-400 font-bold flex-shrink-0">₹<%= b.totalRevenue.toLocaleString('en-IN') %></span>
              </div>
            <% }) %>
            <% if (topBrands.length === 0) { %>
              <p class="px-6 py-8 text-center text-slate-600 text-xs">No sales data yet.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Recent Orders -->
      <div class="card-bg rounded-2xl overflow-hidden mb-8">
        <div class="p-6 flex justify-between items-center border-b border-slate-800">
          <h3 class="font-bold text-sm uppercase text-white">Recent Orders</h3>
          <a href="/admin/orders" class="text-cyan-500 text-[10px] font-bold uppercase hover:underline">View All</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs min-w-[700px]">
            <thead class="text-slate-500 text-[10px] uppercase border-b border-slate-800 bg-slate-900/30">
              <tr>
                <th class="px-6 py-4">Order ID</th>
                <th class="px-6 py-4">Customer</th>
                <th class="px-6 py-4">Items</th>
                <th class="px-6 py-4">Amount</th>
                <th class="px-6 py-4">Payment</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              <% recentOrders.forEach(order => {
                const shortId = '#' + order._id.toString().slice(-8).toUpperCase();
                const statusColors = {
                  pending:'bg-amber-500/10 text-amber-400 border-amber-500/20',
                  confirmed:'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
                  processing:'bg-blue-500/10 text-blue-400 border-blue-500/20',
                  shipped:'bg-purple-500/10 text-purple-400 border-purple-500/20',
                  delivered:'bg-green-500/10 text-green-400 border-green-500/20',
                  cancelled:'bg-red-500/10 text-red-400 border-red-500/20',
                  returned:'bg-orange-500/10 text-orange-400 border-orange-500/20',
                };
              %>
              <tr class="hover:bg-slate-800/30 transition">
                <td class="px-6 py-4 text-cyan-400 font-mono font-bold text-[11px]"><%= shortId %></td>
                <td class="px-6 py-4 text-white font-medium"><%= order.user ? order.user.name : 'Deleted' %></td>
                <td class="px-6 py-4 text-slate-400"><%= order.items ? order.items.length : 0 %> item<%= order.items?.length !== 1 ? 's' : '' %></td>
                <td class="px-6 py-4 font-bold text-white">₹<%= order.total.toLocaleString('en-IN') %></td>
                <td class="px-6 py-4 text-slate-400 capitalize"><%= order.paymentMethod === 'cod' ? 'COD' : order.paymentMethod %></td>
                <td class="px-6 py-4">
                  <span class="px-2.5 py-1 rounded text-[9px] font-black uppercase border <%= statusColors[order.status] || '' %>"><%= order.status %></span>
                </td>
                <td class="px-6 py-4 text-slate-500 text-[11px]"><%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) %></td>
              </tr>
              <% }) %>
              <% if (recentOrders.length === 0) { %>
                <tr><td colspan="7" class="px-6 py-12 text-center text-slate-600">No orders yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <footer class="text-center pb-8">
        <p class="text-[9px] text-slate-600 uppercase tracking-widest">© 2026 NEO-LUXE ADMIN. ALL RIGHTS RESERVED.</p>
      </footer>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  let revenueChart;

  async function loadChart(filter) {
    // Update active button
    document.querySelectorAll('#chartFilters button').forEach(btn => {
      btn.classList.remove('bg-cyan-500', 'text-black');
      btn.classList.add('text-slate-400');
    });
    const activeBtn = document.querySelector(`[data-filter="${filter}"]`);
    if (activeBtn) {
      activeBtn.classList.add('bg-cyan-500', 'text-black');
      activeBtn.classList.remove('text-slate-400');
    }

    try {
      const res  = await fetch(`/admin/dashboard/chart-data?filter=${filter}`);
      const json = await res.json();
      if (!json.success) return;

      const chartData = json.data;
      const labels = chartData.map(d => d.label);
      const values = chartData.map(d => d.total);

      // Update total display
      const total = values.reduce((s, v) => s + v, 0);
      document.getElementById('chartTotal').textContent = total >= 100000
        ? '₹' + (total / 100000).toFixed(1) + 'L'
        : total >= 1000
          ? '₹' + (total / 1000).toFixed(1) + 'k'
          : '₹' + total;

      // Update chart
      if (revenueChart) revenueChart.destroy();

      const ctx = document.getElementById('revenueChart').getContext('2d');
      const gradient = ctx.createLinearGradient(0, 0, 0, 300);
      gradient.addColorStop(0, 'rgba(34, 211, 238, 0.2)');
      gradient.addColorStop(1, 'rgba(34, 211, 238, 0)');

      revenueChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            data: values,
            borderColor: '#22D3EE',
            borderWidth: 3,
            backgroundColor: gradient,
            fill: true,
            tension: 0.4,
            pointRadius: 4,
            pointBackgroundColor: '#22D3EE',
            pointBorderColor: '#05070A',
            pointBorderWidth: 2,
          }]
        },
        options: {
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(30,41,59,0.5)', drawBorder: false },
              ticks: { color: '#64748b', font: { size: 10 },
                callback: v => v >= 100000 ? (v/100000).toFixed(1) + 'L' : v >= 1000 ? (v/1000).toFixed(0) + 'k' : v }
            },
            x: {
              grid: { display: false },
              ticks: { color: '#64748b', font: { size: 10 }, maxRotation: 0 }
            }
          }
        }
      });
    } catch (err) {
      console.error('Chart load error:', err);
    }
  }

  // Load monthly chart on page load
  loadChart('monthly');
</script>
