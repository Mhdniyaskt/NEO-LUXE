<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmed | Neo-Luxe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    body { background:#0a0e1a; font-family:'DM Sans',sans-serif; }
    @keyframes pop { 0%{transform:scale(0.5);opacity:0} 70%{transform:scale(1.1)} 100%{transform:scale(1);opacity:1} }
    .pop { animation:pop .5s ease both; }
  </style>
</head>
<body class="text-slate-200 min-h-screen">

  <div class="max-w-2xl mx-auto px-4 pt-16 pb-24 text-center">

    <!-- Success icon -->
    <div class="pop w-20 h-20 bg-green-500/20 border-2 border-green-500/40 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-10 h-10 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <h1 style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:#fff" class="mb-2">
      Order Confirmed!
    </h1>
    <p class="text-slate-400 text-sm mb-1">Thank you for your purchase.</p>
    <p class="text-slate-500 text-xs mb-8">
      Order ID: <span class="text-cyan-400 font-mono font-semibold"><%= order._id %></span>
    </p>

    <!-- Order details card -->
    <div class="bg-[#0f1526] border border-[#1e2640] rounded-2xl p-6 text-left mb-6">

      <!-- Items -->
      <h2 class="text-white font-bold text-sm mb-4 uppercase tracking-widest">Items Ordered</h2>
      <div class="space-y-3 mb-5">
        <% order.items.forEach(item => { %>
          <div class="flex gap-3 items-center">
            <div class="w-12 h-12 bg-[#161d30] rounded-lg overflow-hidden border border-[#1e2640] flex-shrink-0">
              <% if (item.imageUrl) { %>
                <img src="<%= item.imageUrl %>" alt="<%= item.productName %>" class="w-full h-full object-cover"/>
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-slate-700">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                </div>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white text-sm font-semibold truncate"><%= item.productName %></p>
              <p class="text-slate-500 text-xs"><%= item.variantColor %> · Qty: <%= item.quantity %></p>
            </div>
            <p class="text-cyan-400 text-sm font-bold flex-shrink-0">
              ₹<%= item.itemTotal.toLocaleString('en-IN') %>
            </p>
          </div>
        <% }) %>
      </div>

      <!-- Totals -->
      <div class="border-t border-[#1e2640] pt-4 space-y-2 mb-4">
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Subtotal</span>
          <span class="text-white">₹<%= order.subtotal.toLocaleString('en-IN') %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Shipping</span>
          <span class="<%= order.shipping === 0 ? 'text-cyan-400' : 'text-white' %> font-semibold">
            <%= order.shipping === 0 ? 'Free' : '₹' + order.shipping %>
          </span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Tax (18% GST)</span>
          <span class="text-white">₹<%= order.tax.toLocaleString('en-IN') %></span>
        </div>
      </div>
      <div class="border-t border-[#1e2640] pt-4 flex justify-between">
        <span class="text-white font-bold">Total Paid</span>
        <span class="text-cyan-400 font-bold text-xl">₹<%= order.total.toLocaleString('en-IN') %></span>
      </div>

      <!-- Shipping address -->
      <div class="border-t border-[#1e2640] mt-5 pt-5">
        <h2 class="text-white font-bold text-sm mb-2 uppercase tracking-widest">Delivery Address</h2>
        <p class="text-slate-300 text-sm font-semibold"><%= order.shippingAddress.fullName %></p>
        <p class="text-slate-400 text-xs leading-relaxed">
          <%= order.shippingAddress.addressLine1 %>,
          <%= order.shippingAddress.city %>,
          <%= order.shippingAddress.state %> — <%= order.shippingAddress.pincode %>
        </p>
        <p class="text-slate-500 text-xs mt-0.5">📞 <%= order.shippingAddress.phone %></p>
      </div>

      <!-- Payment & Status -->
      <div class="border-t border-[#1e2640] mt-5 pt-5 flex items-center justify-between">
        <div>
          <p class="text-slate-500 text-xs uppercase tracking-widest mb-0.5">Payment</p>
          <p class="text-white text-sm font-semibold capitalize"><%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Online' %></p>
        </div>
        <div class="text-right">
          <p class="text-slate-500 text-xs uppercase tracking-widest mb-0.5">Status</p>
          <span class="text-[11px] bg-green-500/20 text-green-400 border border-green-500/30 px-2.5 py-1 rounded-full font-semibold capitalize">
            <%= order.status %>
          </span>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/orders"
         class="px-6 py-3 rounded-xl bg-[#1e2640] border border-[#252e47] text-slate-200 text-sm font-semibold hover:bg-[#252e47] transition">
        View All Orders
      </a>
      <a href="/shop"
         class="px-6 py-3 rounded-xl bg-cyan-400 text-[#0a0e1a] text-sm font-bold hover:bg-cyan-300 transition">
        Continue Shopping
      </a>
    </div>
  </div>

  <footer class="py-8 border-t border-white/5 text-center">
    <p class="text-slate-700 text-xs">&copy; 2026 Neo-Luxe Premium Horology. All rights reserved.</p>
  </footer>

</body>
</html>
