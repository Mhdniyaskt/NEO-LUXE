<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Access | NEO-LUXE</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Outfit', 'sans-serif'] },
                    colors: {
                        brand: {
                            dark: '#020204',
                            card: 'rgba(11, 12, 16, 0.8)',
                            input: '#0f172a',
                            blue: '#00A3FF',
                            cyan: '#00E0FF',
                            border: 'rgba(255, 255, 255, 0.08)'
                        }
                    },
                    boxShadow: {
                        'glow-btn': '0 0 20px rgba(0, 224, 255, 0.4)',
                        'glow-card': '0 0 80px rgba(0, 163, 255, 0.05)',
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.6s ease-out forwards',
                        'slide-up': 'slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards',
                        'shake': 'shake 0.4s cubic-bezier(.36,.07,.19,.97) both',
                    },
                    keyframes: {
                        fadeIn: { '0%': { opacity: '0' }, '100%': { opacity: '1' } },
                        slideUp: { '0%': { opacity: '0', transform: 'translateY(30px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
                        shake: {
                            '10%, 90%': { transform: 'translate3d(-1px, 0, 0)' },
                            '20%, 80%': { transform: 'translate3d(2px, 0, 0)' },
                            '30%, 50%, 70%': { transform: 'translate3d(-4px, 0, 0)' },
                            '40%, 60%': { transform: 'translate3d(4px, 0, 0)' }
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #020204;
            background-image: 
                radial-gradient(circle at 50% 50%, #0f172a 0%, #020204 100%);
            overflow: hidden;
        }
        
        .glass-panel {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Prevent auto-fill background color */
        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus {
            -webkit-text-fill-color: white;
            -webkit-box-shadow: 0 0 0px 1000px #0f172a inset;
            transition: background-color 5000s ease-in-out 0s;
        }
    </style>
</head>

<body class="text-white font-sans antialiased">

    <!-- 
        Center Wrapper: 
        This absolute positioning ensures that even if a sidebar layout is present,
        the login box will still center itself relative to the viewport.
    -->
    <div class="fixed inset-0 flex items-center justify-center p-6 z-[9999]">
        
        <main class="w-full max-w-md animate-slide-up opacity-0">
            
            <!-- Branding Label -->
            <div class="flex flex-col items-center mb-8 animate-fade-in opacity-0" style="animation-delay: 0.2s;">
                <div class="text-[10px] uppercase tracking-[0.6em] text-brand-cyan font-black mb-2">
                    System Core
                </div>
                <div class="h-[1px] w-12 bg-gradient-to-r from-transparent via-brand-cyan to-transparent"></div>
            </div>

            <!-- Login Card -->
            <div class="glass-panel bg-brand-card p-10 md:p-12 rounded-[2.5rem] border border-brand-border shadow-glow-card relative">
                
                <div class="text-center mb-10">
                    <h1 class="text-3xl font-black mb-3 tracking-tighter italic uppercase">
                        Admin <span class="text-brand-blue">Sign In</span>
                    </h1>
                    <p class="text-slate-500 text-[11px] font-bold uppercase tracking-widest">
                        Encrypted Gateway Access
                    </p>
                </div>

                <!-- Alert Box -->
                <div id="error-box" class="hidden mb-8 p-4 bg-rose-500/10 border border-rose-500/20 rounded-2xl flex items-center gap-4 animate-fade-in">
                    <div class="h-8 w-8 rounded-full bg-rose-500/20 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-shield-halved text-rose-500 text-xs"></i>
                    </div>
                    <span id="error-message" class="text-[10px] text-rose-200 font-black uppercase tracking-wider leading-tight"></span>
                </div>

                <form id="loginForm" class="space-y-6">
                    <!-- Email field -->
                    <div class="space-y-2">
                        <label class="block text-[9px] font-black text-slate-500 uppercase tracking-[0.3em] ml-1">
                            Identification Email
                        </label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                                <i class="fa-regular fa-user text-slate-600 text-xs group-focus-within:text-brand-cyan transition-colors"></i>
                            </div>
                            <input type="email" name="email" required placeholder="name@neoluxe.com"
                                   class="w-full bg-brand-input border border-white/5 text-white text-sm rounded-2xl pl-12 pr-5 py-4 focus:outline-none focus:border-brand-blue/50 focus:ring-4 focus:ring-brand-blue/10 transition-all placeholder:text-slate-700">
                        </div>
                    </div>

                    <!-- Password field -->
                    <div class="space-y-2">
                        <label class="block text-[9px] font-black text-slate-500 uppercase tracking-[0.3em] ml-1">
                            Security Key
                        </label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                                <i class="fa-solid fa-fingerprint text-slate-600 text-xs group-focus-within:text-brand-cyan transition-colors"></i>
                            </div>
                            <input type="password" name="password" id="passwordInput" required placeholder="••••••••"
                                   class="w-full bg-brand-input border border-white/5 text-white text-sm rounded-2xl pl-12 pr-12 py-4 focus:outline-none focus:border-brand-blue/50 focus:ring-4 focus:ring-brand-blue/10 transition-all placeholder:text-slate-700">
                            
                            <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 pr-5 flex items-center text-slate-600 hover:text-brand-cyan transition-colors">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn"
                            class="w-full mt-6 bg-white text-black font-black text-[11px] py-5 rounded-2xl shadow-glow-btn hover:bg-brand-cyan hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-3 uppercase tracking-[0.3em]">
                        Establish Link <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </button>
                </form>
            </div>
            
            <p class="mt-10 text-center text-slate-700 text-[9px] uppercase tracking-[0.5em] font-black">
                &copy; 2026 NEO-LUXE &bull; Internal Protocol v4.0
            </p>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const loginForm = document.getElementById('loginForm');
            const errorBox = document.getElementById('error-box');
            const errorMessage = document.getElementById('error-message');
            const submitBtn = document.getElementById('submitBtn');
            const toggleBtn = document.getElementById('togglePassword');
            const passInput = document.getElementById('passwordInput');

            // Toggle Password
            toggleBtn.addEventListener('click', () => {
                const isPass = passInput.type === 'password';
                passInput.type = isPass ? 'text' : 'password';
                toggleBtn.innerHTML = isPass ? '<i class="fa-regular fa-eye-slash"></i>' : '<i class="fa-regular fa-eye"></i>';
            });

            // AJAX Login
            loginForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                // UI Loading State
                errorBox.classList.add('hidden');
                submitBtn.disabled = true;
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = `<i class="fa-solid fa-circle-notch animate-spin text-sm"></i> AUTHENTICATING...`;

                const email = loginForm.querySelector('input[name="email"]').value;
                const password = loginForm.querySelector('input[name="password"]').value;

                try {
                    const response = await fetch('/admin/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email, password })
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Success glow transition
                        submitBtn.classList.replace('bg-white', 'bg-emerald-500');
                        submitBtn.innerHTML = `<i class="fa-solid fa-check"></i> ACCESS GRANTED`;
                        setTimeout(() => {
                            window.location.href = data.redirect;
                        }, 600);
                    } else {
                        errorMessage.innerText = data.message || "Invalid Credentials";
                        errorBox.classList.remove('hidden');
                        
                        // Error feedback
                        const card = loginForm.closest('.glass-panel');
                        card.classList.add('animate-shake');
                        setTimeout(() => card.classList.remove('animate-shake'), 500);
                        
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                } catch (error) {
                    errorMessage.innerText = "Connection Breach: Server Unreachable";
                    errorBox.classList.remove('hidden');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });
        });
    </script>
</body>
</html>