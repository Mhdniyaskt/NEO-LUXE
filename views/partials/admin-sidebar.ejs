<aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-[#05070A] border-r border-slate-800/60 flex flex-col p-6 transform -translate-x-full transition-transform duration-300 ease-in-out lg:translate-x-0 lg:static lg:inset-0 shrink-0">
    
